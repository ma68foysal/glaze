<section class="k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}"{% if section.settings.attribution != blank %} aria-label="{{ section.settings.attribution | escape }}"{% endif %}>
  <div class="k-wrap">
    <figure class="k-pquote{% if section.settings.image == blank and section.settings.show_placeholder == false %} k-pquote--text{% endif %} k-reveal">
      <blockquote class="k-pquote__text">{{ section.settings.quote }}</blockquote>
      {%- if section.settings.attribution != blank -%}<figcaption class="k-label k-pquote__by">{{ section.settings.attribution }}</figcaption>{%- endif -%}
      {%- if section.settings.image != blank or section.settings.show_placeholder -%}
        <div class="k-pquote__img k-media">
          {%- render 'k-media', image: section.settings.image, sizes: '(min-width: 900px) 360px, 280px', placeholder: 'lifestyle-1' -%}
        </div>
      {%- endif -%}
    </figure>
  </div>
</section>

{% stylesheet %}
  .k-pquote {
    display: grid; grid-template-columns: minmax(0, 1fr) 360px; grid-template-rows: auto auto; column-gap: 48px; align-items: center;
    margin: 0; padding: 110px 0; border-block: 1.5px solid var(--color-text);
  }
  .k-pquote--text { grid-template-columns: 1fr; }
  .k-pquote__text {
    grid-column: 1; margin: 0; align-self: end;
    font-family: var(--font-accent); font-style: var(--font-accent-style);
    font-size: calc(clamp(40px, 4.6vw, 72px) * var(--heading-scale)); line-height: 1.02; letter-spacing: -0.01em;
  }
  .k-pquote__by { grid-column: 1; align-self: start; margin-top: 24px; }
  .k-pquote__img { grid-column: 2; grid-row: 1 / span 2; aspect-ratio: 4 / 5; border-radius: 200px 200px 20px 20px; }
  @media (max-width: 900px) {
    .k-pquote { grid-template-columns: 1fr; row-gap: 0; padding: 64px 0; }
    .k-pquote__img { grid-column: 1; grid-row: auto; max-width: 280px; margin-top: 40px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pull quote",
  "tag": "div",
  "class": "k-pquote-section",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "“Clothes should get better the more you wear them — that’s the only rule we design by.”" },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Head of design" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "show_placeholder", "label": "Show image placeholder when empty", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "presets": [ { "name": "Pull quote" } ]
}
{% endschema %}
