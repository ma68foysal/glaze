{%- comment -%}
  Cart drawer — slides in from the right when cart_type == 'drawer'.
  Rendered once per page from layout/theme.liquid. The body is the SECTION
  that Section Rendering API refetches after every cart mutation, so the
  whole drawer's innerHTML gets swapped server-side — no manual DOM mutation.

  Wrapper: <skinova-cart-drawer> custom element (defined in cart.js).
  Items wrapper: <skinova-cart-items> custom element.
  Remove/quantity: <skinova-cart-remove> wraps each line's remove button.
  Note: <skinova-cart-note> wraps the textarea.
{%- endcomment -%}

<skinova-cart-drawer
  class="skinova-cart-drawer{% if cart.item_count == 0 %} is-empty{% endif %}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="skinova-cart-drawer-heading"
  aria-hidden="true"
>
  <div class="skinova-cart-drawer__overlay" data-skinova-cart-close aria-hidden="true"></div>
  <aside class="skinova-cart-drawer__panel color-{{ section.settings.color_scheme | default: 'scheme-1' }}" tabindex="-1">
    <header class="skinova-cart-drawer__head">
      <h2 id="skinova-cart-drawer-heading" class="skinova-cart-drawer__title">
        {{ 'cart.drawer_title' | t }}
        {%- if cart.item_count > 0 %} <span class="skinova-cart-drawer__count">({{ cart.item_count }})</span>{%- endif -%}
      </h2>
      <button
        type="button"
        class="skinova-cart-drawer__close"
        data-skinova-cart-close
        aria-label="{{ 'general.close' | t }}"
      >
        {% render 'k-icon', icon: 'close', size: 22 %}
      </button>
    </header>

    {%- if cart.item_count == 0 -%}
      <div class="skinova-cart-drawer__empty">
        <p class="skinova-cart-drawer__empty-text">{{ 'cart.drawer_empty' | t }}</p>
        <a class="k-btn k-btn--secondary" href="{{ routes.all_products_collection_url }}" data-skinova-cart-close>
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <skinova-cart-items class="skinova-cart-drawer__items">
        <form action="{{ routes.cart_url }}" method="post" id="skinova-cart-drawer-form" novalidate>
          <ul class="skinova-cart-drawer__list" role="list">
            {%- for item in cart.items -%}
              <li class="skinova-cart-drawer__item" data-key="{{ item.key }}" data-index="{{ forloop.index }}">
                <a class="skinova-cart-drawer__item-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 240 | image_tag:
                        loading: 'lazy',
                        sizes: '80px',
                        widths: '80, 160, 240',
                        alt: item.image.alt | default: item.product.title | escape
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'k-ph' }}
                  {%- endif -%}
                </a>
                <div class="skinova-cart-drawer__item-body">
                  <a class="skinova-cart-drawer__item-title" href="{{ item.url }}">
                    {{ item.product.title | escape }}
                  </a>

                  {%- unless item.product.has_only_default_variant -%}
                    <p class="skinova-cart-drawer__item-options">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}

                  {%- if item.selling_plan_allocation -%}
                    <p class="skinova-cart-drawer__item-options">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                  {%- endif -%}

                  {%- for property in item.properties -%}
                    {%- assign first_char = property.first | slice: 0 -%}
                    {%- if first_char != '_' and property.last != blank -%}
                      <p class="skinova-cart-drawer__item-options">
                        <strong>{{ property.first | escape }}:</strong>
                        {% if property.last contains '/uploads/' %}
                          <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>
                        {% else %}
                          {{ property.last | escape }}
                        {% endif %}
                      </p>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul class="skinova-cart-drawer__item-discounts" aria-label="{{ 'cart.discounts_aria' | t }}">
                      {%- for discount in item.line_level_discount_allocations -%}
                        <li>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <div class="skinova-cart-drawer__item-row">
                    <div class="skinova-cart-drawer__qty">
                      <label for="skinova-cart-qty-{{ item.key }}" class="visually-hidden">
                        {{ 'cart.qty_label' | t: title: item.product.title | escape }}
                      </label>
                      <button
                        type="button"
                        class="skinova-cart-drawer__qty-btn"
                        aria-label="{{ 'cart.qty_decrease' | t }}"
                        data-skinova-cart-qty-step="-1"
                        data-target="skinova-cart-qty-{{ item.key }}"
                      >−</button>
                      <input
                        type="number"
                        id="skinova-cart-qty-{{ item.key }}"
                        name="updates[{{ item.key }}]"
                        value="{{ item.quantity }}"
                        min="0"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        data-skinova-cart-qty-input
                        data-index="{{ forloop.index }}"
                        data-key="{{ item.key }}"
                      >
                      <button
                        type="button"
                        class="skinova-cart-drawer__qty-btn"
                        aria-label="{{ 'cart.qty_increase' | t }}"
                        data-skinova-cart-qty-step="1"
                        data-target="skinova-cart-qty-{{ item.key }}"
                      >+</button>
                    </div>

                    <div class="skinova-cart-drawer__item-prices">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s class="skinova-cart-drawer__item-compare">{{ item.original_line_price | money }}</s>
                        <span class="skinova-cart-drawer__item-price">{{ item.final_line_price | money }}</span>
                      {%- else -%}
                        <span class="skinova-cart-drawer__item-price">{{ item.final_line_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>

                  <skinova-cart-remove data-key="{{ item.key }}" data-index="{{ forloop.index }}">
                    <button
                      type="button"
                      class="skinova-cart-drawer__remove"
                      aria-label="{{ 'cart.remove_aria' | t: title: item.product.title | escape }}"
                    >{{ 'cart.remove' | t }}</button>
                  </skinova-cart-remove>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="skinova-cart-drawer__cart-discounts" aria-label="{{ 'cart.cart_discounts_aria' | t }}">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </form>
      </skinova-cart-items>

      <footer class="skinova-cart-drawer__footer">
        {%- if settings.show_cart_note -%}
          {%- comment -%} Note lives in the footer (above subtotal) so it stays visible regardless of items list height. {%- endcomment -%}
          <details class="skinova-cart-drawer__note-wrap">
            <summary>{{ 'cart.note_toggle' | t }}</summary>
            <skinova-cart-note>
              <label for="skinova-cart-drawer-note" class="visually-hidden">{{ 'cart.notes_label' | t }}</label>
              <textarea
                id="skinova-cart-drawer-note"
                class="skinova-cart-drawer__note"
                form="skinova-cart-drawer-form"
                name="note"
                rows="3"
                placeholder="{{ 'cart.notes_label' | t }}"
              >{{ cart.note }}</textarea>
            </skinova-cart-note>
          </details>
        {%- endif -%}

        <div class="skinova-cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span class="skinova-cart-drawer__subtotal-value">{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="skinova-cart-drawer__tax-note">
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            {{ 'cart.tax_and_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- elsif cart.taxes_included -%}
            {{ 'cart.tax_included_shipping_at_checkout' | t }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{ 'cart.tax_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- else -%}
            {{ 'cart.tax_and_shipping_at_checkout' | t }}
          {%- endif -%}
        </p>
        <a class="k-btn k-btn--secondary k-btn--block" href="{{ routes.cart_url }}">
          {{ 'cart.view_cart' | t }}
        </a>
        <button
          type="submit"
          form="skinova-cart-drawer-form"
          name="checkout"
          class="k-btn k-btn--primary k-btn--block k-btn--split"
        >
          {{ 'cart.checkout' | t }}
          <span class="k-btn__arrow">{% render 'k-icon', icon: 'arrow', size: 16 %}</span>
        </button>
      </footer>
    {%- endif -%}
  </aside>
</skinova-cart-drawer>

{% stylesheet %}
  /* Cart drawer — design-system styles. Class names stay skinova-* because cart.js targets them. */
  .skinova-cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 9000;
    visibility: hidden;
    pointer-events: none;
    font-family: var(--font-body);
    transition: visibility 0s linear 0.5s;
  }
  .skinova-cart-drawer[open] { visibility: visible; pointer-events: auto; transition: visibility 0s linear 0s; }
  .skinova-cart-drawer__overlay {
    position: absolute; inset: 0;
    background: rgba(14, 14, 14, 0.45);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.35s var(--ease-out);
  }
  .skinova-cart-drawer[open] .skinova-cart-drawer__overlay { opacity: 1; }

  .skinova-cart-drawer__panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: min(460px, 100vw);
    display: flex; flex-direction: column;
    box-shadow: -30px 0 60px -30px rgba(14, 14, 14, 0.35);
    transform: translateX(100%);
    transition: transform 0.5s var(--ease-out);
    will-change: transform;
  }
  .skinova-cart-drawer[open] .skinova-cart-drawer__panel { transform: none; }
  .skinova-cart-drawer__panel:focus { outline: none; }

  .skinova-cart-drawer__head {
    flex: none;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--color-line);
  }
  .skinova-cart-drawer__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .skinova-cart-drawer__count {
    font-family: var(--font-accent);
    font-style: var(--font-accent-style);
    font-weight: 400;
    letter-spacing: 0;
  }
  .skinova-cart-drawer__close {
    display: inline-grid; place-items: center;
    width: var(--touch); height: var(--touch);
    margin-right: -10px;
    border: 0; border-radius: 999px;
    background: transparent; color: inherit;
    cursor: pointer;
    transition: background-color var(--dur-fast), transform var(--dur) var(--ease-out);
  }
  .skinova-cart-drawer__close:hover { background: var(--color-line-soft); transform: rotate(90deg); }

  .skinova-cart-drawer__items { flex: 1; display: block; overflow-y: auto; overscroll-behavior: contain; padding: 0 24px; }
  .skinova-cart-drawer__list { margin: 0; padding: 0; list-style: none; }
  .skinova-cart-drawer__item {
    position: relative;
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
    animation: k-rise-in 0.5s var(--ease-out) both;
  }
  .skinova-cart-drawer__item:nth-child(2) { animation-delay: 0.05s; }
  .skinova-cart-drawer__item:nth-child(3) { animation-delay: 0.1s; }
  .skinova-cart-drawer__item.is-loading { opacity: 0.55; pointer-events: none; }
  .skinova-cart-drawer__item.is-loading::after { display: none; }
  .skinova-cart-drawer__item.is-loading::before { left: 40px; top: 50%; border-color: var(--color-text); border-right-color: transparent; }
  .skinova-cart-drawer__item-media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: calc(var(--radius-card) * 0.25);
    background: var(--color-line-soft);
  }
  .skinova-cart-drawer__item-media img, .skinova-cart-drawer__item-media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .skinova-cart-drawer__item-body { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-width: 0; }
  .skinova-cart-drawer__item-title {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }
  .skinova-cart-drawer__item-title:hover { background-size: 100% 1.5px; }
  .skinova-cart-drawer__item-options {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .skinova-cart-drawer__item-discounts, .skinova-cart-drawer__cart-discounts {
    margin: 4px 0 0; padding: 0; list-style: none;
    font-size: 13px; color: var(--color-accent);
  }
  .skinova-cart-drawer__cart-discounts { margin: 16px 0; }
  .skinova-cart-drawer__item-row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 8px; }
  .skinova-cart-drawer__qty {
    display: inline-flex; align-items: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-button);
  }
  .skinova-cart-drawer__qty-btn {
    width: 40px; height: 40px;
    border: 0; border-radius: var(--radius-button);
    background: transparent; color: inherit;
    font: 500 17px var(--font-body);
    cursor: pointer;
    transition: background-color var(--dur-fast);
  }
  .skinova-cart-drawer__qty-btn:hover { background: var(--color-line-soft); }
  .skinova-cart-drawer__qty input {
    width: 32px; height: 40px;
    border: 0; background: transparent; color: inherit;
    font: 600 14px var(--font-body);
    text-align: center;
    -moz-appearance: textfield;
  }
  .skinova-cart-drawer__qty input::-webkit-outer-spin-button,
  .skinova-cart-drawer__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .skinova-cart-drawer__item-prices { display: inline-flex; align-items: baseline; gap: 8px; }
  .skinova-cart-drawer__item-price { font-weight: 600; font-size: 15px; }
  .skinova-cart-drawer__item-compare { font-size: 13px; color: var(--color-muted); }
  .skinova-cart-drawer__remove {
    min-height: 32px; padding: 0;
    border: 0; background: transparent; color: var(--color-muted);
    font: 500 13px var(--font-body);
    text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer;
  }
  .skinova-cart-drawer__remove:hover { color: var(--color-text); }

  .skinova-cart-drawer__footer {
    flex: none;
    display: grid; gap: 12px;
    padding: 18px 24px 24px;
    border-top: 1px solid var(--color-line);
  }
  .skinova-cart-drawer__note-wrap summary {
    display: inline-flex; align-items: center;
    min-height: 32px;
    font-size: 14px;
    text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer;
    list-style: none;
  }
  .skinova-cart-drawer__note-wrap summary::-webkit-details-marker { display: none; }
  .skinova-cart-drawer__note {
    width: 100%; min-height: 80px;
    margin-top: 8px; padding: 12px 14px;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-card) * 0.5);
    background: transparent; color: inherit;
    font: inherit; font-size: 15px;
    resize: vertical;
  }
  .skinova-cart-drawer__note:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .skinova-cart-drawer__subtotal { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; font-weight: 600; }
  .skinova-cart-drawer__subtotal-value { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 22px; letter-spacing: -0.01em; }
  .skinova-cart-drawer__tax-note { margin: 0 0 4px; font-family: var(--font-label); font-size: var(--text-label); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); }
  .skinova-cart-drawer__tax-note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  .skinova-cart-drawer__empty {
    flex: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px;
    padding: 24px;
    text-align: center;
  }
  .skinova-cart-drawer__empty-text {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
