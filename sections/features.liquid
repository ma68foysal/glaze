{%- liquid
  assign section_id = 'skinova-ft-' | append: section.id
-%}

{%- comment -%}
  Per-instance CSS variables. Structural styles live in assets/base.css
  under "S2. Features" — only the merchant-driven values stay inline here.
  Editorial trust strip: custom SVG icon + title + optional subtitle,
  hairline dividers between items. Replaces the generic pill row.
{%- endcomment -%}
<style>
  #{{ section_id }} {
    --ft-bg: {{ section.settings.bg_color }};
    --ft-fg: {{ section.settings.text_color }};
    --ft-divider-c: {{ section.settings.divider_color }};
    --ft-icon-size: {{ section.settings.icon_size }}px;
    --ft-icon-bg: {{ section.settings.icon_bg }};
    --ft-icon-c: {{ section.settings.icon_color }};
    --ft-title-c: {{ section.settings.title_color }};
    --ft-title-s: {{ section.settings.title_size }}px;
    --ft-title-s-mobile: {{ section.settings.title_size_mobile }}px;
    --ft-title-w: {{ section.settings.title_weight }};
    --ft-subtitle-c: {{ section.settings.subtitle_color }};
    --ft-subtitle-s: {{ section.settings.subtitle_size }}px;
    --ft-item-pad-y: {{ section.settings.item_padding_y }}px;
    --ft-item-pad-x: {{ section.settings.item_padding_x }}px;
    --ft-pad-top: {{ section.settings.padding_top }}px;
    --ft-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div id="{{ section_id }}" class="skinova-ft">
  <div class="ft-wrap">
    <ul
      class="ft-list"
      data-align="{{ section.settings.align }}"
      data-divider="{{ section.settings.divider_style }}"
      data-stagger
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign preset = block.settings.icon_preset | default: 'check'
          # Smart fallback: if merchant hasn't explicitly picked an icon (still
          # on the default 'check'), infer one from the title text so existing
          # sections from before this schema gained icon_preset don't all show
          # checkmarks.
          if preset == 'check'
            assign t = block.settings.title | downcase
            if t contains 'ship' or t contains 'delivery'
              assign preset = 'shipping'
            elsif t contains 'guarantee' or t contains 'refund' or t contains 'money-back' or t contains 'money back'
              assign preset = 'guarantee'
            elsif t contains 'pay later' or t contains 'installment' or t contains 'payment'
              assign preset = 'payment'
            elsif t contains 'support' or t contains 'help' or t contains 'chat'
              assign preset = 'support'
            elsif t contains 'return' or t contains 'exchange'
              assign preset = 'return'
            elsif t contains 'natural' or t contains 'organic' or t contains 'vegan' or t contains 'clean'
              assign preset = 'leaf'
            endif
          endif
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
        -%}

        {%- capture icon_svg -%}
          {%- case preset -%}
            {%- when 'shipping' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <path d="M4 14h22v18H4V14z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M26 20h10l6 6v6H26V20z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <circle cx="13" cy="36" r="3.5" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="34" cy="36" r="3.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M16.5 36H30.5M4 32h5.5M37.5 32H42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            {%- when 'guarantee' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <path d="M24 4L8 10v12c0 10 7 18 16 22 9-4 16-12 16-22V10L24 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M17 24l5 5 9-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- when 'payment' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <rect x="4" y="11" width="40" height="26" rx="3" stroke="currentColor" stroke-width="1.8"/>
                <path d="M4 19h40" stroke="currentColor" stroke-width="1.8"/>
                <path d="M10 29h8M22 29h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            {%- when 'support' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <path d="M8 28v-4a16 16 0 0 1 32 0v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <rect x="6" y="26" width="8" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
                <rect x="34" y="26" width="8" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
                <path d="M38 40v1a4 4 0 0 1-4 4h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="25" cy="45" r="1.5" fill="currentColor"/>
              </svg>
            {%- when 'return' -%}
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <path d="M40 24a16 16 0 1 1-4.7-11.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M40 6v8h-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- when 'leaf' -%}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20 4c0 9-7 16-16 16 0-9 7-16 16-16z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M4 20c4-4 8-8 16-16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            {%- when 'sparkle' -%}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3l1.8 6.2L20 11l-6.2 1.8L12 19l-1.8-6.2L4 11l6.2-1.8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 12.5l5 5L20 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
          {%- endcase -%}
        {%- endcapture -%}

        {%- capture item_inner -%}
          <span class="ft-icon" aria-hidden="true">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 80 | image_tag:
                  loading: 'lazy',
                  alt: '',
                  widths: '40,60,80'
              }}
            {%- else -%}
              {{ icon_svg }}
            {%- endif -%}
          </span>
          <div class="ft-content">
            {%- if block.settings.title != blank -%}
              <p class="ft-title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="ft-subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        <li class="ft-item" data-reveal="fade" {{ block.shopify_attributes }}>
          {%- if has_link -%}
            <a href="{{ block.settings.link }}" class="ft-item-inner">{{ item_inner }}</a>
          {%- else -%}
            <div class="ft-item-inner">{{ item_inner }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Features",
  "class": "section-features-skinova",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "between", "label": "Space between" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider between items",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "line", "label": "Vertical line" },
        { "value": "dot",  "label": "Dot" }
      ],
      "default": "line"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#e2dcd6"
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Item"
    },
    {
      "type": "range",
      "id": "item_padding_y",
      "min": 4,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "item_padding_x",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 28
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon circle size",
      "default": 44
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#fbe9e8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Colour",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 13
    },
    {
      "type": "range",
      "id": "title_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Weight",
      "default": 600
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Colour",
      "default": "#7a7a7a"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icon",
          "options": [
            { "value": "shipping",  "label": "Shipping" },
            { "value": "guarantee", "label": "Guarantee shield" },
            { "value": "payment",   "label": "Payment card" },
            { "value": "support",   "label": "Support headset" },
            { "value": "return",    "label": "Return arrows" },
            { "value": "leaf",      "label": "Leaf (natural)" },
            { "value": "sparkle",   "label": "Sparkle" },
            { "value": "check",     "label": "Checkmark" }
          ],
          "default": "check",
          "info": "Built-in icons. Upload a custom image below to override."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (overrides preset)",
          "info": "Recommended: square 80×80 PNG/SVG with transparent background."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "icon_preset": "shipping",  "title": "Free shipping",       "subtitle": "On orders over $50" } },
        { "type": "feature", "settings": { "icon_preset": "guarantee", "title": "30-day guarantee",    "subtitle": "Money-back, no questions" } },
        { "type": "feature", "settings": { "icon_preset": "payment",   "title": "Buy now, pay later",  "subtitle": "4 interest-free payments" } },
        { "type": "feature", "settings": { "icon_preset": "support",   "title": "24/7 live support",   "subtitle": "We reply within the hour" } },
        { "type": "feature", "settings": { "icon_preset": "return",    "title": "Easy returns",        "subtitle": "Free returns within 14 days" } }
      ]
    }
  ]
}
{% endschema %}
