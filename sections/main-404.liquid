{%- liquid
  assign links = section.blocks | where: 'type', 'link'
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'templates.404.title' | t
  endif
  assign ring = 'templates.404.ring' | t | upcase
  assign suggest = section.settings.collection
-%}
<section class="k-404 k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}">
  <div class="k-wrap">
    <k-parallax class="k-404__stage" aria-hidden="true">
      <span class="k-404__px" data-depth="-30"><span class="k-404__dg">4</span></span>
      <span class="k-404__px" data-depth="14">
        <span class="k-404__zero">
          <span class="k-404__disc k-media">
            {%- render 'k-media', image: section.settings.image, sizes: '(min-width: 900px) 280px, 40vw', placeholder: 'lifestyle-2', alt: '' -%}
          </span>
          <svg class="k-404__ring" viewBox="0 0 200 200" focusable="false">
            <defs><path id="k-404-ring-{{ section.id }}" d="M100,100 m-88,0 a88,88 0 1,1 176,0 a88,88 0 1,1 -176,0"/></defs>
            <text><textPath href="#k-404-ring-{{ section.id }}">{{ ring }} • {{ ring }} • {{ ring }} • </textPath></text>
          </svg>
        </span>
      </span>
      <span class="k-404__px" data-depth="30"><span class="k-404__dg k-404__dg--late">4</span></span>
      {%- if section.settings.label != blank -%}<span class="k-404__tag k-label">{{ section.settings.label }}</span>{%- endif -%}
    </k-parallax>

    <div class="k-404__copy">
      <h1 class="k-404__title">{{ heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="k-rte k-muted k-404__text">{{ section.settings.text }}</div>{%- endif -%}

      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="k-404__search">
          <label for="{{ section.id }}-q" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
          {%- render 'k-icon', icon: 'search', size: 20 -%}
          <input type="search" id="{{ section.id }}-q" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit">{{ 'search.submit' | t }}</button>
        </form>
      {%- endif -%}

      <div class="k-404__actions">
        <a class="k-btn k-btn--primary" href="{{ routes.root_url }}"><span>{{ 'templates.404.home' | t }}</span>{% render 'k-icon', icon: 'arrow', size: 18 %}</a>
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="k-btn k-btn--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if links.size > 0 -%}
        <nav aria-label="{{ 'templates.404.popular' | t }}">
          <ul class="k-404__pills" role="list">
            {%- for block in links -%}
              {%- liquid
                assign c = block.settings.collection
                assign label = block.settings.label
                assign url = block.settings.link
                if c != blank
                  assign url = url | default: c.url
                  assign label = label | default: c.title
                endif
              -%}
              {%- if url != blank and label != blank -%}
                <li {{ block.shopify_attributes }}><a href="{{ url }}">{{ label }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if suggest != blank and suggest.products_count > 0 -%}
      <div class="k-404__more">
        <div class="k-sec-head">
          <h2 class="k-h2">{{ section.settings.products_heading }}</h2>
          <a class="k-btn k-btn--secondary" href="{{ suggest.url }}">{{ 'general.view_all' | t }}</a>
        </div>
        <ul class="k-grid" role="list" style="--cols: 4;">
          {%- for p in suggest.products limit: 4 -%}
            <li class="k-reveal">{% render 'k-card', product: p, quick_add: true %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% javascript %}
  if (!customElements.get('k-parallax')) {
    customElements.define('k-parallax', class extends HTMLElement {
      connectedCallback() {
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches || !window.matchMedia('(pointer: fine)').matches;
        if (still) return;
        var layers = Array.prototype.slice.call(this.querySelectorAll('[data-depth]'));
        var move = (x, y) => {
          if (document.documentElement.dataset.motion === 'off' || document.documentElement.classList.contains('motion-paused')) { x = 0; y = 0; }
          layers.forEach(function (el) {
            var d = parseFloat(el.dataset.depth) || 0;
            el.style.transform = 'translate(' + Math.round(x * d) + 'px, ' + Math.round(y * d * 0.66) + 'px)';
          });
        };
        this.addEventListener('pointermove', (e) => {
          var r = this.getBoundingClientRect();
          move((e.clientX - r.left) / r.width - 0.5, (e.clientY - r.top) / r.height - 0.5);
        });
        this.addEventListener('pointerleave', function () { move(0, 0); });
      }
    });
  }
{% endjavascript %}

{% stylesheet %}
  .k-404__stage { position: relative; display: flex; justify-content: center; align-items: center; gap: clamp(8px, 2vw, 28px); padding: 48px 0 24px; user-select: none; }
  .k-404__px { display: block; transition: transform 0.5s var(--ease-out); }
  .k-404__dg {
    display: block;
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(150px, 26vw, 400px) * var(--heading-scale)); line-height: 0.8; letter-spacing: -0.05em;
    transform-origin: 50% 100%;
    animation: k-letter-rise 1.1s var(--ease-out) both, k-breathe 6s ease-in-out 1.2s infinite;
  }
  .k-404__dg--late { animation-delay: 0.1s, 1.5s; }
  .k-404__zero { position: relative; display: block; width: clamp(150px, 22vw, 340px); aspect-ratio: 1; animation: k-404-pop 1.1s 0.15s var(--ease-out) both; }
  .k-404__disc { position: absolute; inset: 12%; border-radius: 999px; box-shadow: 0 30px 60px -30px rgba(14, 14, 14, 0.6); }
  .k-404__disc img { animation: k-404-spin-slow 40s linear infinite; }
  .k-404__ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: k-spin 18s linear infinite reverse; }
  .k-404__ring text { font: 500 11px var(--font-label); letter-spacing: 4.6px; fill: currentColor; }
  .k-404__tag { position: absolute; right: 8%; top: 40px; padding: 10px 16px; border-radius: 999px; background: var(--color-text); color: var(--color-bg); transform: rotate(6deg); animation: k-bob 5s ease-in-out infinite; }
  @keyframes k-404-pop { from { transform: scale(0.6) rotate(-30deg); opacity: 0; } }
  @keyframes k-404-spin-slow { from { transform: scale(1.15) rotate(0); } to { transform: scale(1.15) rotate(360deg); } }

  .k-404__copy { display: flex; flex-direction: column; align-items: center; gap: 22px; max-width: 760px; margin: 0 auto; text-align: center; }
  .k-404__title {
    margin: 0;
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(40px, 5vw, 76px) * var(--heading-scale)); letter-spacing: -0.035em; line-height: 0.95;
  }
  .k-404__title em { font-family: var(--font-accent); font-style: var(--font-accent-style); font-weight: 400; letter-spacing: -0.01em; }
  .k-404__text { font-size: 18px; line-height: 1.55; }
  .k-404__text p { margin: 0; }
  .k-404__search {
    display: flex; align-items: center; gap: 10px; width: min(560px, 100%); padding: 6px 6px 6px 20px;
    border: 1.5px solid var(--color-text); border-radius: 999px; background: var(--color-surface); text-align: left;
  }
  .k-404__search .k-icon { flex: none; }
  .k-404__search input { flex: 1; min-width: 0; min-height: 48px; border: 0; background: transparent; color: inherit; font: 500 17px var(--font-body); }
  .k-404__search input:focus-visible { outline: none; }
  .k-404__search:focus-within { border-color: var(--color-accent); }
  .k-404__search button { min-height: 48px; padding: 0 22px; border: 0; border-radius: 999px; background: var(--color-text); color: var(--color-bg); font: 600 15px var(--font-body); cursor: pointer; }
  .k-404__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .k-404__pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .k-404__pills a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border: 1.5px solid var(--color-text); border-radius: 999px; font-weight: 600; font-size: 14px;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  .k-404__pills a:hover { background: var(--color-text); color: var(--color-bg); }
  .k-404__more { padding-top: clamp(64px, 8vw, 110px); }
  .k-404__more .k-grid { margin: 0; padding: 0; list-style: none; }
  @media (max-width: 900px) {
    .k-404__tag { display: none; }
    .k-404__stage { padding-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .k-404__dg, .k-404__zero, .k-404__disc img, .k-404__ring, .k-404__tag { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page not found",
  "tag": "div",
  "class": "k-404-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image in the zero" },
    { "type": "text", "id": "label", "label": "Tag", "default": "Error 404" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "This page <em>walked off.</em>", "info": "Italic words use the accent font." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The link may be old, or the page has moved. Try a search, or start again from one of these.</p>" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "Shop new in" },
    { "type": "url", "id": "secondary_link", "label": "Second button link", "default": "/collections/all" },
    { "type": "header", "content": "Product suggestions" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "inline_richtext", "id": "products_heading", "label": "Heading", "default": "Maybe you were <em>looking for</em>" },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "Link", "info": "Use instead of a collection, for example a blog or page." }
      ]
    }
  ],
  "enabled_on": { "templates": ["404"] }
}
{% endschema %}
