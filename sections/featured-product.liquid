{%- liquid
  assign section_id = 'skinova-fp-' | append: section.id
-%}

{%- comment -%}
  Per-instance CSS variables. Structural styles live in assets/base.css
  under "S12. Featured product". Editorial bento layout — one large hero
  product + 4 smaller portrait cards on the side, colour-block surfaces
  rotating across the small cards.
{%- endcomment -%}
<style>
  #{{ section_id }} {
    --sfp-bg: {{ section.settings.bg_color }};
    --sfp-fg: {{ section.settings.text_color }};
    --sfp-muted: {{ section.settings.muted_color }};
    --sfp-pad-top: {{ section.settings.padding_top }}px;
    --sfp-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sfp-radius: {{ section.settings.card_radius }}px;
    --sfp-tab-active: {{ section.settings.tab_active_color }};
    --sfp-tab-inactive: {{ section.settings.tab_inactive_color }};
    --sfp-tab-size: {{ section.settings.tab_font_size }}px;
    --sfp-eyebrow-c: {{ section.settings.eyebrow_color }};
    --sfp-title-color: {{ section.settings.title_color }};
    --sfp-title-size: {{ section.settings.title_font_size }}px;
    --sfp-type-color: {{ section.settings.type_color }};
    --sfp-type-size: {{ section.settings.type_font_size }}px;
    --sfp-price-color: {{ section.settings.price_color }};
    --sfp-price-size: {{ section.settings.price_font_size }}px;
    --sfp-compare-color: {{ section.settings.compare_color }};
    --sfp-sale-bg: {{ section.settings.sale_bg }};
    --sfp-sale-fg: {{ section.settings.sale_fg }};
    --sfp-new-bg: {{ section.settings.new_bg }};
    --sfp-new-fg: {{ section.settings.new_fg }};
    --sfp-hot-bg: {{ section.settings.hot_bg }};
    --sfp-hot-fg: {{ section.settings.hot_fg }};
    --sfp-badge-size: {{ section.settings.badge_font_size }}px;
    --sfp-btn-bg: {{ section.settings.btn_bg }};
    --sfp-btn-fg: {{ section.settings.btn_fg }};
    --sfp-btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --sfp-btn-hover-fg: {{ section.settings.btn_hover_fg }};
    --sfp-hero-c1: {{ section.settings.hero_color_1 }};
    --sfp-hero-c2: {{ section.settings.hero_color_2 }};
    --sfp-hero-c3: {{ section.settings.hero_color_3 }};
    --sfp-hero-c4: {{ section.settings.hero_color_4 }};
  }
</style>

{%- comment -%}
  shop.shipping_policy.url is locale-aware and is blank when the merchant has
  not published a shipping policy. global.js reads it to build the quick-view
  modal footnote, and omits the link entirely when it is blank.
{%- endcomment -%}
<div
  id="{{ section_id }}"
  class="skinova-fp"
  data-skinova-fp
  data-shipping-policy-url="{{ shop.shipping_policy.url }}"
>
  <div class="sfp-wrap">

    <div class="sfp-head">
      <div class="sfp-tabs" role="tablist">
        {%- assign tab_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            {%- assign label = block.settings.tab_label -%}
            {%- if label == blank and block.settings.collection != blank -%}
              {%- assign label = block.settings.collection.title -%}
            {%- endif -%}
            <button
              type="button"
              class="sfp-tab{% if tab_index == 0 %} is-active{% endif %}"
              role="tab"
              data-sfp-tab="{{ tab_index }}"
              aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ label | default: 'Tab' }}
            </button>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_shop_all and section.settings.shop_all_link != blank -%}
        <a href="{{ section.settings.shop_all_link }}" class="sfp-shop-all">
          {{ section.settings.shop_all_label | default: 'Shop All Products' }}
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="sfp-panels">
      {%- assign panel_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign hero_pos = block.settings.hero_position | default: 'left' -%}
        <div
          class="sfp-panel{% if panel_index == 0 %} is-active{% endif %}"
          role="tabpanel"
          data-sfp-panel="{{ panel_index }}"
        >
          {%- if coll != blank and coll.products.size > 0 -%}
            <div class="sfp-bento" data-hero-pos="{{ hero_pos }}">

              {%- comment -%} ============ HERO CARD (product[0]) ============ {%- endcomment -%}
              {%- assign hero = coll.products[0] -%}
              {%- if hero -%}
                {%- render 'fp-hero-card',
                    product: hero,
                    section: section,
                    block: block
                -%}
              {%- endif -%}

              {%- comment -%} ============ MINI CARDS (products[1..4]) ============ {%- endcomment -%}
              <div class="sfp-mini-grid">
                {%- for product in coll.products limit: 4 offset: 1 -%}
                  {%- render 'fp-mini-card',
                      product: product,
                      section: section,
                      color_index: forloop.index0
                  -%}
                {%- endfor -%}
              </div>

            </div>
          {%- else -%}
            {%- comment -%}
              No collection picked yet, or it has no products. Render the bento
              layout with placeholders so a fresh install shows the shape of the
              section rather than a bare line of text.
            {%- endcomment -%}
            <div class="sfp-bento sfp-bento--placeholder" data-hero-pos="{{ hero_pos }}" aria-hidden="true">
              <article class="sfp-hero sfp-hero--placeholder">
                <span class="sfp-hero__media">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
              </article>
              <div class="sfp-mini-grid">
                {%- for i in (1..4) -%}
                  {%- assign ph_index = i | plus: 1 -%}
                  {%- assign ph_name = 'product-' | append: ph_index -%}
                  <article class="sfp-mini sfp-mini--placeholder" data-color-block="{{ forloop.index0 }}">
                    <span class="sfp-mini__media">
                      {{ ph_name | placeholder_svg_tag: 'placeholder-svg' }}
                    </span>
                  </article>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
        {%- assign panel_index = panel_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%}
      App block region. Theme Store requires `@app` blocks on main product and
      featured product sections so reviews / upsell / loyalty apps can hook in.
    {%- endcomment -%}
    {%- assign has_apps = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{%- assign has_apps = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_apps -%}
      <div class="sfp-apps">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} Quick view modal (single instance, populated via JS) {%- endcomment -%}
  <div class="sfp-modal-overlay" data-sfp-modal-close></div>
  <aside class="sfp-modal" aria-hidden="true" role="dialog" aria-modal="true" data-sfp-modal>
    <button type="button" class="sfp-modal-close" data-sfp-modal-close aria-label="Close">
      <svg viewBox="0 0 14 14" fill="none">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="sfp-modal-inner" data-sfp-modal-body>
      <div class="sfp-modal-loading">Loading…</div>
    </div>
  </aside>
</div>

{%- comment -%}
  Tab switcher + quick-view modal + card ATC live in assets/global.js as
  Skinova.featuredProduct, auto-initialised on the [data-skinova-fp] root
  element above. Quick-view content is rendered by window.SkinovaQuickView
  from assets/quick-view.js using the "sfp" class prefix; stock + shipping
  extras are injected via the QuickView extras hook.
{%- endcomment -%}

