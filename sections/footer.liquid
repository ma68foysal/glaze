{%- liquid
  assign wordmark = section.settings.wordmark | default: shop.name
  assign wordmark_letters = wordmark | split: ''
-%}

<footer class="k-footer color-{{ section.settings.color_scheme }}">
  <div class="k-wrap">
    {%- if section.blocks.size > 0 -%}
      <div class="k-footer__cols" style="--cols: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          {%- liquid
            if block.type == 'social'
              assign social_urls = block.settings.instagram | append: block.settings.tiktok | append: block.settings.pinterest | append: block.settings.facebook | append: block.settings.youtube | append: block.settings.x
              if social_urls == blank
                continue
              endif
            endif
          -%}
          <div class="k-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="k-label k-footer__head">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="k-footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a class="k-link-underline" href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="k-rte k-footer__text">{{ block.settings.text }}</div>
              {%- when 'social' -%}
                <ul class="k-footer__links" role="list">
                  {%- if block.settings.instagram != blank -%}<li><a class="k-link-underline" href="{{ block.settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
                  {%- if block.settings.tiktok != blank -%}<li><a class="k-link-underline" href="{{ block.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
                  {%- if block.settings.pinterest != blank -%}<li><a class="k-link-underline" href="{{ block.settings.pinterest }}" target="_blank" rel="noopener">Pinterest</a></li>{%- endif -%}
                  {%- if block.settings.facebook != blank -%}<li><a class="k-link-underline" href="{{ block.settings.facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
                  {%- if block.settings.youtube != blank -%}<li><a class="k-link-underline" href="{{ block.settings.youtube }}" target="_blank" rel="noopener">YouTube</a></li>{%- endif -%}
                  {%- if block.settings.x != blank -%}<li><a class="k-link-underline" href="{{ block.settings.x }}" target="_blank" rel="noopener">X</a></li>{%- endif -%}
                </ul>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <p class="k-footer__giant" aria-hidden="true">
        {%- for letter in wordmark_letters -%}
          {%- if letter == ' ' -%}<span class="k-footer__gap"></span>{%- else -%}<span>{{ letter }}</span>{%- endif -%}
        {%- endfor -%}
      </p>
    {%- endif -%}

    <div class="k-footer__bottom">
      <p class="k-footer__copy">
        {%- if settings.issue_label != blank -%}<span class="k-footer__issue k-label">{{ settings.issue_label }}</span>{%- endif -%}
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}.
        {%- if section.settings.show_powered %} {{ powered_by_link }}{% endif -%}
      </p>

      {%- if section.settings.legal_menu.links.size > 0 -%}
        <ul class="k-footer__legal" role="list">
          {%- for link in section.settings.legal_menu.links -%}
            <li><a class="k-link-underline" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- render 'localization-form', class_prefix: 'k-loc' -%}

      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="k-footer__pay" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'k-footer__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .k-footer__cols {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: var(--space-lg);
    padding: var(--space-2xl) 0 var(--space-xl);
  }
  .k-footer__head { margin: 0 0 16px; font-weight: 400; color: var(--color-muted); }
  .k-footer__links { margin: 0; padding: 0; list-style: none; }
  .k-footer__links a { display: inline-block; padding: 6px 0; font-size: 15px; }
  .k-footer__text { font-size: 15px; max-width: 32ch; }
  .k-footer__giant {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding-top: 10px;
    overflow: hidden;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(64px, 17vw, 265px) * var(--wordmark-scale, 1));
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    user-select: none;
  }
  .k-footer__giant span {
    display: inline-block;
    transform-origin: 50% 100%;
    transition: transform 0.5s var(--ease-out), color var(--dur-fast);
  }
  .k-footer__giant span:hover { transform: scaleY(0.82) scaleX(0.86); color: var(--color-accent); }
  .k-footer__gap { width: 0.25em; }
  .k-footer__issue { margin-right: 14px; }
  .k-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 24px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }
  .k-footer__copy { margin: 0; }
  .k-footer__legal, .k-footer__pay { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; padding: 0; list-style: none; }
  .k-footer__pay { gap: 8px; }
  .k-footer__pay-icon { width: 38px; height: 24px; }
  .k-footer .k-loc__form { padding-top: 0; margin-top: 0; }
  @media (max-width: 900px) {
    .k-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .k-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "k-footer-section",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show large wordmark", "default": true },
    { "type": "text", "id": "wordmark", "label": "Wordmark text", "info": "Your store name is used when this is empty. Short names of 4 to 9 letters look best." },
    { "type": "link_list", "id": "legal_menu", "label": "Policy menu", "default": "footer" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_powered", "label": "Show Powered by Shopify", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Studio" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers who you are and what you make, in a sentence or two.</p>" }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "url", "id": "instagram", "label": "Instagram" },
        { "type": "url", "id": "tiktok", "label": "TikTok" },
        { "type": "url", "id": "pinterest", "label": "Pinterest" },
        { "type": "url", "id": "facebook", "label": "Facebook" },
        { "type": "url", "id": "youtube", "label": "YouTube" },
        { "type": "url", "id": "x", "label": "X" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
