{%- comment -%}
  Password page, set up as a launch page.
  A wordmark that breathes from tight to wide, a countdown to the opening (it
  reuses <k-countdown> from the Next drop section), a notify-me form, a strip
  of upcoming pieces in greyscale, and the owner's password entry tucked
  behind a button. The password form opens on its own when it has an error.
{%- endcomment -%}
{%- liquid
  assign sid = 'password-' | append: section.id
  assign date = section.settings.open_date | strip
  assign time = section.settings.open_time | strip | default: '10:00'
  assign tz = 'now' | date: '%z'
  assign tz_h = tz | slice: 0, 3
  assign tz_m = tz | slice: 3, 2
  assign end_iso = date | append: 'T' | append: time | append: ':00' | append: tz_h | append: ':' | append: tz_m
  assign show_timer = false
  if date != blank
    assign end_ts = end_iso | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    if end_ts > now_ts
      assign show_timer = true
    endif
  endif

  assign strip = section.settings.strip_products
  if strip == blank or strip.size == 0
    assign strip = section.settings.strip_collection.products
  endif
  assign strip_count = 0
  for p in strip
    if p.featured_media and strip_count < 6
      assign strip_count = strip_count | plus: 1
    endif
  endfor
-%}

<section id="{{ sid }}" class="k-pw color-{{ section.settings.color_scheme }}">
  <div class="k-pw__in k-wrap">
    <header class="k-pw__top">
      <span class="k-label">{{ section.settings.eyebrow | default: settings.issue_label }}</span>
      <details class="k-pw__owner" data-k-pw-owner>
        <summary class="k-btn k-btn--secondary k-pw__owner-btn"><span>{{ 'password.enter' | t }}</span></summary>
        <div class="k-pw__owner-panel">
          {%- form 'storefront_password', class: 'k-pw__pwform' -%}
            <label for="{{ sid }}-password" class="k-label">{{ 'password.password' | t }}</label>
            <div class="k-pw__row">
              <input type="password" name="password" id="{{ sid }}-password" autocomplete="current-password" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ sid }}-pw-error"{% endif %}>
              <button type="submit" class="k-btn k-btn--primary"><span>{{ 'password.submit' | t }}</span></button>
            </div>
            {%- if form.errors -%}<p class="k-pw__err" id="{{ sid }}-pw-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          {%- endform -%}
        </div>
      </details>
    </header>

    <div class="k-pw__mid">
      <h1 class="k-pw__word">
        {%- if section.settings.wordmark_image != blank -%}
          {{ section.settings.wordmark_image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 70vw, 90vw', widths: '600, 900, 1200, 1600', alt: shop.name, class: 'k-pw__logo' }}
        {%- else -%}
          {{ shop.name | escape }}
        {%- endif -%}
      </h1>

      {%- if show_timer -%}
        {%- if section.settings.heading != blank -%}
          <p class="k-pw__heading">{{ section.settings.heading }}</p>
        {%- endif -%}
        <k-countdown class="k-pw__timer" data-end="{{ end_iso | escape }}" data-after="show">
          <div class="k-pw__digits" role="timer" aria-label="{{ 'sections.countdown.label' | t }}" data-drop-live-hide>
            {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
            {%- for unit in units -%}
              {%- assign unit_key = 'sections.countdown.' | append: unit -%}
              <div><b data-unit="{{ unit }}">00</b><span class="k-label">{{ unit_key | t }}</span></div>
            {%- endfor -%}
          </div>
        </k-countdown>
      {%- endif -%}

      {%- if shop.password_message != blank -%}
        <div class="k-pw__msg">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', class: 'k-pw__notify' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,launch">
          {%- if form.posted_successfully? -%}
            <p class="k-pw__ok" role="status">{{ section.settings.success_text }}</p>
          {%- else -%}
            <label for="{{ sid }}-email" class="visually-hidden">{{ 'password.newsletter_email' | t }}</label>
            <input type="email" id="{{ sid }}-email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | escape }}" autocomplete="email" spellcheck="false" autocapitalize="off" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ sid }}-email-error"{% endif %}>
            <button type="submit" class="k-btn k-btn--primary"><span>{{ section.settings.newsletter_button | escape }}</span></button>
            {%- if form.errors -%}<p class="k-pw__err" id="{{ sid }}-email-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>

    {%- if strip_count > 0 -%}
      <ul class="k-pw__strip" role="list" aria-label="{{ section.settings.strip_label | escape }}" style="--n: {{ strip_count }};">
        {%- assign shown = 0 -%}
        {%- for p in strip -%}
          {%- if shown >= 6 -%}{%- break -%}{%- endif -%}
          {%- unless p.featured_media -%}{%- continue -%}{%- endunless -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="k-media">
            {{ p.featured_media | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 33vw', widths: '240, 360, 480', alt: p.title }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .k-pw { min-height: 100vh; min-height: 100svh; background: var(--color-bg); color: var(--color-text); }
  .k-pw__in { min-height: inherit; display: grid; grid-template-rows: auto 1fr auto; gap: 32px; padding-block: 24px; }
  .k-pw__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; position: relative; z-index: 2; }
  .k-pw__owner summary { list-style: none; min-height: 44px; padding-inline: 18px; font-size: 13px; }
  .k-pw__owner summary::-webkit-details-marker { display: none; }
  .k-pw__owner-panel {
    position: absolute; right: 0; top: calc(100% + 10px); width: min(380px, calc(100vw - 2 * var(--gutter)));
    padding: 18px; border: 1.5px solid var(--color-text); background: var(--color-bg);
    animation: k-rise-in 0.4s var(--ease-out) both;
  }
  .k-pw__pwform { display: grid; gap: 10px; }
  .k-pw__row { display: flex; gap: 8px; }
  .k-pw__row input, .k-pw__notify input[type="email"] {
    flex: 1; min-width: 0; min-height: 52px; padding: 0 18px;
    border: 1px solid var(--color-line); border-radius: 999px; background: transparent; color: inherit; font: 500 16px var(--font-body);
  }
  .k-pw__err { margin: 0; flex-basis: 100%; font-size: 14px; color: var(--color-accent); }

  .k-pw__mid { display: grid; align-content: center; justify-items: center; gap: 28px; text-align: center; }
  .k-pw__word {
    margin: 0; max-width: 100%; overflow-wrap: anywhere;
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black);
    font-size: clamp(64px, 16vw, 260px); line-height: 0.8; letter-spacing: -0.05em; text-transform: uppercase;
    animation: k-pw-breathe 7s ease-in-out infinite alternate;
  }
  .k-pw__logo { display: block; width: min(70vw, 900px); height: auto; margin-inline: auto; }
  .k-pw__word:has(.k-pw__logo) { animation: none; }
  @keyframes k-pw-breathe { from { letter-spacing: -0.07em; } to { letter-spacing: 0.02em; } }
  .k-pw__heading { margin: 0; font-family: var(--font-label); font-size: var(--text-label); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.72; }
  .k-pw__digits { display: flex; justify-content: center; gap: clamp(12px, 2.6vw, 36px); }
  .k-pw__digits div { display: grid; justify-items: center; gap: 6px; }
  .k-pw__digits b {
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black);
    font-size: clamp(42px, 7vw, 100px); line-height: 0.9; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
  }
  .k-pw__digits b.is-tick { animation: k-pw-tick 0.45s var(--ease-out); }
  @keyframes k-pw-tick { from { transform: scaleX(1.18); opacity: 0.6; } }
  .k-pw__digits .k-label { opacity: 0.72; }
  .k-pw__msg { max-width: 52ch; font-size: 17px; line-height: 1.5; }
  .k-pw__notify { display: flex; flex-wrap: wrap; gap: 8px; width: min(540px, 100%); }
  .k-pw__ok { margin: 0; flex-basis: 100%; font-weight: 600; }

  .k-pw__strip { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr)); gap: 8px; }
  .k-pw__strip li { aspect-ratio: 3 / 4; overflow: hidden; }
  .k-pw__strip img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); transition: filter 0.6s var(--ease-out); }
  .k-pw__strip li:hover img { filter: none; }

  @media (max-width: 749px) {
    .k-pw__strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .k-pw__strip li:nth-child(n + 4) { display: none; }
    .k-pw__row { flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) { .k-pw__word, .k-pw__digits b.is-tick { animation: none; } }
  [data-motion="off"] .k-pw__word { animation: none; }
{% endstylesheet %}

{% javascript %}
  (function () {
    function open() {
      var d = document.querySelector('[data-k-pw-owner]');
      if (d && d.querySelector('.k-pw__err')) { d.open = true; var i = d.querySelector('input'); if (i) i.focus(); }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', open); else open();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "k-pw-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "info": "Leave empty to show the issue label from Theme settings." },
    { "type": "image_picker", "id": "wordmark_image", "label": "Wordmark image", "info": "Optional. Without it, the store name is set as a large breathing wordmark." },
    { "type": "inline_richtext", "id": "heading", "label": "Countdown heading", "default": "The store opens in", "info": "Shown above the countdown." },
    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "open_date", "label": "Opening date", "info": "Format YYYY-MM-DD, for example 2026-11-20. Uses your store's time zone. Leave empty to hide the countdown." },
    { "type": "text", "id": "open_time", "label": "Opening time", "default": "10:00", "info": "24-hour format, for example 18:30." },
    { "type": "header", "content": "Notify me" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show the sign-up form", "default": true, "info": "Sign-ups are saved as customers tagged newsletter and launch." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Placeholder", "default": "Your email, for first access" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "success_text", "label": "Thank-you message", "default": "You’re on the list. We’ll email you when we open." },
    { "type": "header", "content": "Coming soon strip" },
    { "type": "product_list", "id": "strip_products", "label": "Products", "limit": 6, "info": "Shown in greyscale along the bottom. Hidden when empty." },
    { "type": "collection", "id": "strip_collection", "label": "Or a collection" },
    { "type": "text", "id": "strip_label", "label": "Strip description for screen readers", "default": "Pieces coming soon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
