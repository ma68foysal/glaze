{%- liquid
  assign form_id = 'k-search-' | append: section.id
  assign terms = search.terms
  assign terms_html = terms | escape
  assign q_encoded = terms | url_encode
  assign search_type = search.types | join: ','
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign popular = settings.popular_searches | split: ','
  assign active_count = 0
  for filter in search.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
  assign current = 'all'
  if search_type == 'product' or search_type == 'article' or search_type == 'page'
    assign current = search_type
  endif
  assign base_url = routes.search_url | append: '?q=' | append: q_encoded | append: '&options%5Bprefix%5D=last'
  assign clear_url = base_url
  if current != 'all'
    assign clear_url = clear_url | append: '&type=' | append: current
  endif
  assign clear_url = clear_url | append: '&sort_by=' | append: sort_by
-%}

<section class="k-srch k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}" data-search-page data-terms="{{ terms | escape }}">
  <div class="k-wrap">
    <header class="k-srch__head">
      <nav class="k-label k-muted k-srch__crumbs" aria-label="{{ 'products.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'products.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ 'search.title' | t }}</span>
      </nav>
      <h1 class="visually-hidden">
        {%- if search.performed -%}{{ 'search.results_for_html' | t: terms: terms_html }}{%- else -%}{{ 'search.title' | t }}{%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="k-srch__form">
        <label for="{{ form_id }}-q" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
        <input type="search" id="{{ form_id }}-q" name="q" value="{{ terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-search-input>
        <input type="hidden" name="options[prefix]" value="last">
        {%- if current != 'all' -%}<input type="hidden" name="type" value="{{ current }}">{%- endif -%}
        <button type="button" class="k-icon-btn k-srch__clear" aria-label="{{ 'search.clear' | t }}" data-search-clear{% if terms == blank %} hidden{% endif %}>{% render 'k-icon', icon: 'close', size: 24 %}</button>
        <button type="submit" class="k-srch__go" aria-label="{{ 'search.submit' | t }}">{% render 'k-icon', icon: 'arrow', size: 24 %}</button>
      </form>

      <div class="k-srch__summary">
        {%- if search.performed -%}
          <p class="k-srch__count" role="status"><strong>{{ 'search.results_count' | t: count: search.results_count }}</strong> <span class="k-muted">{{ 'search.for_terms' | t: terms: terms }}</span></p>
        {%- endif -%}
        {%- liquid
          assign related = ''
          if search.performed
            for item in search.results
              if item.object_type == 'product' and item.type != blank
                assign t = item.type | strip
                unless related contains t
                  assign related = related | append: t | append: '|'
                endunless
              endif
            endfor
          endif
          assign related_list = related | split: '|'
          assign chips_label = 'search.related' | t
          if related_list.size == 0
            assign related_list = popular
            assign chips_label = 'general.popular_searches' | t
          endif
        -%}
        {%- if related_list.size > 0 -%}
          <div class="k-srch__related">
            <span class="k-label k-muted">{{ chips_label }}:</span>
            {%- for r in related_list limit: 5 -%}
              {%- assign r = r | strip -%}
              {%- if r != blank -%}
                <a class="k-srch__rel" href="{{ routes.search_url }}?q={{ r | url_encode }}&amp;options%5Bprefix%5D=last">{{ r }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </header>

    {%- if search.performed -%}
      <nav class="k-srch__tabs" aria-label="{{ 'search.types_label' | t }}">
        {%- assign types = 'all,product,article,page' | split: ',' -%}
        {%- for t in types -%}
          {%- liquid
            assign type_url = base_url
            if t != 'all'
              assign type_url = type_url | append: '&type=' | append: t
            endif
            assign label_key = 'search.type_' | append: t
          -%}
          <a class="k-srch__tab{% if t == current %} is-active{% endif %}" href="{{ type_url }}"{% if t == current %} aria-current="page"{% endif %}>
            {{- label_key | t -}}
            {%- if t == current -%}<sup>{{ search.results_count }}</sup>{%- endif -%}
          </a>
        {%- endfor -%}
      </nav>

      {%- paginate search.results by section.settings.per_page -%}
        {%- liquid
          assign products = search.results | where: 'object_type', 'product'
          assign articles = search.results | where: 'object_type', 'article'
          assign pages = search.results | where: 'object_type', 'page'
          assign show_products = false
          if current == 'all' or current == 'product'
            if products.size > 0 or active_count > 0
              assign show_products = true
            endif
          endif
          assign shown = paginate.current_offset | plus: search.results.size
          assign progress = 1
          if paginate.items > 0
            assign progress = shown | times: 1.0 | divided_by: paginate.items
          endif
        -%}

        {%- if search.results_count == 0 -%}
          <div class="k-srch__empty">
            <p class="k-srch__empty-title">{{ 'search.no_results_html' | t: terms: terms_html }}</p>
            <p class="k-muted">{{ 'search.no_results_hint' | t }}</p>
            {%- if popular.size > 0 -%}
              <div class="k-srch__related">
                {%- for r in popular limit: 6 -%}
                  {%- assign r = r | strip -%}
                  {%- if r != blank -%}<a class="k-srch__rel k-srch__rel--line" href="{{ routes.search_url }}?q={{ r | url_encode }}&amp;options%5Bprefix%5D=last">{{ r }}</a>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="k-srch__empty-actions">
              {%- if active_count > 0 -%}<a class="k-btn k-btn--primary" href="{{ clear_url }}">{{ 'sections.collection.clear_filters' | t }}</a>{%- endif -%}
              <a class="k-btn k-btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.shop_all' | t }}</a>
            </div>
          </div>
        {%- endif -%}

        {%- if show_products -%}
          <div class="k-srch__layout{% if section.settings.show_filters == false or search.filters.size == 0 %} k-srch__layout--full{% endif %}">
            {%- if section.settings.show_filters -%}
              {%- render 'k-facets', part: 'sidebar', results: search, url: routes.search_url, form_id: form_id, sort_by: sort_by, active_count: active_count, clear_url: clear_url, terms: terms, search_type: search_type -%}
            {%- endif -%}
            <div class="k-srch__main">
              <div class="k-srch__bar">
                <div class="k-srch__active">
                  {%- if section.settings.show_filters -%}
                    {%- render 'k-facets', part: 'filters', results: search, url: routes.search_url, form_id: form_id, active_count: active_count, clear_url: clear_url -%}
                  {%- endif -%}
                  <span class="k-label k-muted">{{ 'search.products_count' | t: count: products.size }}</span>
                </div>
                <div class="k-srch__tools">
                  {%- if section.settings.show_sort -%}
                    {%- render 'k-facets', part: 'sort', results: search, url: routes.search_url, form_id: form_id, sort_by: sort_by, terms: terms, search_type: search_type -%}
                  {%- endif -%}
                  <div class="k-srch__view" role="group" aria-label="{{ 'search.layout' | t }}">
                    <button type="button" aria-pressed="true" data-view="grid" aria-label="{{ 'search.grid_view' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></button>
                    <button type="button" aria-pressed="false" data-view="list" aria-label="{{ 'search.list_view' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
                  </div>
                </div>
              </div>

              {%- if products.size > 0 -%}
                <ul class="k-srch__grid" role="list" data-results="product" data-view-target>
                  {%- for item in products -%}
                    <li{% if forloop.index > 4 %} class="k-reveal"{% endif %}>{%- render 'k-card', product: item, quick_add: section.settings.quick_add, heading_tag: 'h2' -%}</li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <div class="k-srch__empty k-srch__empty--inline">
                  <p class="k-srch__empty-title">{{ 'search.no_filtered' | t }}</p>
                  <p class="k-muted">{{ 'search.no_filtered_hint' | t }}</p>
                  <a class="k-btn k-btn--primary" href="{{ clear_url }}">{{ 'sections.collection.clear_filters' | t }}</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if articles.size > 0 -%}
          <div class="k-srch__blk">
            <div class="k-srch__blk-h">
              <h2>{{ 'search.type_article' | t }} <em>({{ articles.size }})</em></h2>
              {%- if current == 'all' -%}<a class="k-label k-srch__see" href="{{ base_url }}&amp;type=article">{{ 'search.see_all_articles' | t }}</a>{%- endif -%}
            </div>
            <ul class="k-srch__arts" role="list" data-results="article">
              {%- for item in articles -%}
                {%- liquid
                  assign words = item.content | strip_html | split: ' ' | size
                  assign minutes = words | plus: 199 | divided_by: 200 | at_least: 1
                -%}
                <li>
                  <a class="k-srch__art" href="{{ item.url }}">
                    <span class="k-srch__art-img k-media">
                      {%- if item.image -%}
                        {{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '180px', alt: '' }}
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'k-ph' }}
                      {%- endif -%}
                    </span>
                    <span>
                      <span class="k-label k-muted">{% if item.tags.size > 0 %}{{ item.tags.first }} · {% endif %}{{ 'blogs.read_time' | t: count: minutes }}</span>
                      <span class="k-srch__art-title" data-highlight>{{ item.title }}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if pages.size > 0 -%}
          <div class="k-srch__blk">
            <div class="k-srch__blk-h"><h2>{{ 'search.type_page' | t }} <em>({{ pages.size }})</em></h2></div>
            <ul class="k-srch__pages" role="list" data-results="page">
              {%- for item in pages -%}
                <li><a class="k-srch__pg" href="{{ item.url }}"><span data-highlight>{{ item.title }}</span>{% render 'k-icon', icon: 'arrow', size: 20 %}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if paginate.next -%}
          <div class="k-srch__more" data-more>
            <p class="k-label k-muted" data-more-label data-template="{{ 'sections.collection.showing_count' | t: shown: '[shown]', total: '[total]' | escape }}">{{ 'sections.collection.showing_count' | t: shown: shown, total: paginate.items }}</p>
            <div class="k-srch__prog" aria-hidden="true"><i data-more-bar style="transform: scaleX({{ progress }});"></i></div>
            <a class="k-btn k-btn--secondary" href="{{ paginate.next.url }}" data-more-link data-total="{{ paginate.items }}">{{ 'search.load_more' | t }}</a>
          </div>
        {%- endif -%}

        {%- if section.settings.show_filters -%}
          {%- render 'k-facets', part: 'drawer', results: search, url: routes.search_url, form_id: form_id, sort_by: sort_by, active_count: active_count, clear_url: clear_url, scheme: section.settings.drawer_color_scheme, terms: terms, search_type: search_type -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      {%- assign trending = section.settings.empty_collection -%}
      {%- if trending != blank and trending.products_count > 0 -%}
        <div class="k-srch__blk">
          <div class="k-srch__blk-h"><h2>{{ section.settings.empty_heading }}</h2><a class="k-label k-srch__see" href="{{ trending.url }}">{{ 'general.view_all' | t }}</a></div>
          <ul class="k-srch__grid k-srch__grid--4" role="list">
            {%- for item in trending.products limit: 4 -%}
              <li class="k-reveal">{%- render 'k-card', product: item, quick_add: section.settings.quick_add -%}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var sec = document.querySelector('[data-search-page]');
    if (!sec || sec.dataset.bound) return;
    sec.dataset.bound = '1';
    var terms = sec.dataset.terms;
    var mark = function (root) {
      root.querySelectorAll('.k-card__title a').forEach(function (a) { a.setAttribute('data-highlight', ''); });
      if (window.ObliqueHighlight) window.ObliqueHighlight(root, terms);
    };
    // theme.js is deferred, so the highlighter exists once the document has parsed.
    if (window.ObliqueHighlight) mark(sec);
    else document.addEventListener('DOMContentLoaded', function () { mark(sec); });

    var input = sec.querySelector('[data-search-input]'), clear = sec.querySelector('[data-search-clear]');
    if (input && clear) {
      input.addEventListener('input', function () { clear.hidden = !input.value; });
      clear.addEventListener('click', function () { input.value = ''; clear.hidden = true; input.focus(); });
    }

    // Sidebar filters apply as soon as a value changes.
    sec.querySelectorAll('[data-auto-submit]').forEach(function (form) {
      var t;
      form.addEventListener('change', function () { clearTimeout(t); t = setTimeout(function () { form.submit(); }, 350); });
    });

    // Grid or list, remembered for this shopper.
    var KEY = 'oblique:search-view';
    var grid = sec.querySelector('[data-view-target]');
    var setView = function (v) {
      if (!grid) return;
      grid.classList.toggle('is-list', v === 'list');
      sec.querySelectorAll('[data-view]').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.view === v ? 'true' : 'false'); });
    };
    try { setView(localStorage.getItem(KEY) || 'grid'); } catch (e) {}
    sec.querySelectorAll('[data-view]').forEach(function (b) {
      b.addEventListener('click', function () { setView(b.dataset.view); try { localStorage.setItem(KEY, b.dataset.view); } catch (e) {} });
    });

    // Load more: fetch the next page and append each result type to its list.
    var more = sec.querySelector('[data-more-link]');
    if (more) {
      more.addEventListener('click', function (e) {
        e.preventDefault();
        more.classList.add('k-loading');
        var url = new URL(more.href, location.href);
        url.searchParams.set('section_id', sec.closest('[id^="shopify-section-"]').id.replace('shopify-section-', ''));
        fetch(url.toString()).then(function (r) { return r.text(); }).then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          ['product', 'article', 'page'].forEach(function (type) {
            var target = sec.querySelector('[data-results="' + type + '"]');
            var items = doc.querySelectorAll('[data-results="' + type + '"] > li');
            if (!target || !items.length) return;
            items.forEach(function (li) { li.classList.add('is-visible'); target.appendChild(li); });
            mark(target);
          });
          var label = sec.querySelector('[data-more-label]'), freshLabel = doc.querySelector('[data-more-label]');
          var bar = sec.querySelector('[data-more-bar]'), freshBar = doc.querySelector('[data-more-bar]');
          if (label && freshLabel) label.textContent = freshLabel.textContent;
          if (bar && freshBar) bar.style.transform = freshBar.style.transform;
          var next = doc.querySelector('[data-more-link]');
          if (next) { more.href = next.href; more.classList.remove('k-loading'); }
          else {
            if (bar) bar.style.transform = 'scaleX(1)';
            if (label) label.textContent = label.dataset.template.replace('[shown]', more.dataset.total).replace('[total]', more.dataset.total);
            more.remove();
          }
        }).catch(function () { window.location.href = more.href; });
      });
    }
  })();
</script>

{% stylesheet %}
  .k-srch__head { padding-bottom: 28px; }
  .k-srch__crumbs { display: flex; gap: 10px; margin-bottom: 20px; }
  .k-srch__crumbs a:hover { color: var(--color-text); }
  .k-srch__form { display: flex; align-items: center; gap: 16px; padding-bottom: 8px; border-bottom: 2px solid var(--color-text); }
  .k-srch__form input {
    flex: 1; min-width: 0; height: 96px; padding: 0; border: 0; background: transparent; color: inherit;
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(44px, 7vw, 104px) * var(--heading-scale)); letter-spacing: -0.045em;
  }
  .k-srch__form input::placeholder { color: rgba(var(--color-text-rgb), 0.25); }
  .k-srch__form input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .k-srch__form input:focus-visible { outline: none; }
  .k-srch__form:focus-within { border-bottom-color: var(--color-accent); }
  .k-srch__go {
    display: grid; place-items: center; flex: none; width: 64px; height: 64px; border: 0; border-radius: 999px;
    background: var(--color-text); color: var(--color-bg); cursor: pointer;
    transition: background-color var(--dur-fast), transform 0.4s var(--ease-out);
  }
  .k-srch__go:hover { background: var(--color-accent); transform: rotate(-45deg); }
  .k-srch__summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 18px; }
  .k-srch__count { margin: 0; font-size: 17px; }
  .k-srch__related { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .k-srch__rel {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border-radius: 999px;
    background: var(--color-surface); font-size: 14px; font-weight: 500;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  .k-srch__rel:hover { background: var(--color-text); color: var(--color-bg); }
  .k-srch__rel--line { min-height: 44px; padding: 0 16px; background: transparent; border: 1.5px solid var(--color-text); }

  .k-srch__tabs { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--color-line); }
  .k-srch__tabs::-webkit-scrollbar { display: none; }
  .k-srch__tab {
    position: relative; display: inline-flex; align-items: center; flex: none; min-height: 56px; padding: 0 18px;
    font-weight: 600; font-size: 15px; color: var(--color-muted);
  }
  .k-srch__tab sup { margin-left: 3px; font-family: var(--font-label); font-size: 10px; }
  .k-srch__tab::after {
    content: ""; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 2.5px;
    background: var(--color-text); transform: scaleX(0); transition: transform 0.45s var(--ease-out);
  }
  .k-srch__tab:hover, .k-srch__tab.is-active { color: var(--color-text); }
  .k-srch__tab.is-active::after { transform: scaleX(1); }

  .k-srch__layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 48px; padding-top: 28px; }
  .k-srch__layout--full { grid-template-columns: minmax(0, 1fr); }
  .k-facets-side { position: sticky; top: calc(var(--header-height, 0px) + 20px); align-self: start; max-height: calc(100vh - var(--header-height, 0px) - 40px); overflow-y: auto; scrollbar-width: thin; }
  .k-facets-side__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 14px; }
  .k-facets-side__title { margin: 0; font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: 24px; letter-spacing: -0.02em; }
  .k-facets-side .k-col__groups { overflow: visible; }
  .k-facets-side .k-col__group { padding: 18px 0; border-bottom: 0; border-top: 1px solid var(--color-line); }
  .k-facets-side .k-col__price { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .k-srch__main { min-width: 0; }
  .k-srch__bar { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
  .k-srch__active { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .k-srch__tools { display: flex; align-items: center; gap: 10px; }
  .k-srch__view { display: inline-flex; padding: 3px; border: 1.5px solid var(--color-line); border-radius: 999px; }
  .k-srch__view button { display: grid; place-items: center; width: 40px; height: 36px; border: 0; border-radius: 999px; background: none; color: inherit; cursor: pointer; }
  .k-srch__view button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }

  .k-srch__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; margin: 0; padding: 0; list-style: none; }
  .k-srch__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .k-srch__grid mark, .k-srch__art-title mark, .k-srch__pg mark { background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: inherit; }
  .k-srch__grid.is-list { grid-template-columns: 1fr; gap: 14px; }
  .k-srch__grid.is-list .k-card { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 20px; align-items: center; padding: 12px; border-radius: 20px; background: var(--color-surface); }
  .k-srch__grid.is-list .k-card__media { aspect-ratio: 4 / 5; border-radius: 12px; }
  .k-srch__grid.is-list .k-card__meta { padding-top: 0; font-size: 18px; }

  .k-srch__blk { padding-top: 48px; }
  .k-srch__blk-h { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 16px; }
  .k-srch__blk-h h2 { margin: 0; font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: 36px; letter-spacing: -0.03em; }
  .k-srch__blk-h h2 em { font-family: var(--font-accent); font-style: var(--font-accent-style); font-weight: 400; }
  .k-srch__see { text-decoration: underline; text-underline-offset: 3px; }
  .k-srch__arts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .k-srch__art { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 20px; align-items: center; padding: 14px; border-radius: calc(var(--radius-card) * 0.85); background: var(--color-surface); transition: transform 0.4s var(--ease-out); }
  .k-srch__art:hover { transform: translateY(-3px); }
  .k-srch__art-img { display: block; height: 140px; border-radius: 14px; }
  .k-srch__art-title { display: block; margin-top: 6px; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .k-srch__pages { margin: 0; padding: 0; list-style: none; }
  .k-srch__pg { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 76px; padding: 0 6px; border-bottom: 1px solid var(--color-line); font-size: 20px; font-weight: 700; transition: color var(--dur-fast); }
  .k-srch__pg:hover { color: var(--color-accent); }
  .k-srch__pg .k-icon { flex: none; transition: transform var(--dur-fast); }
  .k-srch__pg:hover .k-icon { transform: translateX(4px) rotate(-45deg); }

  .k-srch__empty { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-top: 28px; padding: 40px; border-radius: var(--radius-card); background: var(--color-surface); }
  .k-srch__empty--inline { margin-top: 0; }
  .k-srch__empty p { margin: 0; max-width: 600px; }
  .k-srch__empty-title { font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: 34px; letter-spacing: -0.02em; line-height: 1; overflow-wrap: anywhere; }
  .k-srch__empty-title em { font-family: var(--font-accent); font-style: var(--font-accent-style); font-weight: 400; }
  .k-srch__empty-actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .k-srch__more { display: flex; flex-direction: column; align-items: center; gap: 14px; padding-top: 48px; }
  .k-srch__more p { margin: 0; }
  .k-srch__prog { width: 220px; height: 3px; border-radius: 999px; background: rgba(var(--color-text-rgb), 0.1); overflow: hidden; }
  .k-srch__prog i { display: block; height: 100%; background: var(--color-text); transform-origin: 0 50%; transition: transform 0.6s var(--ease-out); }

  @media (min-width: 901px) { .k-srch__layout:not(.k-srch__layout--full) .k-col__filter-btn { display: none; } }
  @media (max-width: 1100px) {
    .k-srch__grid, .k-srch__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .k-srch__layout { grid-template-columns: 1fr; gap: 0; padding-top: 20px; }
    .k-facets-side { display: none; }
    .k-srch__form input { height: 72px; }
    .k-srch__go { width: 52px; height: 52px; }
    .k-srch__grid { gap: 24px 12px; }
    .k-srch__grid.is-list .k-card { grid-template-columns: 110px minmax(0, 1fr); }
    .k-srch__arts { grid-template-columns: 1fr; }
    .k-srch__art { grid-template-columns: 110px minmax(0, 1fr); }
    .k-srch__art-img { height: 96px; }
    .k-srch__empty { padding: 24px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "class": "k-srch-section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 8, "max": 36, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add", "default": true },
    { "type": "header", "content": "Filtering and sorting" },
    { "type": "checkbox", "id": "show_filters", "label": "Enable filtering", "default": true, "info": "Customize filters with the Search and Discovery app." },
    { "type": "checkbox", "id": "show_sort", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Before a search" },
    { "type": "collection", "id": "empty_collection", "label": "Products to show", "info": "Shown on the search page before a shopper searches. Popular searches come from Theme settings > Search." },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Trending now" },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "drawer_color_scheme", "label": "Filter drawer on phones", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "enabled_on": { "templates": ["search"] }
}
{% endschema %}
