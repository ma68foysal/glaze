{%- liquid
  assign form_id = 'k-search-' | append: section.id
  assign terms = search.terms
  assign terms_html = terms | escape
  assign q_encoded = terms | url_encode
  assign search_type = search.types | join: ','
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign active_count = 0
  for filter in search.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
  assign base_url = routes.search_url | append: '?q=' | append: q_encoded | append: '&options%5Bprefix%5D=last'
  assign clear_url = base_url
  if search_type == 'product' or search_type == 'article' or search_type == 'page'
    assign clear_url = clear_url | append: '&type=' | append: search_type
  endif
  assign clear_url = clear_url | append: '&sort_by=' | append: sort_by
-%}

<section class="k-srch k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}">
  <div class="k-wrap">
    <header class="k-srch__head">
      <h1 class="k-srch__title">
        {%- if search.performed -%}
          {{ 'search.results_for_html' | t: terms: terms_html }}
        {%- else -%}
          {{ 'search.title' | t }}
        {%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="k-searchbar">
        <label for="{{ form_id }}-q" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
        {%- render 'k-icon', icon: 'search', size: 22 -%}
        <input type="search" id="{{ form_id }}-q" name="q" value="{{ terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
        <input type="hidden" name="options[prefix]" value="last">
        {%- if search_type == 'product' or search_type == 'article' or search_type == 'page' -%}<input type="hidden" name="type" value="{{ search_type }}">{%- endif -%}
        <button type="submit" class="k-btn k-btn--primary">{{ 'search.submit' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      <nav class="k-srch__types" aria-label="{{ 'search.types_label' | t }}">
        {%- liquid
          assign types = 'all,product,article,page' | split: ','
          assign current = 'all'
          if search_type == 'product' or search_type == 'article' or search_type == 'page'
            assign current = search_type
          endif
        -%}
        {%- for t in types -%}
          {%- liquid
            assign type_url = base_url
            if t != 'all'
              assign type_url = type_url | append: '&type=' | append: t
            endif
            assign label_key = 'search.type_' | append: t
          -%}
          <a class="k-chip{% if t == current %} is-active{% endif %}" href="{{ type_url }}"{% if t == current %} aria-current="page"{% endif %}>{{ label_key | t }}</a>
        {%- endfor -%}
      </nav>

      {%- paginate search.results by section.settings.per_page -%}
        <div class="k-col__bar k-srch__bar">
          <div class="k-col__bar-l">
            {%- if section.settings.show_filters -%}
              {%- render 'k-facets', part: 'filters', results: search, url: routes.search_url, form_id: form_id, active_count: active_count, clear_url: clear_url -%}
            {%- endif -%}
            <span class="k-label k-muted" role="status">{{ 'search.results_count' | t: count: search.results_count }}</span>
          </div>
          {%- if section.settings.show_sort and search.results_count > 0 -%}
            <div class="k-col__bar-r">
              {%- render 'k-facets', part: 'sort', results: search, url: routes.search_url, form_id: form_id, sort_by: sort_by, terms: terms, search_type: search_type -%}
            </div>
          {%- endif -%}
        </div>

        {%- if search.results_count > 0 -%}
          <ul class="k-srch__grid" role="list" style="--cols: {{ section.settings.columns }};">
            {%- for item in search.results -%}
              <li class="k-reveal k-srch__item k-srch__item--{{ item.object_type }}">
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- render 'k-card', product: item, quick_add: section.settings.quick_add -%}
                  {%- when 'article' -%}
                    {%- render 'k-article-card', article: item, show_excerpt: false, show_meta: true, sizes: '(min-width: 900px) 25vw, 50vw' -%}
                  {%- when 'page' -%}
                    <article class="k-srch__page">
                      <span class="k-label k-muted">{{ 'search.label_page' | t }}</span>
                      <h2 class="k-srch__page-title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                      {%- assign page_text = item.content | strip_html | truncatewords: 22 -%}
                      {%- if page_text != blank -%}<p class="k-muted">{{ page_text }}</p>{%- endif -%}
                      <span class="k-arrow-circle" aria-hidden="true">{% render 'k-icon', icon: 'arrow', size: 18 %}</span>
                    </article>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="k-srch__empty">
            <p class="k-h3">{{ 'search.no_results_html' | t: terms: terms_html }}</p>
            <p class="k-muted">{{ 'search.no_results_hint' | t }}</p>
            <div class="k-srch__empty-actions">
              {%- if active_count > 0 -%}
                <a class="k-btn k-btn--primary" href="{{ clear_url }}">{{ 'sections.collection.clear_filters' | t }}</a>
              {%- endif -%}
              <a class="k-btn k-btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.shop_all' | t }}</a>
            </div>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="k-pager" aria-label="{{ 'blogs.pagination' | t }}">
            {%- if paginate.previous -%}<a class="k-pager__pg" href="{{ paginate.previous.url }}" aria-label="{{ 'blogs.previous_page' | t }}">←</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a class="k-pager__pg" href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="k-pager__pg is-current" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="k-pager__pg k-pager__gap">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a class="k-pager__pg" href="{{ paginate.next.url }}" aria-label="{{ 'blogs.next_page' | t }}">→</a>{%- endif -%}
          </nav>
        {%- endif -%}

        {%- if section.settings.show_filters -%}
          {%- render 'k-facets', part: 'drawer', results: search, url: routes.search_url, form_id: form_id, sort_by: sort_by, active_count: active_count, clear_url: clear_url, scheme: section.settings.drawer_color_scheme, terms: terms, search_type: search_type -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="k-srch__start">
        <p class="k-muted">{{ 'search.start' | t }}</p>
        <a class="k-btn k-btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.shop_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .k-srch__head { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; align-items: end; padding-bottom: 32px; }
  .k-srch__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(48px, 8vw, 128px) * var(--heading-scale));
    letter-spacing: -0.04em;
    line-height: 0.86;
    overflow-wrap: anywhere;
  }
  .k-srch__title em { font-family: var(--font-accent); font-style: var(--font-accent-style); font-weight: 400; letter-spacing: -0.01em; }
  .k-srch__types { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 20px; }
  .k-srch__types .k-chip.is-active { background: var(--color-text); color: var(--color-bg); border-color: var(--color-text); }
  .k-srch__grid {
    display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: 32px var(--space-md); margin: 0; padding: 32px 0 0; list-style: none;
  }
  .k-srch__page {
    position: relative; display: flex; flex-direction: column; gap: 12px; height: 100%; min-height: 220px; padding: 24px;
    border-radius: calc(var(--radius-card) * 0.7); background: var(--color-surface);
  }
  .k-srch__page p { margin: 0; font-size: 15px; line-height: 1.5; }
  .k-srch__page-title { margin: 0; font-size: 24px; font-weight: 750; letter-spacing: -0.02em; line-height: 1.1; }
  .k-srch__page-title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .k-srch__page .k-arrow-circle { margin-top: auto; }
  .k-srch__page:hover .k-arrow-circle { transform: rotate(-45deg); }
  .k-srch__empty, .k-srch__start { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 80px 0 24px; text-align: center; }
  .k-srch__empty p { margin: 0; max-width: 560px; }
  .k-srch__empty .k-h3 em { font-family: var(--font-accent); font-style: var(--font-accent-style); font-weight: 400; }
  .k-srch__empty-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }
  .k-srch__start p { margin: 0; font-size: 18px; }
  @media (max-width: 900px) {
    .k-srch__head { grid-template-columns: 1fr; gap: 24px; }
    .k-srch__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px var(--space-sm); }
    .k-srch__page { min-height: 180px; padding: 18px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "class": "k-srch-section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 8, "max": 36, "step": 4, "default": 16 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add", "default": true },
    { "type": "header", "content": "Filtering and sorting" },
    { "type": "checkbox", "id": "show_filters", "label": "Enable filtering", "default": true, "info": "Customize filters with the Search and Discovery app." },
    { "type": "checkbox", "id": "show_sort", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "drawer_color_scheme", "label": "Filter drawer", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "medium", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "enabled_on": { "templates": ["search"] }
}
{% endschema %}
