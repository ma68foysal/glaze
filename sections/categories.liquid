<div class="color-{{ section.settings.color_scheme }} k-legacy-scheme">
{%- liquid
  assign section_id = 'cats-' | append: section.id
  assign title = section.settings.title
  assign description = section.settings.description
  assign tile_size_default = section.settings.tile_size

  comment
    Auto-fallback so the same section works across all collection pages
    without per-template overrides: when the merchant leaves Title blank
    on a collection page, use the current collection's title.
  endcomment
  if title == blank and template.name == 'collection' and collection
    assign title = collection.title
  endif
-%}

<section
  id="{{ section_id }}"
  class="skinova-cats full-width"
  style="--cats-bg: var(--color-bg);"
>
  <div class="skinova-cats__inner">
    {%- if title != blank or description != blank -%}
      <header class="skinova-cats__head">
        {%- if title != blank -%}
          <h2 class="skinova-cats__title">{{ title | escape }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <p class="skinova-cats__desc">{{ description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="skinova-cats__items" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b_title = block.settings.title
            assign b_link = block.settings.link
            assign b_image = block.settings.image
            assign b_radius = block.settings.radius
            assign b_size = block.settings.size
            if b_size == 0
              assign b_size = tile_size_default
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            {%- assign cat_tag = 'div' -%}
            {%- if b_link != blank -%}{%- assign cat_tag = 'a' -%}{%- endif -%}
            <{{ cat_tag }}
              class="skinova-cats__item"
              {% if b_link != blank %}href="{{ b_link }}"{% endif %}
              style="--ci-bg: rgba(var(--color-text-rgb), 0.06); --ci-radius: {{ b_radius }}%; --ci-size: {{ b_size }}px;"
            >
              <span class="skinova-cats__img">
                {%- if b_image != blank -%}
                  {{ b_image | image_url: width: 240 | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240',
                    sizes: '120px',
                    alt: b_title | escape
                  }}
                {%- else -%}
                  <span class="skinova-cats__img-fallback" aria-hidden="true">{{ b_title | slice: 0, 1 | upcase }}</span>
                {%- endif -%}
              </span>
              {%- if b_title != blank -%}
                <span class="skinova-cats__label">{{ b_title | escape }}</span>
              {%- endif -%}
            </{{ cat_tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
</div>

{% stylesheet %}
  .skinova-cats {
    background: var(--cats-bg, var(--g-cream, #fbe9e8));
    padding: 32px 24px 40px;
  }
  .skinova-cats__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .skinova-cats__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }
  .skinova-cats__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .skinova-cats__title {
    font-family: var(--g-display-font);
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .skinova-cats__desc {
    color: var(--g-muted-strong, #555);
    line-height: 1.5;
    max-width: 48ch;
    margin: 0;
    font-size: 14px;
  }
  .skinova-cats__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .skinova-cats__item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--g-ink);
    transition: transform 0.25s ease;
  }
  .skinova-cats__item:hover { transform: translateY(-3px); }
  .skinova-cats__img {
    width: var(--ci-size, 90px);
    height: var(--ci-size, 90px);
    border-radius: var(--ci-radius, 50%);
    background: var(--ci-bg, #ffffff);
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.25s ease;
  }
  .skinova-cats__item:hover .skinova-cats__img {
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
  }
  .skinova-cats__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .skinova-cats__img-fallback {
    font-family: var(--g-display-font);
    font-size: 28px;
    font-weight: 600;
    color: var(--g-ink);
  }
  .skinova-cats__label {
    font-size: 12px;
    color: var(--g-ink);
    text-align: center;
    line-height: 1.2;
    max-width: 110px;
  }
  @media (max-width: 899px) {
    .skinova-cats { padding: 24px 16px 32px; }
    .skinova-cats__items {
      gap: 16px;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: thin;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Categories",
  "tag": "section",
  "class": "section-categories",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Facial Cleanser"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Shop by skin type and concern. Every formula is dermatologist-tested, fragrance-free and made to sit well on sensitive skin."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "tile_size",
      "label": "Default tile size",
      "min": 60,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 90,
      "info": "Fallback when a block leaves its own size at 0."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Custom image — upload anything (product shot, lifestyle, illustration)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "radius",
          "label": "Corner radius",
          "min": 0,
          "max": 50,
          "step": 5,
          "unit": "%",
          "default": 50,
          "info": "50% = circle, 0% = square."
        },
        {
          "type": "range",
          "id": "size",
          "label": "Tile size",
          "min": 0,
          "max": 140,
          "step": 5,
          "unit": "px",
          "default": 0,
          "info": "0 = inherit section default."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Skin Transforming"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Facial Cleanser"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Toner & Mist"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Serums"
          }
        }
      ]
    }
  ]
}
{% endschema %}
