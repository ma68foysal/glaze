{%- comment -%}
  Skinova — Highlight Statement (editorial spread).

  NOT a Sleek-style inline flow. The composition is a 2-column spread:
    [ optional hero image anchor ]  [ multi-line statement column ]
  Each line in the statement column has its own alignment (left/center/right),
  driven by section settings line_1_align … line_4_align — so the layout reads
  like a magazine spread, not a flat centered ribbon.

  Layered on top:
    • Background echo word — huge outlined typography sitting behind the
      composition; parallax-shifted on scroll.
    • Sticker overlays — small rotated tag/badge blocks positioned
      absolutely via x/y percent, on top of everything.

  Animations: text mask reveal, image clip-path reveal, gentle float,
  3D cursor tilt, scroll parallax, optional cursor-follow spotlight.
  All respect prefers-reduced-motion.
{%- endcomment -%}

{%- liquid
  assign section_id = 'stmt-' | append: section.id
  assign anim_mask = section.settings.anim_mask
  assign anim_parallax = section.settings.anim_parallax
  assign anim_tilt = section.settings.anim_tilt
  assign anim_spotlight = section.settings.anim_spotlight
  assign show_marquee = section.settings.show_marquee
  assign hero_image = section.settings.hero_image
  assign hero_side = section.settings.hero_side
  assign hero_aspect = section.settings.hero_aspect
  assign hero_radius = section.settings.hero_radius
  assign hero_ratio = section.settings.hero_ratio
  assign echo_text = section.settings.echo_text
  comment
    The hero used to appear only when an image was set, which meant a fresh
    install (no demo imagery) silently lost the 2-column spread. The toggle
    keeps "no hero" reachable while letting a blank image render a placeholder.
  endcomment
  assign has_hero = false
  if section.settings.show_hero
    assign has_hero = true
  endif

  comment
    Pre-compute the total number of statement lines so the outer line-loop
    knows when to stop. Line N is the chunk of blocks between (N-1)-th and
    N-th 'break' block. Sticker blocks are excluded from line flow.
  endcomment
  assign line_count = 1
  for block in section.blocks
    if block.type == 'break'
      assign line_count = line_count | plus: 1
    endif
  endfor
-%}

<section
  id="{{ section_id }}"
  class="skinova-stmt"
  data-skinova-stmt
  data-anim-mask="{{ anim_mask }}"
  data-anim-parallax="{{ anim_parallax }}"
  data-anim-tilt="{{ anim_tilt }}"
  data-anim-spotlight="{{ anim_spotlight }}"
  data-has-hero="{{ has_hero }}"
  data-hero-side="{{ hero_side }}"
  style="
    --stmt-bg: {{ section.settings.bg_color }};
    --stmt-bg-grad: {{ section.settings.bg_gradient }};
    --stmt-ink: {{ section.settings.text_color }};
    --stmt-accent: {{ section.settings.accent_color }};
    --stmt-size-d: {{ section.settings.font_size_d }}px;
    --stmt-size-t: {{ section.settings.font_size_t }}px;
    --stmt-size-m: {{ section.settings.font_size_m }}px;
    --stmt-weight: {{ section.settings.font_weight }};
    --stmt-leading: {{ section.settings.line_height }};
    --stmt-tracking: {{ section.settings.letter_spacing }}px;
    --stmt-gap: {{ section.settings.item_gap }}px;
    --stmt-line-gap: {{ section.settings.line_gap }}px;
    --stmt-maxw: {{ section.settings.max_width }}px;
    --stmt-pad-t: {{ section.settings.padding_top }}px;
    --stmt-pad-b: {{ section.settings.padding_bottom }}px;
    --stmt-pad-x: {{ section.settings.side_padding }}px;
    --stmt-hero-ratio: {{ hero_ratio }};
    --stmt-hero-radius: {{ hero_radius }}px;
  "
>
  {%- if anim_spotlight -%}
    <span class="skinova-stmt__spotlight" aria-hidden="true"></span>
  {%- endif -%}

  {%- if echo_text != blank -%}
    <span
      class="skinova-stmt__echo"
      data-stmt-echo
      data-pos="{{ section.settings.echo_pos }}"
      style="
        color: {{ section.settings.echo_color }};
        --echo-fs: clamp(120px, {{ section.settings.echo_size }}vw, 600px);
        --echo-op: {{ section.settings.echo_opacity | divided_by: 100.0 }};
      "
      aria-hidden="true"
    >{{ echo_text }}</span>
  {%- endif -%}

  <div class="skinova-stmt__spread">
    {%- if has_hero -%}
      <div class="skinova-stmt__hero" data-side="{{ hero_side }}" style="aspect-ratio: {{ hero_aspect | replace: '_', ' / ' }};">
        <div class="skinova-stmt__hero-mask" data-stmt-hero-mask>
          {%- assign hero_w = 1200 -%}
          {%- if hero_image != blank -%}
            {{ hero_image | image_url: width: hero_w | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1440',
                sizes: '(min-width: 900px) 45vw, 100vw',
                alt: hero_image.alt | default: ''
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="skinova-stmt__column">
      {%- for line_i in (1..line_count) -%}
        {%- liquid
          case line_i
            when 1
              assign line_align = section.settings.line_1_align
              assign line_rot = section.settings.line_1_rotate
            when 2
              assign line_align = section.settings.line_2_align
              assign line_rot = section.settings.line_2_rotate
            when 3
              assign line_align = section.settings.line_3_align
              assign line_rot = section.settings.line_3_rotate
            when 4
              assign line_align = section.settings.line_4_align
              assign line_rot = section.settings.line_4_rotate
            else
              assign line_align = 'flex-start'
              assign line_rot = 0
          endcase
        -%}
        <div
          class="skinova-stmt__line"
          data-stmt-line
          data-align="{{ line_align }}"
          style="{% if line_rot != 0 %}--stmt-line-rot:{{ line_rot }}deg;{% endif %}"
        >
          {%- assign cursor = 1 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'break' -%}
              {%- assign cursor = cursor | plus: 1 -%}
            {%- elsif block.type != 'sticker' and cursor == line_i -%}
              {%- case block.type -%}

                {%- when 'text' -%}
                  {%- assign style = block.settings.style -%}
                  {%- assign color = block.settings.color -%}
                  {%- assign offset = block.settings.baseline_offset -%}
                  <span
                    class="skinova-stmt__text"
                    data-stmt-item="text"
                    data-style="{{ style }}"
                    style="{% if color != blank %}color:{{ color }};{% endif %}{% if offset != 0 %}--stmt-offset:{{ offset }}px;{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <span class="skinova-stmt__mask">{{ block.settings.text }}</span>
                  </span>

                {%- when 'image' -%}
                  {%- assign img = block.settings.image -%}
                  {%- assign shape = block.settings.shape -%}
                  {%- assign w = block.settings.width -%}
                  {%- assign h = block.settings.height -%}
                  {%- assign r = block.settings.custom_radius -%}
                  {%- assign rotate = block.settings.rotate -%}
                  {%- assign float = block.settings.float -%}
                  {%- assign ring = block.settings.ring -%}
                  {%- assign img_sizes = w | append: 'px' -%}
                  <span
                    class="skinova-stmt__img"
                    data-stmt-item="image"
                    data-shape="{{ shape }}"
                    data-float="{{ float }}"
                    data-ring="{{ ring }}"
                    style="
                      --bw:{{ w }}px;
                      {% if shape != 'circle' %}--bh:{{ h }}px;{% endif %}
                      {% if shape == 'rounded' %}border-radius:{{ r }}px;{% endif %}
                      {% if block.settings.image_bg != blank %}background:{{ block.settings.image_bg }};{% endif %}
                      {% if rotate != 0 %}--stmt-rot:{{ rotate }}deg;{% endif %}
                      {% if ring %}--stmt-ring:{{ block.settings.ring_color }};{% endif %}
                    "
                    {{ block.shopify_attributes }}
                  >
                    <span class="skinova-stmt__img-mask">
                      {%- if img != blank -%}
                        {{ img | image_url: width: 800 | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 480, 640, 800',
                            sizes: img_sizes,
                            alt: block.settings.alt
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.label != blank -%}
                      <span class="skinova-stmt__img-label">{{ block.settings.label | escape }}</span>
                    {%- endif -%}
                  </span>

                {%- when 'decorator' -%}
                  {%- assign deco = block.settings.icon -%}
                  {%- assign d_size = block.settings.size -%}
                  {%- assign d_rot = block.settings.rotate -%}
                  <span
                    class="skinova-stmt__deco"
                    data-stmt-item="deco"
                    data-icon="{{ deco }}"
                    data-animate="{{ block.settings.animate }}"
                    style="width:{{ d_size }}px;height:{{ d_size }}px;{% if block.settings.color != blank %}color:{{ block.settings.color }};{% endif %}{% if d_rot != 0 %}--stmt-rot:{{ d_rot }}deg;{% endif %}"
                    {{ block.shopify_attributes }}
                    aria-hidden="true"
                  >
                    {%- case deco -%}
                      {%- when 'sparkle' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l1.7 7.2c.2 1 1 1.8 2.1 2.1L23 11l-7.2 1.7c-1 .2-1.8 1-2.1 2.1L12 22l-1.7-7.2c-.2-1-1-1.8-2.1-2.1L1 11l7.2-1.7c1-.2 1.8-1 2.1-2.1L12 0z"/></svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7 7 1-5 5 1.5 7L12 18l-6.5 4L7 15 2 10l7-1z"/></svg>
                      {%- when 'heart' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-7-11a4 4 0 017-2.6A4 4 0 0119 10c0 6.5-7 11-7 11z"/></svg>
                      {%- when 'flower' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="6" r="3"/><circle cx="18" cy="12" r="3"/><circle cx="12" cy="18" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="12" cy="12" r="2.5"/></svg>
                      {%- when 'leaf' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c0-9 7-18 18-18 0 9-9 18-18 18z"/><path d="M3 21l9-9"/></svg>
                      {%- when 'arrow' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      {%- when 'dot' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="5"/></svg>
                    {%- endcase -%}
                  </span>

              {%- endcase -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Stickers are rendered as siblings of the spread, absolute-positioned over the whole composition. {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'sticker' -%}
        <div
          class="skinova-stmt__sticker"
          data-stmt-sticker
          data-shape="{{ block.settings.shape }}"
          style="
            left: {{ block.settings.x_pct }}%;
            top: {{ block.settings.y_pct }}%;
            background: {{ block.settings.bg_color }};
            color: {{ block.settings.text_color }};
            transform: translate(-50%, -50%) rotate({{ block.settings.rotate }}deg);
            --stk-fs: {{ block.settings.font_size }}px;
          "
          {{ block.shopify_attributes }}
        >
          {{ block.settings.text | escape }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if show_marquee and section.settings.marquee_text != blank -%}
    <div class="skinova-stmt__marquee" aria-hidden="true">
      <div
        class="skinova-stmt__marquee-track"
        style="--marq-speed: {{ section.settings.marquee_speed }}s; --marq-color: {{ section.settings.marquee_color }};"
      >
        {%- for i in (1..8) -%}
          <span class="skinova-stmt__marquee-item">
            {{ section.settings.marquee_text | escape }}
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="skinova-stmt__marquee-star"><path d="M12 0l1.7 7.2c.2 1 1 1.8 2.1 2.1L23 11l-7.2 1.7c-1 .2-1.8 1-2.1 2.1L12 22l-1.7-7.2c-.2-1-1-1.8-2.1-2.1L1 11l7.2-1.7c1-.2 1.8-1 2.1-2.1L12 0z"/></svg>
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{%- comment -%}
  Animation controller lives in assets/global.js as Skinova.stmt — auto-binds
  to [data-skinova-stmt] on initAll (DOMContentLoaded + section editor events).
{%- endcomment -%}

{% stylesheet %}
  .skinova-stmt {
    position: relative;
    overflow: hidden;
    background: var(--stmt-bg, #ffffff);
    background-image: var(--stmt-bg-grad, none);
    color: var(--stmt-ink, #111111);
    font-family: var(--g-display-font);
    padding: var(--stmt-pad-t, 96px) var(--stmt-pad-x, 32px) var(--stmt-pad-b, 96px);
    isolation: isolate;
  }
  .skinova-stmt__spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 360px at var(--sx, 50%) var(--sy, 50%),
      color-mix(in srgb, var(--stmt-accent, #f5d8d5) 50%, transparent),
      transparent 70%
    );
    opacity: 0.6;
    z-index: 0;
    transition: opacity 0.4s ease;
  }

  /* ---- BACKGROUND ECHO — huge outlined word ---- */
  .skinova-stmt__echo {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    font-family: var(--g-display-font);
    font-size: var(--echo-fs, clamp(120px, 28vw, 600px));
    opacity: var(--echo-op, 0.1);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    -webkit-text-stroke: 2px currentColor;
    color: transparent;
    transform: translateY(var(--echo-px, 0px));
    will-change: transform;
    transition: transform 0.05s linear;
  }
  .skinova-stmt__echo[data-pos="top-left"]     { top: -8%;  left: -4%;  transform-origin: top left; }
  .skinova-stmt__echo[data-pos="top-right"]    { top: -8%;  right: -4%; transform-origin: top right; }
  .skinova-stmt__echo[data-pos="bottom-left"]  { bottom: -8%; left: -4%; transform-origin: bottom left; }
  .skinova-stmt__echo[data-pos="bottom-right"] { bottom: -8%; right: -4%; transform-origin: bottom right; }
  .skinova-stmt__echo[data-pos="center"] {
    top: 50%; left: 50%;
    transform: translate(-50%, calc(-50% + var(--echo-px, 0px)));
  }

  /* ---- SPREAD: 2-col when hero exists, 1-col otherwise ---- */
  .skinova-stmt__spread {
    position: relative;
    z-index: 1;
    max-width: var(--stmt-maxw, 1280px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  .skinova-stmt[data-has-hero="true"] .skinova-stmt__spread {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
  .skinova-stmt[data-has-hero="true"][data-hero-side="right"] .skinova-stmt__spread {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }
  .skinova-stmt[data-has-hero="true"][data-hero-side="right"] .skinova-stmt__hero {
    order: 2;
  }

  /* ---- HERO IMAGE ---- */
  .skinova-stmt__hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--stmt-hero-radius, 24px);
    background: color-mix(in srgb, var(--stmt-accent, #f5d8d5) 30%, transparent);
    width: 100%;
  }
  .skinova-stmt__hero-mask {
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .skinova-stmt__hero-mask.is-visible {
    clip-path: inset(0 0 0 0);
  }
  .skinova-stmt__hero-mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.05);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .skinova-stmt__hero-mask.is-visible img {
    transform: scale(1);
  }

  /* ---- COLUMN: stack of lines, each with its own alignment ---- */
  .skinova-stmt__column {
    display: flex;
    flex-direction: column;
    gap: var(--stmt-line-gap, 8px);
    min-width: 0;
  }
  .skinova-stmt__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--stmt-gap, 16px);
    font-size: var(--stmt-size-d, 72px);
    font-weight: var(--stmt-weight, 600);
    line-height: var(--stmt-leading, 1.15);
    letter-spacing: var(--stmt-tracking, -1px);
    transform: rotate(var(--stmt-line-rot, 0deg));
    transform-origin: center;
  }
  .skinova-stmt__line[data-align="flex-start"] { justify-content: flex-start; }
  .skinova-stmt__line[data-align="center"]     { justify-content: center; }
  .skinova-stmt__line[data-align="flex-end"]   { justify-content: flex-end; }

  /* TEXT items — mask reveal */
  .skinova-stmt__text {
    display: inline-flex;
    align-items: center;
    transform: translateY(var(--stmt-offset, 0));
    overflow: hidden;
    line-height: 1.05;
  }
  .skinova-stmt__mask {
    display: inline-block;
    transform: translateY(110%);
    transition:
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease;
    opacity: 0;
    will-change: transform, opacity;
  }
  .skinova-stmt__line.is-visible .skinova-stmt__mask {
    transform: translateY(0);
    opacity: 1;
  }
  .skinova-stmt__line.is-visible .skinova-stmt__text:nth-child(1) .skinova-stmt__mask  { transition-delay: 0.00s; }
  .skinova-stmt__line.is-visible .skinova-stmt__text:nth-child(2) .skinova-stmt__mask  { transition-delay: 0.05s; }
  .skinova-stmt__line.is-visible .skinova-stmt__text:nth-child(3) .skinova-stmt__mask  { transition-delay: 0.10s; }
  .skinova-stmt__line.is-visible .skinova-stmt__text:nth-child(4) .skinova-stmt__mask  { transition-delay: 0.15s; }
  .skinova-stmt__line.is-visible .skinova-stmt__text:nth-child(5) .skinova-stmt__mask  { transition-delay: 0.20s; }
  .skinova-stmt__text[data-style="italic"] { font-style: italic; }
  .skinova-stmt__text[data-style="underline"] .skinova-stmt__mask {
    background-image: linear-gradient(var(--stmt-accent, #f5d8d5), var(--stmt-accent, #f5d8d5));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 0% 12%;
    transition:
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease,
      background-size 0.9s ease 0.6s;
  }
  .skinova-stmt__line.is-visible .skinova-stmt__text[data-style="underline"] .skinova-stmt__mask {
    background-size: 100% 12%;
  }
  .skinova-stmt__text[data-style="accent"] .skinova-stmt__mask {
    color: var(--stmt-accent, #c75c5c);
    font-style: italic;
  }

  /* IMAGE items */
  .skinova-stmt__img {
    position: relative;
    display: inline-block;
    overflow: hidden;
    flex-shrink: 0;
    width: var(--bw, 160px);
    height: var(--bh, 80px);
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translateY(var(--stmt-px, 0px))
      rotate(var(--stmt-rot, 0deg))
      perspective(800px)
      rotateX(var(--stmt-tilt-x, 0deg))
      rotateY(var(--stmt-tilt-y, 0deg))
      scale(0.94);
    opacity: 0;
    transition:
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.7s ease;
  }
  .skinova-stmt__img[data-shape="circle"] {
    height: var(--bw, 160px);
  }
  .skinova-stmt__line.is-visible .skinova-stmt__img {
    opacity: 1;
    transform:
      translateY(var(--stmt-px, 0px))
      rotate(var(--stmt-rot, 0deg))
      perspective(800px)
      rotateX(var(--stmt-tilt-x, 0deg))
      rotateY(var(--stmt-tilt-y, 0deg))
      scale(1);
  }
  .skinova-stmt__img[data-shape="pill"]      { border-radius: 999px; }
  .skinova-stmt__img[data-shape="circle"]    { border-radius: 50%; aspect-ratio: 1 / 1; }
  .skinova-stmt__img[data-shape="rectangle"] { border-radius: 0; }
  .skinova-stmt__img[data-shape="blob"] {
    border-radius: 62% 38% 55% 45% / 50% 60% 40% 50%;
    animation: skinova-stmt-blob 10s ease-in-out infinite;
  }
  @keyframes skinova-stmt-blob {
    0%, 100% { border-radius: 62% 38% 55% 45% / 50% 60% 40% 50%; }
    50%      { border-radius: 38% 62% 45% 55% / 60% 50% 50% 40%; }
  }
  .skinova-stmt__img[data-ring="true"] {
    box-shadow: 0 0 0 2px var(--stmt-ring, currentColor);
  }
  .skinova-stmt__img-mask {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }
  .skinova-stmt__line.is-visible .skinova-stmt__img-mask {
    clip-path: inset(0 0 0 0);
  }
  .skinova-stmt__img-mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .skinova-stmt__img:hover .skinova-stmt__img-mask img { transform: scale(1.05); }
  .skinova-stmt__img[data-float="true"] {
    animation: skinova-stmt-float 5s ease-in-out infinite;
  }
  @keyframes skinova-stmt-float {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -6px; }
  }
  .skinova-stmt__img-label {
    position: absolute;
    inset: auto 0 0 0;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    font-family: var(--g-body-font);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 10px;
    text-align: center;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .skinova-stmt__img:hover .skinova-stmt__img-label {
    transform: translateY(0);
  }

  /* DECORATOR items */
  .skinova-stmt__deco {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--stmt-accent, #c75c5c);
    flex-shrink: 0;
    transform: scale(0) rotate(var(--stmt-rot, 0deg));
    opacity: 0;
    transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s ease;
  }
  .skinova-stmt__line.is-visible .skinova-stmt__deco {
    transform: scale(1) rotate(var(--stmt-rot, 0deg));
    opacity: 1;
  }
  .skinova-stmt__deco[data-animate="true"] {
    animation: skinova-stmt-spin 6s linear infinite;
  }
  @keyframes skinova-stmt-spin {
    from { rotate: 0deg; }
    to   { rotate: 360deg; }
  }
  .skinova-stmt__deco svg { width: 100%; height: 100%; display: block; }

  /* STICKER overlays — float over the spread */
  .skinova-stmt__sticker {
    position: absolute;
    z-index: 3;
    padding: 10px 16px;
    font-family: var(--g-body-font);
    font-size: var(--stk-fs, 12px);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }
  .skinova-stmt__sticker[data-shape="pill"]   { border-radius: 999px; }
  .skinova-stmt__sticker[data-shape="rounded"]{ border-radius: 8px; }
  .skinova-stmt__sticker[data-shape="circle"] {
    border-radius: 50%;
    width: 96px; height: 96px;
    display: inline-flex;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 8px;
    line-height: 1.1;
    white-space: normal;
  }
  .skinova-stmt__sticker[data-shape="star"] {
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    width: 120px; height: 120px;
    display: inline-flex;
    align-items: center; justify-content: center;
    padding: 24px;
    text-align: center;
    white-space: normal;
    line-height: 1;
  }

  /* MARQUEE */
  .skinova-stmt__marquee {
    position: relative;
    z-index: 1;
    margin-top: 56px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .skinova-stmt__marquee-track {
    display: flex;
    gap: 32px;
    width: max-content;
    color: var(--marq-color, var(--stmt-ink, #111));
    animation: skinova-stmt-marquee var(--marq-speed, 22s) linear infinite;
  }
  .skinova-stmt__marquee:hover .skinova-stmt__marquee-track {
    animation-play-state: paused;
  }
  .skinova-stmt__marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .skinova-stmt__marquee-star { width: 18px; height: 18px; opacity: 0.7; }
  @keyframes skinova-stmt-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Responsive */
  @media (max-width: 1079px) {
    .skinova-stmt__line { font-size: var(--stmt-size-t, 48px); }
  }
  @media (max-width: 899px) {
    .skinova-stmt[data-has-hero="true"] .skinova-stmt__spread {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .skinova-stmt[data-has-hero="true"][data-hero-side="right"] .skinova-stmt__hero {
      order: 0;
    }
  }
  @media (max-width: 749px) {
    .skinova-stmt {
      padding: calc(var(--stmt-pad-t, 96px) * 0.5) 16px calc(var(--stmt-pad-b, 96px) * 0.5);
    }
    /* Mobile composition strategy: embrace the wrap. Each item lands on
       its own visual row, centered, with a tight vertical rhythm so the
       statement reads as one composed paragraph rather than scattered
       fragments. */
    .skinova-stmt__column { gap: 2px; }
    .skinova-stmt__line {
      font-size: clamp(20px, 6.4vw, 30px);
      gap: 6px;
      transform: none;
      justify-content: center;
      line-height: 1.1;
    }
    /* Each image: own row, small square (1:1 so portraits show face fully,
       not just a cheek). flex: 1 0 100% forces a row break; max-width
       constrains the actual visible image; margin: 0 auto centers it. */
    .skinova-stmt__img {
      flex: 1 0 100%;
      --bw: clamp(56px, 18vw, 80px);
      --bh: clamp(56px, 18vw, 80px);
      max-width: clamp(56px, 18vw, 80px);
      margin: 6px auto;
      aspect-ratio: 1 / 1;
      border-radius: 16px;
    }
    .skinova-stmt__img[data-shape="circle"],
    .skinova-stmt__img[data-shape="blob"] {
      border-radius: 50%;
    }
    .skinova-stmt__img[data-shape="pill"] {
      /* Pill stays slightly wider/shorter but still square-ish so face isn't cropped */
      max-width: clamp(72px, 24vw, 110px);
      --bw: clamp(72px, 24vw, 110px);
      --bh: clamp(56px, 18vw, 80px);
      aspect-ratio: 4 / 3;
      border-radius: 999px;
    }
    .skinova-stmt__img[data-shape="rectangle"] { border-radius: 0; }
    .skinova-stmt__text { transform: none; }
    /* Echo word: full-width centered on mobile so it doesn't get clipped
       at the section edge. Original corner position from the editor is
       collapsed to top/bottom center. */
    .skinova-stmt__echo {
      --echo-fs: clamp(70px, 20vw, 160px);
      --echo-op: 0.05;
      left: 0;
      right: 0;
      width: 100%;
      text-align: center;
      transform-origin: center;
    }
    .skinova-stmt__echo[data-pos="top-left"],
    .skinova-stmt__echo[data-pos="top-right"]    { top: 4%; bottom: auto; }
    .skinova-stmt__echo[data-pos="bottom-left"],
    .skinova-stmt__echo[data-pos="bottom-right"] { bottom: 4%; top: auto; }
    .skinova-stmt__echo[data-pos="center"] {
      top: 50%;
      bottom: auto;
      transform: translateY(calc(-50% + var(--echo-px, 0px)));
    }
    .skinova-stmt__marquee { margin-top: 24px; }
    .skinova-stmt__marquee-item { font-size: 15px; gap: 16px; }
  }
  /* Phones — drop stickers; they always collide with the inline composition
     and the user can't reposition them at viewport widths */
  @media (max-width: 599px) {
    .skinova-stmt__sticker { display: none; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .skinova-stmt__mask,
    .skinova-stmt__img,
    .skinova-stmt__img-mask,
    .skinova-stmt__hero-mask,
    .skinova-stmt__hero-mask img,
    .skinova-stmt__deco,
    .skinova-stmt__echo {
      transform: none;
      opacity: 1;
      clip-path: none;
      transition: none;
      animation: none;
    }
    .skinova-stmt__hero-mask img { transform: none; }
    .skinova-stmt__marquee-track,
    .skinova-stmt__img[data-float="true"],
    .skinova-stmt__img[data-shape="blob"],
    .skinova-stmt__deco[data-animate="true"] { animation: none; }
  }
{% endstylesheet %}

