{%- comment -%}
  Skinova — Social feed.

  Auto-advancing horizontal carousel of vertical (9:16) videos in a
  TikTok / Reels feel. The active CENTER slide is rendered inside a phone
  frame (notch + bezel + scale-up); side slides sit slightly smaller with
  rounded corners. Tap the play overlay to play the video inline.

  Features:
    • Infinite loop with smooth wrap (clone-free, transform-based)
    • Auto-slide with configurable interval, pauses on hover & swipe
    • Dots + prev/next nav, keyboard arrows, touch swipe
    • IntersectionObserver-gated (auto-slide only while in viewport)
    • Per-slide: Shopify video upload OR external URL, poster image,
      optional link + badge label
    • Respects prefers-reduced-motion (no autoplay, no transform anim)
{%- endcomment -%}

{%- liquid
  assign section_id = 'social-' | append: section.id
  assign title = section.settings.title
  assign autoplay = section.settings.autoplay
  assign autoplay_ms = section.settings.autoplay_interval | times: 1000
  assign pause_hover = section.settings.pause_on_hover
  assign show_dots = section.settings.show_dots
  assign show_nav = section.settings.show_nav
  assign frame_color = section.settings.frame_color
  assign slides_d = section.settings.slides_desktop
  assign slides_t = section.settings.slides_tablet
  assign slides_m = section.settings.slides_mobile
-%}

<section
  id="{{ section_id }}"
  class="skinova-social"
  data-skinova-social
  data-autoplay="{{ autoplay }}"
  data-autoplay-ms="{{ autoplay_ms }}"
  data-pause-hover="{{ pause_hover }}"
  style="
    --soc-bg: {{ section.settings.bg_color }};
    --soc-ink: {{ section.settings.text_color }};
    --soc-frame: {{ frame_color }};
    --soc-accent: {{ section.settings.accent_color }};
    --soc-slides-d: {{ slides_d }};
    --soc-slides-t: {{ slides_t }};
    --soc-slides-m: {{ slides_m }};
    --soc-gap: {{ section.settings.slide_gap }}px;
    --soc-radius: {{ section.settings.slide_radius }}px;
    --soc-radius-center: {{ section.settings.center_radius }}px;
    --soc-center-scale: {{ section.settings.center_scale }};
    --soc-maxw: {{ section.settings.max_width }}px;
    --soc-pad-t: {{ section.settings.padding_top }}px;
    --soc-pad-b: {{ section.settings.padding_bottom }}px;
    --soc-pad-x: {{ section.settings.side_padding }}px;
  "
>
  <div class="skinova-social__inner">
    {%- if title != blank -%}
      <header class="skinova-social__head" style="text-align: {{ section.settings.title_align }};">
        <h2
          class="skinova-social__title"
          style="
            font-size: clamp(22px, {{ section.settings.title_size }}px, {{ section.settings.title_size }}px);
            color: {{ section.settings.title_color }};
            font-weight: {{ section.settings.title_weight }};
          "
        >{{ title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="skinova-social__sub">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="skinova-social__carousel" data-soc-carousel>
        {%- if show_nav -%}
          <button type="button" class="skinova-social__nav skinova-social__nav--prev" data-soc-prev aria-label="Previous">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

        <div class="skinova-social__viewport" data-soc-viewport>
          <div class="skinova-social__track" data-soc-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign vid = block.settings.video
                assign vid_url = block.settings.video_url
                assign poster = block.settings.poster
                assign link = block.settings.link
                assign badge = block.settings.badge
                assign alt = block.settings.alt | default: title | default: 'Video'

                comment
                  Effective poster URL: custom upload → Shopify video preview
                  image → empty. Used for the <video poster> attribute so the
                  video frame isn't black before the user taps play.
                endcomment
                assign poster_url = ''
                if poster != blank
                  assign poster_url = poster | image_url: width: 480
                elsif vid != blank and vid.preview_image
                  assign poster_url = vid.preview_image | image_url: width: 480
                endif
              -%}
              <article
                class="skinova-social__slide"
                data-soc-slide
                {{ block.shopify_attributes }}
              >
                <div class="skinova-social__phone">
                  <span class="skinova-social__notch" aria-hidden="true"></span>
                  <span class="skinova-social__speaker" aria-hidden="true"></span>

                  <div class="skinova-social__media">
                    {%- if poster != blank -%}
                      {{ poster | image_url: width: 600 | image_tag:
                          loading: 'lazy',
                          widths: '240, 360, 480, 600, 720',
                          sizes: '(min-width: 1080px) 22vw, (min-width: 720px) 32vw, 70vw',
                          alt: alt,
                          class: 'skinova-social__poster'
                      }}
                    {%- elsif vid.preview_image -%}
                      {{ vid.preview_image | image_url: width: 600 | image_tag:
                          loading: 'lazy',
                          widths: '240, 360, 480, 600, 720',
                          sizes: '(min-width: 1080px) 22vw, (min-width: 720px) 32vw, 70vw',
                          alt: alt,
                          class: 'skinova-social__poster'
                      }}
                    {%- else -%}
                      <div class="skinova-social__poster skinova-social__poster--fallback" aria-hidden="true">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="6" y="10" width="36" height="28" rx="3"/>
                          <path d="M21 19l8 5-8 5z" fill="currentColor"/>
                        </svg>
                      </div>
                    {%- endif -%}

                    {%- if vid != blank -%}
                      <video
                        class="skinova-social__video"
                        data-soc-video
                        preload="none"
                        muted
                        playsinline
                        loop
                        {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                      >
                        {%- for source in vid.sources -%}
                          {%- # theme-check-disable RemoteAsset -%}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                          {%- # theme-check-enable RemoteAsset -%}
                        {%- endfor -%}
                      </video>
                    {%- elsif vid_url != blank -%}
                      <video
                        class="skinova-social__video"
                        data-soc-video
                        preload="none"
                        muted
                        playsinline
                        loop
                        src="{{ vid_url }}"
                        {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                      ></video>
                    {%- endif -%}

                    {%- if vid != blank or vid_url != blank -%}
                      <button
                        type="button"
                        class="skinova-social__play"
                        data-soc-play
                        aria-label="Play video"
                      >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </button>
                    {%- endif -%}

                    {%- if badge != blank -%}
                      <span class="skinova-social__badge">{{ badge | escape }}</span>
                    {%- endif -%}

                    {%- if link != blank -%}
                      <a
                        href="{{ link }}"
                        class="skinova-social__link"
                        aria-label="{{ alt }}"
                      ></a>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>

        {%- if show_nav -%}
          <button type="button" class="skinova-social__nav skinova-social__nav--next" data-soc-next aria-label="Next">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if show_dots -%}
        <div class="skinova-social__dots" data-soc-dots role="tablist" aria-label="Slide selector">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="skinova-social__dot{% if forloop.first %} is-active{% endif %}"
              data-soc-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  Carousel controller lives in assets/global.js as Skinova.socialFeed — auto-binds
  to [data-skinova-social] on initAll (DOMContentLoaded + section editor events).
{%- endcomment -%}

{% stylesheet %}
  .skinova-social {
    background: var(--soc-bg, #fbe9e8);
    color: var(--soc-ink, #1a1a1a);
    padding: var(--soc-pad-t, 80px) var(--soc-pad-x, 24px) var(--soc-pad-b, 80px);
    font-family: var(--g-body-font);
    overflow: hidden;
    position: relative;
  }
  .skinova-social__inner {
    max-width: var(--soc-maxw, 1280px);
    margin: 0 auto;
  }
  .skinova-social__head {
    margin: 0 0 32px;
  }
  .skinova-social__title {
    font-family: var(--g-display-font);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .skinova-social__sub {
    margin: 10px 0 0;
    color: color-mix(in srgb, var(--soc-ink, #1a1a1a) 60%, transparent);
    font-size: 15px;
    line-height: 1.5;
  }

  /* ---- Carousel ---- */
  .skinova-social__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .skinova-social__viewport {
    overflow: hidden;
    flex: 1 1 auto;
    min-width: 0;
    /* a touch of padding so the scaled-up center slide doesn't clip */
    padding: 24px 0;
  }
  .skinova-social__track {
    display: flex;
    gap: var(--soc-gap, 16px);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    touch-action: pan-y;
    user-select: none;
  }
  .skinova-social__slide {
    flex: 0 0 auto;
    width: calc((100% - (var(--soc-slides-d, 5) - 1) * var(--soc-gap, 16px)) / var(--soc-slides-d, 5));
    cursor: pointer;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---- Phone shell ---- */
  .skinova-social__phone {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--soc-radius, 18px);
    background: var(--soc-frame, #1a1a1a);
    overflow: hidden;
    transform: scale(0.9);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                border-radius 0.4s ease,
                box-shadow 0.4s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }
  .skinova-social__slide.is-center .skinova-social__phone {
    transform: scale(var(--soc-center-scale, 1.12));
    border-radius: var(--soc-radius-center, 28px);
    padding: 6px;
    box-shadow:
      0 0 0 2px var(--soc-frame, #1a1a1a),
      0 14px 40px rgba(0, 0, 0, 0.18);
  }
  /* Notch + speaker only show on the active center slide */
  .skinova-social__notch,
  .skinova-social__speaker {
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .skinova-social__slide.is-center .skinova-social__notch,
  .skinova-social__slide.is-center .skinova-social__speaker {
    opacity: 1;
  }
  .skinova-social__notch {
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 36%;
    height: 22px;
    background: var(--soc-frame, #1a1a1a);
    border-radius: 0 0 14px 14px;
    z-index: 3;
  }
  .skinova-social__speaker {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 4px;
    background: #555;
    border-radius: 99px;
    z-index: 4;
  }

  /* ---- Media (inside phone) ---- */
  .skinova-social__media {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
    background: #000;
  }
  .skinova-social__slide.is-center .skinova-social__media {
    border-radius: calc(var(--soc-radius-center, 28px) - 6px);
  }
  .skinova-social__poster,
  .skinova-social__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .skinova-social__poster--fallback {
    background: linear-gradient(135deg, #f5d8d5, #e8a5a0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.85);
  }
  .skinova-social__poster--fallback svg {
    width: 48px;
    height: 48px;
    opacity: 0.85;
  }
  .skinova-social__video { opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
  .skinova-social__slide.is-playing .skinova-social__video {
    opacity: 1;
    pointer-events: auto;
  }
  .skinova-social__slide.is-playing .skinova-social__poster,
  .skinova-social__slide.is-playing .skinova-social__play {
    opacity: 0;
    pointer-events: none;
  }
  .skinova-social__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.3s ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .skinova-social__play:hover {
    background: var(--soc-accent, #e8a5a0);
    transform: scale(1.08);
  }
  .skinova-social__play svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }
  .skinova-social__slide.is-center .skinova-social__play {
    width: 64px;
    height: 64px;
  }
  .skinova-social__slide.is-center .skinova-social__play svg {
    width: 26px;
    height: 26px;
  }
  .skinova-social__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 99px;
    z-index: 4;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .skinova-social__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    text-indent: -9999px;
    overflow: hidden;
  }

  /* ---- Nav arrows ---- */
  .skinova-social__nav {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--soc-ink, #1a1a1a) 15%, transparent);
    background: #ffffff;
    color: var(--soc-ink, #1a1a1a);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    z-index: 6;
  }
  .skinova-social__nav:hover {
    background: var(--soc-ink, #1a1a1a);
    color: #ffffff;
    border-color: var(--soc-ink, #1a1a1a);
    transform: scale(1.05);
  }

  /* ---- Dots ---- */
  .skinova-social__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }
  .skinova-social__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: color-mix(in srgb, var(--soc-ink, #1a1a1a) 20%, transparent);
    cursor: pointer;
    transition: background 0.2s ease, width 0.25s ease;
  }
  .skinova-social__dot:hover {
    background: color-mix(in srgb, var(--soc-ink, #1a1a1a) 40%, transparent);
  }
  .skinova-social__dot.is-active {
    background: var(--soc-ink, #1a1a1a);
    width: 22px;
    border-radius: 99px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 1079px) {
    .skinova-social__slide {
      width: calc((100% - (var(--soc-slides-t, 3) - 1) * var(--soc-gap, 16px)) / var(--soc-slides-t, 3));
    }
  }
  @media (max-width: 749px) {
    .skinova-social {
      padding: calc(var(--soc-pad-t, 80px) * 0.55) 16px calc(var(--soc-pad-b, 80px) * 0.55);
    }
    /* Force a peek of adjacent slides even if the merchant set slides_mobile=1,
       so the viewer sees it's a carousel without scrolling. */
    .skinova-social__slide {
      width: calc((100% - (var(--soc-slides-m-effective, 1.3) - 1) * var(--soc-gap, 16px)) / var(--soc-slides-m-effective, 1.3));
      --soc-slides-m-effective: max(var(--soc-slides-m, 1.4), 1.2);
    }
    /* CRITICAL: keep 9:16 ratio but cap by SHRINKING WIDTH so a 1-slide-
       visible × full-viewport doesn't create a 178vw-tall slide. The
       max-width is what 65vh of height looks like at 9:16. The phone
       then centers itself within the (possibly wider) slide container. */
    .skinova-social__phone {
      max-width: calc(65vh * 9 / 16);
      margin: 0 auto;
    }
    /* Reduce center scale so the bigger active slide still fits */
    .skinova-social__slide.is-center .skinova-social__phone {
      transform: scale(1.04);
      padding: 4px;
      border-radius: 22px;
    }
    .skinova-social__slide.is-center .skinova-social__media {
      border-radius: 18px;
    }
    /* Scale notch + speaker down proportionally */
    .skinova-social__notch  { width: 32%; height: 16px; border-radius: 0 0 10px 10px; top: 4px; }
    .skinova-social__speaker{ top: 10px; width: 22px; height: 3px; }
    .skinova-social__nav { display: none; }
    .skinova-social__viewport { padding: 10px 0; }
    .skinova-social__play { width: 48px; height: 48px; }
    .skinova-social__slide.is-center .skinova-social__play { width: 54px; height: 54px; }
    .skinova-social__head { margin-bottom: 24px; }
    .skinova-social__badge { font-size: 9px; padding: 3px 7px; top: 10px; right: 10px; }
  }
  /* Very narrow phones — slightly more peek + tighter cap */
  @media (max-width: 479px) {
    .skinova-social__slide {
      --soc-slides-m-effective: max(var(--soc-slides-m, 1.4), 1.25);
    }
    .skinova-social__phone {
      max-width: calc(58vh * 9 / 16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skinova-social__track,
    .skinova-social__slide,
    .skinova-social__phone,
    .skinova-social__notch,
    .skinova-social__speaker,
    .skinova-social__play {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social feed",
  "class": "section-social-feed",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Over 6K 5★ Product Reviews"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 18, "max": 56, "step": 1, "unit": "px",
      "label": "Title size",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_weight",
      "min": 300, "max": 900, "step": 100,
      "label": "Title weight",
      "default": 600
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show prev/next arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2, "max": 12, "step": 1, "unit": "s",
      "label": "Auto-slide interval",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Slide sizing"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 3, "max": 7, "step": 1,
      "label": "Slides visible (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 2, "max": 5, "step": 1,
      "label": "Slides visible (tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1, "max": 3, "step": 1,
      "label": "Slides visible (mobile)",
      "default": 1
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 4, "max": 40, "step": 2, "unit": "px",
      "label": "Gap between slides",
      "default": 16
    },
    {
      "type": "range",
      "id": "slide_radius",
      "min": 0, "max": 40, "step": 2, "unit": "px",
      "label": "Side slide corner radius",
      "default": 18
    },
    {
      "type": "range",
      "id": "center_radius",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "label": "Center slide corner radius",
      "default": 32
    },
    {
      "type": "range",
      "id": "center_scale",
      "min": 1.0, "max": 1.4, "step": 0.1,
      "label": "Center slide scale-up",
      "default": 1.1
    },
    {
      "type": "range",
      "id": "max_width",
