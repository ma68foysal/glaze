{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
-%}
<section class="k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}">
  <div class="k-wrap k-chero">
    <div>
      {%- if section.settings.label != blank -%}<p class="k-label k-muted k-chero__label">{{ section.settings.label }}</p>{%- endif -%}
      <h1 class="k-chero__title">{{ heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="k-rte k-chero__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="k-chero__image k-media">
      {%- render 'k-media', image: section.settings.image, sizes: '(min-width: 900px) 42vw, 100vw', placeholder: 'lifestyle-2', eager: true -%}
      {%- if section.settings.status != blank -%}
        <span class="k-chero__status"><i aria-hidden="true"></i>{{ section.settings.status }}</span>
      {%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="k-wrap k-chero__ways">
      <ul class="k-ways" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <li class="k-reveal" {{ block.shopify_attributes }}>
            <{{ tag }} class="k-ways__card"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %}>
              <span class="k-ways__icon">{% render 'k-icon', icon: block.settings.icon, size: 22 %}</span>
              {%- if block.settings.label != blank -%}<span class="k-label">{{ block.settings.label }}</span>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h2 class="k-ways__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.value != blank -%}<span class="k-ways__value">{{ block.settings.value }}</span>{%- endif -%}
              {%- if block.settings.text != blank -%}<span class="k-ways__text">{{ block.settings.text }}</span>{%- endif -%}
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .k-chero { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; align-items: end; }
  .k-chero__label { margin: 0 0 24px; }
  .k-chero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(72px, 11vw, 176px) * var(--heading-scale));
    letter-spacing: -0.045em;
    line-height: 0.82;
    overflow-wrap: anywhere;
  }
  .k-chero__title em { display: block; font-family: var(--font-accent); font-style: var(--font-accent-style); font-weight: 400; letter-spacing: -0.02em; }
  .k-chero__text { margin-top: 28px; max-width: 520px; font-size: 19px; line-height: 1.5; }
  .k-chero__image { aspect-ratio: 4 / 3.2; border-radius: var(--radius-card); }
  .k-chero__status {
    position: absolute; left: 16px; bottom: 16px; z-index: 1;
    display: flex; align-items: center; gap: 10px; padding: 10px 16px;
    border-radius: 999px; background: var(--color-bg); color: var(--color-text); font-size: 14px; font-weight: 600;
  }
  .k-chero__status i { width: 8px; height: 8px; border-radius: 999px; background: var(--color-accent); }
  @media (max-width: 900px) { .k-chero { grid-template-columns: 1fr; } }
  /* Ways to reach us: cards under the hero */
  .k-chero__ways { margin-top: clamp(32px, 4vw, 56px); }
  .k-ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .k-ways > li { display: flex; }
  .k-ways__card {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; gap: 14px; width: 100%; padding: 28px;
    border-radius: calc(var(--radius-card) * 0.85); background: var(--color-surface); color: var(--color-text);
    transition: color 0.45s;
  }
  a.k-ways__card::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: var(--color-accent); transform: translateY(101%);
    transition: transform 0.55s var(--ease-in-out);
  }
  a.k-ways__card:hover { color: var(--color-bg); }
  a.k-ways__card:hover::before { transform: none; }
  .k-ways__icon { display: grid; place-items: center; width: 52px; height: 52px; border: 1.5px solid currentColor; border-radius: 999px; }
  .k-ways__heading { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.02em; }
  .k-ways__value { font-size: 18px; font-weight: 600; overflow-wrap: anywhere; }
  .k-ways__text { font-size: 15px; opacity: 0.8; }
  @media (max-width: 900px) { .k-ways { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact hero",
  "max_blocks": 3,
  "tag": "div",
  "class": "k-chero-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Customer care · Studio · Press" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Get in <em>touch</em>", "info": "Italic words use the accent font and start a new line. Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, sizing or a repair? Our team answers every message, usually within one working day.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "status", "label": "Status label on image", "default": "Replies within one working day" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Contact method",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "mail", "options": [ { "value": "mail", "label": "Email" }, { "value": "phone", "label": "Phone" }, { "value": "pin", "label": "Location" }, { "value": "arrow-up-right", "label": "Arrow" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer care" },
        { "type": "text", "id": "value", "label": "Detail", "default": "hello@example.com", "info": "An email address, phone number or street address." },
        { "type": "text", "id": "text", "label": "Text", "default": "Replies within one working day" },
        { "type": "url", "id": "link", "label": "Link", "info": "Use mailto: or tel: links. The card isn't clickable without one." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact hero",
      "blocks": [
        { "type": "method", "settings": { "icon": "mail", "label": "Email", "heading": "Customer care", "value": "hello@example.com", "text": "Replies within one working day" } },
        { "type": "method", "settings": { "icon": "phone", "label": "Phone", "heading": "Talk to us", "value": "+1 555 010 0100", "text": "Monday to Friday" } },
        { "type": "method", "settings": { "icon": "pin", "label": "Visit", "heading": "The studio", "value": "12 Example Street, City", "text": "Pickup, fittings and repairs" } }
      ]
    }
  ]
}
{% endschema %}
