{%- liquid
  assign per_page = section.settings.products_per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign editorial = section.blocks | where: 'type', 'editorial' | first
  assign chips = section.blocks | where: 'type', 'collection_link'
  assign form_id = 'k-filters-' | append: section.id
  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
-%}

<section class="k-col k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="k-wrap">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="k-col__crumbs k-label" aria-label="{{ 'products.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'products.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">{{ 'sections.collection.collections' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title }}</span>
      </nav>
    {%- endif -%}

    <header class="k-col__hero">
      <h1 class="k-col__title">
        {{- collection.title -}}&nbsp;<span class="k-col__count" aria-hidden="true">{{ collection.products_count }}</span>
        <span class="visually-hidden">, {{ 'sections.collection.product_count' | t: count: collection.products_count }}</span>
      </h1>
      {%- if collection.description != blank or section.settings.meta != blank or collection.image -%}
        <div class="k-col__intro">
          {%- if collection.image and section.settings.show_image -%}
            <div class="k-col__image k-media">
              {{ collection.image | image_url: width: 800 | image_tag: widths: '320, 480, 640, 800', sizes: '(min-width: 900px) 240px, 50vw', loading: 'eager', alt: collection.image.alt | default: collection.title }}
            </div>
          {%- endif -%}
          {%- if collection.description != blank -%}
            <div class="k-rte k-lead">{{ collection.description }}</div>
          {%- endif -%}
          {%- if section.settings.meta != blank -%}
            <p class="k-label k-muted" style="margin: 0;">{{ section.settings.meta }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    {%- if chips.size > 0 -%}
      <nav class="k-col__subs" aria-label="{{ 'sections.collection.browse' | t }}">
        {%- for block in chips -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            {%- liquid
              assign chip_label = block.settings.label | default: c.title
              assign is_current = false
              if c.handle == collection.handle
                assign is_current = true
              endif
            -%}
            <a class="k-chip" href="{{ c.url }}"{% if is_current %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>
              {{ chip_label }} <span class="k-col__sub-n">{{ c.products_count }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate collection.products by per_page -%}
      <div class="k-col__bar">
        <div class="k-col__bar-l">
          {%- if section.settings.show_filters -%}{%- render 'k-facets', part: 'filters', results: collection, url: collection.url, form_id: form_id, active_count: active_count, clear_url: clear_url -%}{%- endif -%}
        </div>

        <div class="k-col__bar-r">
          <span class="k-label k-muted">{{ 'sections.collection.product_count' | t: count: collection.products_count }}</span>
          {%- if section.settings.show_density -%}
            <div class="k-col__dens" role="group" aria-label="{{ 'sections.collection.density' | t }}">
              <button type="button" data-density="1" aria-label="{{ 'sections.collection.columns' | t: count: 1 }}" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1"/></svg>
              </button>
              <button type="button" data-density="2" aria-label="{{ 'sections.collection.columns' | t: count: 2 }}" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="18" rx="1"/><rect x="13" y="3" width="8" height="18" rx="1"/></svg>
              </button>
              <button type="button" data-density="3" aria-label="{{ 'sections.collection.columns' | t: count: 3 }}" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="3" width="5.5" height="18" rx="1"/><rect x="9.25" y="3" width="5.5" height="18" rx="1"/><rect x="16.5" y="3" width="5.5" height="18" rx="1"/></svg>
              </button>
              <button type="button" data-density="4" aria-label="{{ 'sections.collection.columns' | t: count: 4 }}" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="3" width="4" height="18" rx="1"/><rect x="7.33" y="3" width="4" height="18" rx="1"/><rect x="12.66" y="3" width="4" height="18" rx="1"/><rect x="18" y="3" width="4" height="18" rx="1"/></svg>
              </button>
              <button type="button" data-density="index" aria-label="{{ 'sections.collection.index_view' | t }}" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
              </button>
            </div>
          {%- endif -%}
          {%- if section.settings.show_sort -%}{%- render 'k-facets', part: 'sort', results: collection, url: collection.url, form_id: form_id, sort_by: sort_by -%}{%- endif -%}
        </div>
      </div>

      {%- if collection.products.size > 0 -%}
        <ul class="k-col__grid{% if section.settings.default_layout == 'index' %} is-index{% endif %}" role="list" data-grid data-default="{% if section.settings.default_layout == 'index' %}index{% else %}{{ section.settings.columns }}{% endif %}" style="--cols: {{ section.settings.columns }};">
          {%- for product in collection.products -%}
            {%- comment -%} The first row shows without the scroll reveal, so it never paints half-faded. {%- endcomment -%}
            <li class="k-col__item{% if forloop.index > 4 %} k-reveal{% endif %}">
              {% render 'k-card', product: product, quick_add: section.settings.quick_add, heading_tag: 'h2' %}
              {%- assign row_number = paginate.current_offset | plus: forloop.index -%}
              {%- render 'k-index-row', product: product, number: row_number -%}
            </li>
            {%- if editorial and paginate.current_page == 1 and forloop.index == editorial.settings.position -%}
              <li class="k-col__ed color-{{ editorial.settings.color_scheme }}" {{ editorial.shopify_attributes }}>
                <div class="k-col__ed-media k-media" aria-hidden="true">
                  {%- render 'k-media', image: editorial.settings.image, video: editorial.settings.video, sizes: '(min-width: 900px) 50vw, 100vw', placeholder: 'lifestyle-2', alt: '' -%}
                </div>
                {%- if editorial.settings.label != blank -%}<span class="k-label k-col__ed-label">{{ editorial.settings.label }}</span>{%- endif -%}
                <div class="k-col__ed-copy">
                  {%- if editorial.settings.heading != blank -%}<h2 class="k-h3 k-col__ed-h">{{ editorial.settings.heading }}</h2>{%- endif -%}
                  {%- if editorial.settings.text != blank -%}<p class="k-col__ed-text">{{ editorial.settings.text }}</p>{%- endif -%}
                  {%- if editorial.settings.button_label != blank and editorial.settings.link != blank -%}
                    <a class="k-btn k-btn--primary" href="{{ editorial.settings.link }}">{{ editorial.settings.button_label }}</a>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="k-col__peek k-media" aria-hidden="true" data-peek></div>
      {%- else -%}
        <div class="k-col__empty">
          {%- if active_count > 0 -%}
            <p class="k-h3" style="margin: 0;">{{ 'sections.collection.empty_filtered' | t }}</p>
            <a class="k-btn k-btn--secondary" href="{{ clear_url }}">{{ 'sections.collection.clear_filters' | t }}</a>
          {%- else -%}
            <p class="k-h3" style="margin: 0;">{{ 'sections.collection.empty' | t }}</p>
            <a class="k-btn k-btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.shop_all' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {%- liquid
          assign shown = paginate.current_offset | plus: collection.products.size
          assign progress = shown | times: 1.0 | divided_by: paginate.items
        -%}
        <div class="k-col__more" data-more{% if section.settings.paging == 'infinite' %} data-infinite{% endif %}>
          <p class="k-label" style="margin: 0;" data-more-label>{{ 'sections.collection.showing_count' | t: shown: shown, total: paginate.items }}</p>
          <div class="k-col__prog" aria-hidden="true"><i data-more-bar style="transform: scaleX({{ progress }});"></i></div>
          {%- if paginate.next -%}
            <a class="k-btn k-btn--secondary" href="{{ paginate.next.url }}" data-more-link data-total="{{ paginate.items }}">{{ 'sections.collection.show_more' | t }}</a>
          {%- endif -%}
          {%- if paginate.previous -%}
            <a class="k-label k-col__prev" href="{{ paginate.previous.url }}">{{ 'sections.collection.previous_page' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_filters -%}{%- render 'k-facets', part: 'drawer', results: collection, url: collection.url, form_id: form_id, sort_by: sort_by, active_count: active_count, clear_url: clear_url, scheme: section.settings.drawer_color_scheme -%}{%- endif -%}
    {%- endpaginate -%}

    {%- assign next = section.settings.next_collection -%}
    {%- if next != blank and next.handle != collection.handle -%}
      <a class="k-col__next" href="{{ next.url }}">
        <span>
          <span class="k-label k-col__next-label">{{ 'sections.collection.next_collection' | t }}</span>
          <span class="k-col__next-name">{{ next.title }}</span>
        </span>
        <span class="k-arrow-circle" aria-hidden="true">{% render 'k-icon', icon: 'arrow', size: 22 %}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .k-col { --pt: 0.2; }
  .k-col__crumbs { display: flex; flex-wrap: wrap; gap: 10px; color: var(--color-muted); }
  .k-col__crumbs a:hover { color: var(--color-text); }
  .k-col__hero { display: grid; grid-template-columns: minmax(0, 1fr) min(560px, 42%); gap: 48px; align-items: end; padding: 28px 0 36px; }
  .k-col__hero:not(:has(.k-col__intro)) { grid-template-columns: minmax(0, 1fr); }
  .k-col__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight-black);
    /* Sized so the longest common single words (Accessories, Bestsellers) fit whole at every width;
       longer titles wrap between words. */
    font-size: calc(clamp(40px, 6.6vw, 112px) * var(--heading-scale));
    line-height: 0.86;
    letter-spacing: -0.04em;
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .k-col__count {
    display: inline-grid; place-items: center;
    min-width: 48px; height: 48px; padding: 0 12px;
    margin-left: 12px;
    border: 1.5px solid currentColor; border-radius: 999px;
    font: 600 18px var(--font-body); letter-spacing: 0;
    vertical-align: super;
  }
  .k-col__intro { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: 1fr auto auto; gap: 10px 24px; align-items: end; width: 100%; padding-bottom: 10px; }
  .k-col__intro:has(.k-col__image) { grid-template-columns: 240px minmax(0, 1fr); }
  /* Description and meta sit at the bottom, on the title's baseline, beside the photo. */
  .k-col__intro > .k-rte { grid-row: 2; }
  .k-col__intro > .k-label { grid-row: 3; }
  .k-col__intro > :not(.k-col__image) { grid-column: -2 / -1; }
  .k-col__intro .k-lead { font-size: 16px; }
  .k-col__image { grid-row: 1 / -1; width: 100%; aspect-ratio: 4 / 5; border-radius: calc(var(--radius-card) * 0.25); }
  .k-col__subs { display: flex; flex-wrap: wrap; gap: 6px; padding-bottom: 28px; }
  .k-col__subs .k-chip[aria-current] { background: var(--color-text); color: var(--color-bg); }
  .k-col__sub-n { font-family: var(--font-label); font-size: 11px; opacity: 0.7; }

  .k-col__dens { display: inline-flex; padding: 3px; border: 1.5px solid var(--color-line); border-radius: 999px; }
  .k-col__dens button {
    display: grid; place-items: center;
    width: 40px; height: 36px;
    border: 0; border-radius: 999px;
    background: transparent; color: var(--color-muted);
    cursor: pointer;
  }
  .k-col__dens button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }
  .k-col__dens button[data-density="1"] { display: none; }

  .k-col__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 28px var(--space-md);
    margin: 0; padding: 32px 0 0;
    list-style: none;
  }
  .k-irow { display: none; }
  .k-col__grid.is-index { display: block; padding-top: 20px; }
  .k-col__grid.is-index > .k-col__item { opacity: 1; transform: none; animation: none; }
  .k-col__grid.is-index .k-card, .k-col__grid.is-index > .k-col__ed { display: none; }
  .k-col__grid.is-index .k-irow { display: grid; }
  .k-irow {
    grid-template-columns: 56px minmax(0, 1fr) auto auto; gap: 20px; align-items: baseline;
    padding: 16px 0; border-top: 1px solid var(--color-line); transition: padding 0.35s var(--ease-out), color var(--dur-fast);
  }
  .k-col__item:last-child .k-irow { border-bottom: 1px solid var(--color-line); }
  .k-irow__thumb { display: none; }
  .k-irow__name {
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(28px, 4.4vw, 60px) * var(--heading-scale)); letter-spacing: -0.035em; line-height: 1;
    transform-origin: 0 100%; transition: transform 0.45s var(--ease-out);
  }
  .k-irow__type { white-space: nowrap; }
  .k-irow__price { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .k-irow__price s { margin-right: 6px; font-weight: 400; color: var(--color-muted); }
  .k-irow:hover, .k-irow:focus-visible { padding-left: 14px; }
  .k-irow:hover .k-irow__name, .k-irow:focus-visible .k-irow__name { transform: scaleX(1.06); }
  .k-irow:hover .k-irow__price { color: var(--color-accent); }
  .k-irow.is-soldout .k-irow__name { color: var(--color-muted); }
  .k-col__peek {
    position: fixed; left: 0; top: 0; z-index: 15; width: 200px; aspect-ratio: 4 / 5; border-radius: 12px;
    pointer-events: none; opacity: 0; transform: translate(-50%, -60%) scale(0.85) rotate(-3deg);
    transition: opacity 0.25s, transform 0.35s var(--ease-out);
    box-shadow: 0 30px 50px -30px rgba(14, 14, 14, 0.6);
  }
  .k-col__peek.is-on { opacity: 1; transform: translate(-50%, -60%) scale(1) rotate(-3deg); }
  @media (hover: none), (pointer: coarse) { .k-col__peek { display: none; } }
  .k-col__ed {
    grid-column: span 2;
    position: relative;
    display: flex; flex-direction: column; justify-content: space-between; gap: 24px;
    min-height: 520px; padding: 32px;
    overflow: hidden;
    border-radius: calc(var(--radius-card) * 0.25);
    isolation: isolate;
  }
  .k-col__ed-media { position: absolute; inset: 0; z-index: -1; }
  .k-col__ed-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14, 14, 14, 0.05), rgba(14, 14, 14, 0.5)); }
  .k-col__ed-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .k-col__ed-h { font-size: clamp(40px, 4.6vw, 76px); }
  .k-col__ed-text { margin: 0; max-width: 360px; }
  .k-col__ed:has(.k-col__ed-media img, .k-col__ed-media video) { color: #f2f1ec; }

  .k-col__empty { display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 80px 0; text-align: center; }
  .k-col__more { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 64px 0 0; }
  .k-col__prog { position: relative; width: 220px; height: 2px; overflow: hidden; background: var(--color-line); }
  .k-col__prog i { position: absolute; inset: 0; background: var(--color-text); transform-origin: left; transition: transform var(--dur-slow) var(--ease-out); }
  .k-col__prev { text-decoration: underline; text-underline-offset: 3px; }

  .k-col__next {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24px;
    min-height: 160px; margin-top: 96px; padding: 0 8px;
    overflow: hidden; isolation: isolate;
    border-block: 1px solid var(--color-line);
    transition: color var(--dur);
  }
  .k-col__next::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--color-button); transform: scaleY(0); transform-origin: bottom; transition: transform 0.55s var(--ease-in-out); }
  .k-col__next:hover, .k-col__next:focus-visible { color: var(--color-button-label); }
  .k-col__next:hover::before, .k-col__next:focus-visible::before { transform: scaleY(1); }
  .k-col__next:hover .k-arrow-circle { transform: rotate(-45deg); }
  .k-col__next-label { display: block; margin-bottom: 10px; opacity: 0.7; }
  .k-col__next-name {
    font-family: var(--font-heading); font-weight: var(--font-heading-weight);
    font-size: calc(clamp(48px, 7vw, 112px) * var(--heading-scale));
    line-height: 1; letter-spacing: -0.03em;
  }


  @media (max-width: 900px) {
    .k-col__hero { grid-template-columns: 1fr; gap: 20px; }
    .k-col__intro:has(.k-col__image) { grid-template-columns: 120px minmax(0, 1fr); }
    .k-col__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px var(--space-sm); }
    .k-col__ed { grid-column: 1 / -1; min-height: 420px; padding: 24px; }
    .k-col__dens button[data-density="4"] { display: none; }
    .k-col__dens button[data-density="1"] { display: grid; }
    .k-col__grid[data-cols="1"] { grid-template-columns: minmax(0, 1fr); }
    .k-col__grid[data-cols="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px var(--space-sm); }
  }
  @media (max-width: 600px) {
    .k-col__dens button[data-density="3"] { display: none; }
    .k-col__grid[data-cols="3"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .k-irow { grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 12px 0; }
    .k-irow__num, .k-irow__type { display: none; }
  }
  /* Touch screens can't hover, so each row shows its own thumbnail. */
  @media (max-width: 900px) and (hover: none), (max-width: 900px) and (pointer: coarse) {
    .k-irow { grid-template-columns: 64px minmax(0, 1fr) auto; padding: 10px 0; }
    .k-irow__thumb { display: block; aspect-ratio: 4 / 5; border-radius: 8px; }
    .k-irow:hover, .k-irow:focus-visible { padding-left: 0; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var KEY = 'k-collection-cols';
    function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

    function init(root) {
      (root || document).querySelectorAll('.k-col').forEach(function (sec) {
        if (sec.dataset.kReady) return;
        sec.dataset.kReady = '1';
        var grid = sec.querySelector('[data-grid]');
        var dens = sec.querySelectorAll('[data-density]');
        function applyCols(n) {
          if (!grid || !n) return;
          var phone = window.matchMedia('(max-width: 900px)').matches;
          // One column is a phone layout; on wider screens fall back to the default.
          if (n === '1' && !phone) n = grid.dataset.default || '3';
          var small = window.matchMedia('(max-width: 600px)').matches;
          if (n === '4' && phone) n = '3';
          if (n === '3' && small) n = '2';
          grid.classList.toggle('is-index', n === 'index');
          grid.dataset.cols = n;
          if (n !== 'index') grid.style.setProperty('--cols', n);
          dens.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.density === String(n) ? 'true' : 'false'); });
        }
        if (dens.length) {
          applyCols(get(KEY) || grid.dataset.default || grid.style.getPropertyValue('--cols').trim());
          dens.forEach(function (b) {
            b.addEventListener('click', function () { set(KEY, b.dataset.density); applyCols(b.dataset.density); });
          });
        }

        // Index view: one photo follows the pointer over the rows.
        var peek = sec.querySelector('[data-peek]');
        if (grid && peek && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          var img = document.createElement('img');
          img.alt = '';
          peek.appendChild(img);
          grid.addEventListener('pointermove', function (e) {
            var row = grid.classList.contains('is-index') && e.target.closest('[data-peek-src]');
            if (!row) { peek.classList.remove('is-on'); return; }
            if (img.getAttribute('src') !== row.dataset.peekSrc) img.src = row.dataset.peekSrc;
            peek.style.left = e.clientX + 'px';
            peek.style.top = e.clientY + 'px';
            peek.classList.add('is-on');
          });
          grid.addEventListener('pointerleave', function () { peek.classList.remove('is-on'); });
          window.addEventListener('scroll', function () { peek.classList.remove('is-on'); }, { passive: true });
        }

        // Show more: fetch the next page and append its products. With
        // "Load as you scroll" the same request fires as the button nears the viewport.
        var more = sec.querySelector('[data-more-link]');
        if (more && grid) {
          var busy = false;
          var io = null;
          var loadMore = function () {
            if (busy || !more.isConnected) return;
            busy = true;
            more.classList.add('k-loading');
            var url = new URL(more.href, location.href);
            url.searchParams.set('section_id', sec.closest('[id^="shopify-section-"]').id.replace('shopify-section-', ''));
            fetch(url.toString()).then(function (r) { return r.text(); }).then(function (html) {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              doc.querySelectorAll('[data-grid] > .k-col__item').forEach(function (li) { li.classList.add('is-visible'); grid.appendChild(li); });
              var nextLink = doc.querySelector('[data-more-link]');
              var shown = grid.querySelectorAll('.k-col__item').length;
              var total = parseInt(more.dataset.total, 10) || shown;
              var label = sec.querySelector('[data-more-label]');
              var freshLabel = doc.querySelector('[data-more-label]');
              if (label && freshLabel) label.textContent = freshLabel.textContent;
              var bar = sec.querySelector('[data-more-bar]');
              if (bar) bar.style.transform = 'scaleX(' + Math.min(1, shown / total) + ')';
              busy = false;
              if (nextLink) {
                more.href = nextLink.href;
                more.classList.remove('k-loading');
                if (io) { io.unobserve(more); io.observe(more); }
              } else {
                if (io) io.disconnect();
                more.remove();
              }
            }).catch(function () { window.location.href = more.href; });
          };
          more.addEventListener('click', function (e) { e.preventDefault(); loadMore(); });
          if (sec.querySelector('[data-infinite]') && 'IntersectionObserver' in window) {
            io = new IntersectionObserver(function (entries) {
              if (entries.some(function (en) { return en.isIntersecting; })) loadMore();
            }, { rootMargin: '600px 0px' });
            io.observe(more);
          }
        }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); });
    else init();
    document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  })();
{% endjavascript %}

