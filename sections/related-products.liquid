{%- liquid
  assign limit = section.settings.limit
  assign heading = section.settings.heading | strip
  # On the cart page there is no product, so recommendations follow the first line item.
  assign source = product
  if source == blank and cart.item_count > 0
    assign source = cart.items.first.product
  endif
  assign in_cart = cart.items | map: 'product_id' | join: ','
-%}

<k-recommendations
  class="k-related color-{{ section.settings.color_scheme }}"
  {% if source %}data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ source.id }}&limit={{ limit }}&intent={{ section.settings.intent }}"{% endif %}
>
  {%- liquid
    assign show = false
    assign use_fallback = false
    if recommendations.performed? and recommendations.products_count > 0
      assign show = true
    elsif recommendations.performed? == false and section.settings.fallback_collection.products_count > 0
      assign show = true
      assign use_fallback = true
    endif
  -%}
  {%- if show -%}
    <section class="k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }}" aria-label="{{ heading | escape }}">
      {%- if heading != blank -%}
        {%- if section.settings.heading_style == 'ticker' -%}
          <div class="k-related__ticker k-marquee" aria-hidden="true" style="--marquee-duration: 24s;">
            <div class="k-marquee__track">
              {%- for i in (1..8) -%}
                {%- liquid
                  assign odd = forloop.index | modulo: 2
                  assign tape_class = ''
                  if odd == 0
                    assign tape_class = 'k-related__outline'
                  endif
                -%}
                <span class="{{ tape_class }}">{{ heading }}</span>
              {%- endfor -%}
            </div>
          </div>
          <h2 class="visually-hidden">{{ heading }}</h2>
        {%- else -%}
          <div class="k-wrap"><div class="k-sec-head"><h2 class="k-h2">{{ heading }}</h2></div></div>
        {%- endif -%}
      {%- endif -%}

      <div class="k-wrap k-related__body">
        <ul class="k-grid" role="list" style="--cols: {{ section.settings.columns }};">
          {%- if use_fallback -%}
            {%- assign shown = 0 -%}
            {%- for rec in section.settings.fallback_collection.products -%}
              {%- liquid
                assign rec_id = rec.id | append: ''
                assign skip = false
                if rec.id == source.id or shown >= limit
                  assign skip = true
                endif
                if template.name == 'cart' and in_cart contains rec_id
                  assign skip = true
                endif
              -%}
              {%- if skip -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              <li class="k-reveal">{% render 'k-card', product: rec, quick_add: section.settings.quick_add %}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for rec in recommendations.products -%}
              <li class="k-reveal">{% render 'k-card', product: rec, quick_add: section.settings.quick_add %}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </section>
  {%- endif -%}
</k-recommendations>

{% stylesheet %}
  .k-related:empty, .k-related:not(:has(section)) { display: none; }
  .k-related__ticker {
    margin-bottom: 56px;
    border-block: 1px solid var(--color-line);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight-black);
    font-size: calc(clamp(32px, 3.4vw, 48px) * var(--heading-scale));
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    --marquee-gap: 40px;
  }
  .k-related__ticker .k-marquee__track { padding-block: 22px; }
  .k-related__outline { color: transparent; -webkit-text-stroke: 1.2px var(--color-text); }
  .k-related__body .k-grid { margin: 0; padding: 0; list-style: none; }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('k-recommendations')) {
    customElements.define('k-recommendations', class extends HTMLElement {
      connectedCallback() {
        if (!this.dataset.url) return;
        var load = () => {
          fetch(this.dataset.url)
            .then(function (r) { return r.text(); })
            .then((html) => {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              var fresh = doc.querySelector('k-recommendations');
              // Only replace when Shopify returned products; otherwise keep the fallback collection.
              if (fresh && fresh.querySelector('.k-card')) this.innerHTML = fresh.innerHTML;
              this.dataset.loaded = 'true';
              document.dispatchEvent(new CustomEvent('shopify:section:load', { detail: { sectionId: 'related' } }));
            })
            .catch(function () {});
        };
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { io.disconnect(); load(); }
          }, { rootMargin: '0px 0px 400px 0px' });
          io.observe(this);
        } else {
          load();
        }
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "class": "k-related-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "select", "id": "heading_style", "label": "Heading style", "default": "ticker", "options": [ { "value": "ticker", "label": "Scrolling ticker" }, { "value": "static", "label": "Static heading" } ] },
    { "type": "select", "id": "intent", "label": "Products to show", "default": "related", "options": [ { "value": "related", "label": "Related products" }, { "value": "complementary", "label": "Complementary products" } ], "info": "Complementary products are set up in the Search and Discovery app. Related products are picked automatically." },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection", "info": "Shown until Shopify has enough store data to recommend products. New stores usually need this." },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "medium", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "presets": [ { "name": "Related products" } ],
  "enabled_on": { "templates": ["product", "cart"] }
}
{% endschema %}
