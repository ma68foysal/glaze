{%- comment -%}
  Feature index: a filterable, numbered list of features (or services,
  values, departments). Each row widens on hover, can link somewhere, and can
  carry a photo that follows the pointer on mouse devices. Categories become
  filter chips automatically.
{%- endcomment -%}
{%- liquid
  assign cats = ''
  for block in section.blocks
    assign c = block.settings.category | strip
    if c != blank
      assign probe = '|' | append: c | append: '|'
      unless cats contains probe
        assign cats = cats | append: '|' | append: c | append: '|'
      endunless
    endif
  endfor
  assign cat_list = cats | split: '|' | compact
-%}
<section class="k-fidx k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}">
  <k-feature-index class="k-wrap k-fidx__in">
    <header class="k-fidx__head">
      {%- if section.settings.eyebrow != blank -%}<p class="k-label k-muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- liquid
        assign h_tag = 'h2'
        if template.name == 'page' and section.index == 1
          assign h_tag = 'h1'
        endif
      -%}
      {%- if section.settings.heading != blank -%}<{{ h_tag }} class="k-h-display k-fidx__title">{{ section.settings.heading }}</{{ h_tag }}>{%- endif -%}
      {%- assign real_cats = 0 -%}
      {%- for c in cat_list -%}{%- if c != blank -%}{%- assign real_cats = real_cats | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if real_cats > 1 -%}
        <div class="k-fidx__chips" role="group" aria-label="{{ 'sections.feature_index.filter' | t }}">
          <button type="button" aria-pressed="true" data-fidx-cat="">{{ 'sections.feature_index.all' | t }}</button>
          {%- for c in cat_list -%}
            {%- if c != blank -%}<button type="button" aria-pressed="false" data-fidx-cat="{{ c | handleize }}">{{ c }}</button>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </header>

    <ol class="k-fidx__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <li class="k-fidx__item" data-fidx-item="{{ block.settings.category | handleize }}" {{ block.shopify_attributes }}>
          <{{ tag }} class="k-fidx__row"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %}{% if block.settings.image %} data-peek-src="{{ block.settings.image | image_url: width: 480 }}"{% endif %}>
            <span class="k-fidx__n k-label">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="k-fidx__name">{{ block.settings.title }}</span>
            <span class="k-fidx__text">{{ block.settings.text }}</span>
            {%- if block.settings.category != blank -%}<span class="k-fidx__cat k-label">{{ block.settings.category }}</span>{%- endif -%}
          </{{ tag }}>
        </li>
      {%- endfor -%}
    </ol>
    <div class="k-fidx__peek k-media" aria-hidden="true" data-peek></div>
  </k-feature-index>
</section>

{% stylesheet %}
  .k-fidx__in { display: grid; gap: 28px; }
  .k-fidx__head { display: grid; gap: 18px; padding-bottom: 24px; border-bottom: 1.5px solid var(--color-text); }
  .k-fidx__head .k-label { margin: 0; }
  .k-fidx__title { margin: 0; font-size: clamp(56px, 9vw, 150px); overflow-wrap: anywhere; }
  .k-fidx__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .k-fidx__chips button { min-height: 40px; padding: 0 16px; border: 1.5px solid var(--color-text); border-radius: 999px; background: transparent; color: inherit; font: 600 14px var(--font-body); cursor: pointer; transition: background-color 0.3s, color 0.3s; }
  .k-fidx__chips button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }
  .k-fidx__list { margin: 0; padding: 0; list-style: none; }
  .k-fidx__item[hidden] { display: none; }
  .k-fidx__item:not([hidden]) { animation: k-rise-in 0.5s var(--ease-out) both; }
  .k-fidx__row {
    display: grid; grid-template-columns: 60px minmax(0, 1.1fr) minmax(0, 1fr) 150px; gap: 20px; align-items: center;
    padding: 18px 0; border-bottom: 1px solid var(--color-line); transition: padding-left 0.5s var(--ease-out);
  }
  .k-fidx__name {
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: clamp(30px, 4.4vw, 62px);
    line-height: 0.92; letter-spacing: -0.035em; overflow-wrap: anywhere; transform-origin: 0 50%; transition: transform 0.6s var(--ease-out), color 0.3s;
  }
  .k-fidx__text { color: var(--color-muted); font-size: 15px; line-height: 1.45; }
  .k-fidx__cat { justify-self: end; padding: 6px 10px; border: 1px solid var(--color-line); border-radius: 999px; }
  a.k-fidx__row:hover, a.k-fidx__row:focus-visible { padding-left: 14px; }
  .k-fidx__row:hover .k-fidx__name { transform: scaleX(1.05); }
  a.k-fidx__row:hover .k-fidx__name { color: var(--color-accent); }
  .k-fidx__peek { position: fixed; left: 0; top: 0; z-index: 15; width: 220px; aspect-ratio: 3 / 4; pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(0.88) rotate(-4deg); transition: opacity 0.25s, transform 0.4s var(--ease-out); box-shadow: 0 30px 50px -30px rgba(14, 14, 14, 0.6); }
  .k-fidx__peek.is-on { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-4deg); }
  .k-fidx__peek img { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: none), (pointer: coarse) { .k-fidx__peek { display: none; } }
  @media (max-width: 749px) {
    .k-fidx__row { grid-template-columns: 36px minmax(0, 1fr); row-gap: 8px; }
    .k-fidx__text, .k-fidx__cat { grid-column: 2; }
    .k-fidx__cat { justify-self: start; }
  }
  @media (prefers-reduced-motion: reduce) { .k-fidx__item:not([hidden]) { animation: none; } }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('k-feature-index')) {
    customElements.define('k-feature-index', class extends HTMLElement {
      connectedCallback() {
        var chips = this.querySelectorAll('[data-fidx-cat]');
        var items = this.querySelectorAll('[data-fidx-item]');
        chips.forEach((chip) => chip.addEventListener('click', () => {
          chips.forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
          var cat = chip.dataset.fidxCat;
          items.forEach(function (it) { it.hidden = !!cat && it.dataset.fidxItem !== cat; });
        }));
        var peek = this.querySelector('[data-peek]');
        var list = this.querySelector('.k-fidx__list');
        if (!peek || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        var img = document.createElement('img');
        img.alt = '';
        peek.appendChild(img);
        list.addEventListener('pointermove', function (e) {
          var row = e.target.closest('[data-peek-src]');
          if (!row) { peek.classList.remove('is-on'); return; }
          if (img.getAttribute('src') !== row.dataset.peekSrc) img.src = row.dataset.peekSrc;
          peek.style.left = (e.clientX + 150) + 'px';
          peek.style.top = e.clientY + 'px';
          peek.classList.add('is-on');
        });
        list.addEventListener('pointerleave', function () { peek.classList.remove('is-on'); });
        window.addEventListener('scroll', function () { peek.classList.remove('is-on'); }, { passive: true });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Feature index",
  "tag": "section",
  "class": "k-fidx-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything in this store, out of the box" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "In this <em>issue</em>", "info": "Italic words use the accent font." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "medium", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "text", "id": "text", "label": "Text", "default": "What it does, in one line." },
        { "type": "text", "id": "category", "label": "Category", "info": "Rows with the same category share a filter chip." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Follows the pointer on hover." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature index",
      "blocks": [
        { "type": "feature", "settings": { "title": "Motion presets", "text": "Kinetic, Editorial or Still: one setting for every animation.", "category": "Signature" } },
        { "type": "feature", "settings": { "title": "Index view", "text": "Collections read like a contents page.", "category": "Signature" } },
        { "type": "feature", "settings": { "title": "Fit and size finder", "text": "A fit scale, a model note and three questions.", "category": "Signature" } },
        { "type": "feature", "settings": { "title": "Quick view", "text": "Pick a size and add to the bag without leaving the page.", "category": "Commerce" } }
      ]
    }
  ]
}
{% endschema %}
