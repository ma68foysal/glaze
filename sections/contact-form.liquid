{%- liquid
  # The form tag doesn't evaluate filters in its arguments, so build the id first.
  assign form_id = 'contact-' | append: section.id
  assign topics = section.settings.topics | split: ','
  assign intro = section.settings.text
  if page.content != blank
    assign intro = page.content
  endif
-%}
<section id="{{ form_id }}-wrap" class="k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}" aria-labelledby="{{ form_id }}-heading">
  <div class="k-wrap k-cform">
    <div class="k-cform__intro">
      <h2 class="k-h2" id="{{ form_id }}-heading">{{ section.settings.heading }}</h2>
      {%- if intro != blank -%}<div class="k-rte k-muted k-cform__text">{{ intro }}</div>{%- endif -%}
    </div>

    <div>
      {%- form 'contact', id: form_id, class: 'k-cform__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="k-cform__done color-{{ section.settings.success_color_scheme }}" role="status" tabindex="-1" data-focus-on-load>
            <span class="k-cform__tick">{% render 'k-icon', icon: 'check', size: 28 %}</span>
            <p class="k-cform__done-title">{{ section.settings.success_heading }}</p>
            {%- if section.settings.success_text != blank -%}<p class="k-cform__done-text">{{ section.settings.success_text }}</p>{%- endif -%}
            <a class="k-btn k-btn--secondary" href="{{ request.path }}#{{ form_id }}-wrap">{{ 'contact.send_another' | t }}</a>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="k-cform__errors" role="alert" tabindex="-1" data-focus-on-load>
              <p>{{ 'contact.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- if topics.size > 0 -%}
            <fieldset class="k-cform__topics">
              <legend class="k-field__label">{{ 'contact.topic' | t }}</legend>
              <div class="k-cform__pills">
                {%- for topic in topics -%}
                  {%- assign topic = topic | strip -%}
                  <input class="visually-hidden" type="radio" id="{{ form_id }}-topic-{{ forloop.index }}" name="contact[{{ 'contact.topic' | t }}]" value="{{ topic | escape }}"{% if forloop.first %} checked{% endif %}>
                  <label class="k-cform__pill" for="{{ form_id }}-topic-{{ forloop.index }}">{{ topic }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          <div class="k-cform__grid">
            <div class="k-field">
              <label class="k-field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }} <span aria-hidden="true">*</span></label>
              <input type="text" id="{{ form_id }}-name" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" required value="{{ form.name }}">
            </div>
            <div class="k-field">
              <label class="k-field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
              <input type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ form_id }}-email-error"{% endif %}>
              {%- if form.errors contains 'email' -%}
                <span class="k-cform__err" id="{{ form_id }}-email-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
              {%- endif -%}
            </div>
            {%- if section.settings.show_phone -%}
              <div class="k-field">
                <label class="k-field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
                <input type="tel" id="{{ form_id }}-phone" name="contact[{{ 'contact.phone_field' | t }}]" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*">
              </div>
            {%- endif -%}
            {%- if section.settings.show_order -%}
              <div class="k-field">
                <label class="k-field__label" for="{{ form_id }}-order">{{ 'contact.order' | t }}</label>
                <input type="text" id="{{ form_id }}-order" name="contact[{{ 'contact.order_field' | t }}]" placeholder="#1001">
              </div>
            {%- endif -%}
            <div class="k-field k-field--full">
              <label class="k-field__label" for="{{ form_id }}-body">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
              <textarea id="{{ form_id }}-body" name="contact[body]" maxlength="{{ section.settings.max_length }}" required aria-describedby="{{ form_id }}-count" data-count-input>{{ form.body }}</textarea>
              <span class="k-label k-muted k-cform__count" id="{{ form_id }}-count" aria-live="polite"><span data-count>0</span> / {{ section.settings.max_length }}</span>
            </div>
          </div>

          <div class="k-cform__actions">
            <button type="submit" class="k-btn k-btn--primary">
              <span>{{ section.settings.button_label }}</span>
              {%- render 'k-icon', icon: 'arrow', size: 18 -%}
            </button>
            <span class="k-muted k-cform__req">{{ 'contact.required' | t }}</span>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('{{ form_id }}');
    if (!form) return;
    var focus = form.querySelector('[data-focus-on-load]');
    if (focus) focus.focus();
    var input = form.querySelector('[data-count-input]');
    var out = form.querySelector('[data-count]');
    if (!input || !out) return;
    var sync = function () { out.textContent = input.value.length; };
    input.addEventListener('input', sync);
    sync();
  })();
</script>

{% stylesheet %}
  .k-cform { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 56px; }
  .k-cform__text { margin-top: 20px; max-width: 380px; font-size: 17px; line-height: 1.55; }
  .k-cform__form { display: flex; flex-direction: column; gap: 22px; }
  .k-cform__topics { margin: 0; padding: 0; border: 0; min-width: 0; }
  .k-cform__topics legend { padding: 0; margin-bottom: 10px; }
  .k-cform__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .k-cform__pill {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border: 1.5px solid var(--color-text); border-radius: 999px; font-size: 14px; font-weight: 500;
    cursor: pointer; transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  input:checked + .k-cform__pill { background: var(--color-text); color: var(--color-bg); }
  input:focus-visible + .k-cform__pill { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .k-cform__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .k-cform__err { color: #B42318; font-size: 13px; font-weight: 600; }
  .k-cform__count { align-self: flex-end; }
  .k-cform__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .k-cform__req { font-size: 14px; }
  .k-cform__errors { padding: 16px 20px; border: 1.5px solid #B42318; border-radius: 14px; color: #B42318; font-size: 15px; }
  .k-cform__errors p { margin: 0 0 6px; font-weight: 700; }
  .k-cform__errors ul { margin: 0; padding-left: 18px; }
  .k-cform__done {
    display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 40px;
    border-radius: var(--radius-card); background: var(--color-bg); color: var(--color-text);
    animation: k-rise-in 0.6s var(--ease-out) both;
  }
  .k-cform__done:focus { outline: none; }
  .k-cform__tick { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 999px; background: var(--color-accent); color: var(--color-bg); }
  .k-cform__done-title { margin: 0; font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: calc(44px * var(--heading-scale)); letter-spacing: -0.03em; line-height: 0.95; }
  .k-cform__done-text { margin: 0; max-width: 520px; font-size: 17px; line-height: 1.55; opacity: 0.85; }
  @media (max-width: 900px) {
    .k-cform, .k-cform__grid { grid-template-columns: 1fr; gap: 28px; }
    .k-cform__grid { gap: 18px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "class": "k-cform-section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Send a <em>message</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pick a topic so we can route your message to the right person. Have your order number ready for faster help.</p>", "info": "On a page with content, the page content is shown instead." },
    { "type": "text", "id": "topics", "label": "Topics", "default": "Order, Returns, Sizing, Repairs, Wholesale", "info": "Separate with commas. Leave empty to hide." },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone field", "default": true },
    { "type": "checkbox", "id": "show_order", "label": "Show order number field", "default": true },
    { "type": "range", "id": "max_length", "label": "Message length limit", "min": 200, "max": 2000, "step": 100, "default": 600, "unit": "chr" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "header", "content": "After sending" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "Thanks — message received." },
    { "type": "text", "id": "success_text", "label": "Text", "default": "Our team will reply within one working day." },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "success_color_scheme", "label": "Confirmation color scheme", "default": "scheme-2" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "medium", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
