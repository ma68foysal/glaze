{%- comment -%}
  Results for the header search, fetched from /search/suggest with
  section_id=predictive-search and shown in a listbox under the search input.
  Not addable in the editor: it only renders for the Predictive Search API.
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign r = predictive_search.resources
    assign total = r.products.size | plus: r.collections.size | plus: r.pages.size | plus: r.articles.size
    assign terms = predictive_search.terms
    assign q_encoded = terms | url_encode
    assign search_url = routes.search_url | append: '?q=' | append: q_encoded | append: '&options%5Bprefix%5D=last'
    assign product_url = search_url | append: '&type=product'
    assign side_count = r.articles.size | plus: r.pages.size
    assign popular = settings.popular_searches | split: ','
    assign col_count = r.queries.size | plus: r.collections.size
    if total == 0 and r.queries.size == 0
      assign col_count = 1
    endif
    assign layout = 'k-ps__body--cols'
    if col_count == 0
      assign layout = 'k-ps__body--no-col'
    endif
    if r.products.size == 0
      assign layout = layout | append: ' k-ps__body--no-products'
    endif
    if side_count == 0
      assign layout = layout | append: ' k-ps__body--no-side'
    endif
  -%}
  <div class="k-ps" role="listbox" id="predictive-search-listbox" aria-label="{{ 'general.search_results' | t }}" data-count="{{ total }}" data-terms="{{ terms | escape }}">
    <div class="k-ps__body {{ layout }}">
      {%- if col_count > 0 -%}
      <div class="k-ps__col">
        {%- if r.queries.size > 0 -%}
          <div class="k-ps__group" role="group" aria-labelledby="ps-h-queries">
            <p class="k-label k-muted k-ps__h" id="ps-h-queries">{{ 'general.search_suggestions' | t }}</p>
            {%- for query in r.queries -%}
              <a class="k-ps__opt k-ps__sug" id="ps-query-{{ forloop.index }}" role="option" aria-selected="false" href="{{ query.url }}" tabindex="-1">
                <span>{{ query.styled_text }}</span>{% render 'k-icon', icon: 'arrow', size: 16 %}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if r.collections.size > 0 -%}
          <div class="k-ps__group" role="group" aria-labelledby="ps-h-collections">
            <p class="k-label k-muted k-ps__h" id="ps-h-collections">{{ 'general.collections' | t }}</p>
            {%- for c in r.collections -%}
              <a class="k-ps__opt k-ps__sug" id="ps-collection-{{ forloop.index }}" role="option" aria-selected="false" href="{{ c.url }}" tabindex="-1">
                <span>{{ c.title }}</span><span class="k-label k-muted">{{ c.products_count }}</span>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if total == 0 and r.queries.size == 0 -%}
          <div class="k-ps__none">
            <p class="k-ps__none-title">{{ 'general.search_no_results' | t: terms: terms }}</p>
            <p class="k-muted">{{ 'general.search_no_results_hint' | t }}</p>
            {%- if popular.size > 0 -%}
              <div class="k-ps__chips">
                {%- for term in popular -%}
                  {%- assign term = term | strip -%}
                  {%- if term != blank -%}
                    <a class="k-ps__opt k-ps__chip" id="ps-popular-{{ forloop.index }}" role="option" aria-selected="false" tabindex="-1" href="{{ routes.search_url }}?q={{ term | url_encode }}&amp;options%5Bprefix%5D=last">{{ term }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if r.products.size > 0 -%}
        <div class="k-ps__group k-ps__products" role="group" aria-labelledby="ps-h-products">
          <div class="k-ps__products-head">
            <p class="k-label k-muted k-ps__h" id="ps-h-products">{{ 'general.products' | t }}</p>
            <a class="k-label k-ps__all-link" href="{{ product_url }}" tabindex="-1">{{ 'general.view_all' | t }}</a>
          </div>
          <div class="k-ps__grid">
            {%- for product in r.products -%}
              <a class="k-ps__opt k-ps__pr" id="ps-product-{{ forloop.index }}" role="option" aria-selected="false" href="{{ product.url }}" tabindex="-1" style="--i: {{ forloop.index0 }};">
                <span class="k-ps__img k-media">
                  {%- if product.featured_media -%}
                    {{ product.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 900px) 160px, 45vw', alt: '' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'k-ph' }}
                  {%- endif -%}
                  {%- unless product.available -%}<span class="k-label k-ps__so">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
                </span>
                <span class="k-ps__nm" data-highlight>{{ product.title }}</span>
                <span class="k-ps__pz">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
                    {{ product.price | money }}
                    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
                    <s class="k-muted">{{ product.compare_at_price | money }}</s>
                  {%- elsif product.price_varies -%}
                    {%- assign min_price = product.price_min | money -%}
                    {{ 'products.price_from' | t: price: min_price }}
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if side_count > 0 -%}
        <div class="k-ps__group k-ps__side" role="group" aria-labelledby="ps-h-side">
          <p class="k-label k-muted k-ps__h" id="ps-h-side">{{ 'general.articles_and_pages' | t }}</p>
          {%- for a in r.articles -%}
            <a class="k-ps__opt k-ps__lnk" id="ps-article-{{ forloop.index }}" role="option" aria-selected="false" href="{{ a.url }}" tabindex="-1">
              <span class="k-ps__thumb k-media">
                {%- if a.image -%}
                  {{ a.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 56, height: 56 }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'k-ph' }}
                {%- endif -%}
              </span>
              {%- assign blog_label = a.blog.title -%}{%- if blog_label == blank -%}{%- assign blog_label = 'general.article' | t -%}{%- endif -%}
              <span><span class="k-label k-muted">{{ blog_label }}</span><span class="k-ps__lnk-title" data-highlight>{{ a.title }}</span></span>
            </a>
          {%- endfor -%}
          {%- for p in r.pages -%}
            <a class="k-ps__opt k-ps__lnk" id="ps-page-{{ forloop.index }}" role="option" aria-selected="false" href="{{ p.url }}" tabindex="-1">
              <span class="k-ps__thumb k-ps__thumb--icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6"/></svg></span>
              <span><span class="k-label k-muted">{{ 'general.page' | t }}</span><span class="k-ps__lnk-title" data-highlight>{{ p.title }}</span></span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="k-ps__foot">
      <span class="k-label k-muted k-ps__keys" aria-hidden="true">{{ 'general.search_keys' | t }}</span>
      <a class="k-ps__opt k-btn k-btn--primary k-ps__all" id="ps-all" role="option" aria-selected="false" href="{{ search_url }}" tabindex="-1">
        <span>{{ 'general.search_for' | t: terms: terms }}</span>
        {%- render 'k-icon', icon: 'arrow', size: 18 -%}
      </a>
    </div>
    <span hidden data-ps-status>{{ 'general.search_results_count' | t: count: total }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .k-ps__body { display: grid; grid-template-columns: 260px minmax(0, 1fr) 300px; gap: 40px; padding: 32px 0 36px; }
  .k-ps__body--no-side, .k-ps__body--no-products { grid-template-columns: 260px minmax(0, 1fr); }
  .k-ps__body--no-col { grid-template-columns: minmax(0, 1fr) 300px; }
  .k-ps__body--no-col.k-ps__body--no-side, .k-ps__body--no-col.k-ps__body--no-products,
  .k-ps__body--no-products.k-ps__body--no-side { grid-template-columns: minmax(0, 1fr); }
  .k-ps__col { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .k-ps__group { display: flex; flex-direction: column; min-width: 0; }
  .k-ps__h { margin: 0 0 14px; }
  .k-ps__opt { color: inherit; transition: background-color var(--dur-fast); }
  .k-ps__opt[aria-selected="true"] { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .k-ps__sug {
    display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px;
    margin: 0 -12px; padding: 0 12px; border-radius: 12px; font-size: 17px; font-weight: 500;
  }
  .k-ps__sug:hover, .k-ps__sug[aria-selected="true"] { background: var(--color-surface); }
  .k-ps__sug mark { background: none; color: inherit; font-weight: 800; }
  .k-ps__sug .k-icon { flex: none; opacity: 0; transition: opacity var(--dur-fast), transform var(--dur-fast); }
  .k-ps__sug:hover .k-icon, .k-ps__sug[aria-selected="true"] .k-icon { opacity: 1; transform: translateX(3px); }

  .k-ps__products-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .k-ps__all-link { text-decoration: underline; text-underline-offset: 3px; }
  .k-ps__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .k-ps__pr { display: flex; flex-direction: column; gap: 8px; border-radius: 14px; animation: k-ps-up 0.45s var(--ease-out) both; animation-delay: calc(var(--i, 0) * 0.05s); }
  @keyframes k-ps-up { from { opacity: 0; transform: translateY(18px); } }
  .k-ps__img { display: block; aspect-ratio: 3 / 4; border-radius: 14px; }
  .k-ps__img img { transition: transform 0.8s var(--ease-out); }
  .k-ps__pr:hover .k-ps__img img { transform: scale(1.06); }
  .k-ps__so { position: absolute; left: 8px; top: 8px; z-index: 1; padding: 4px 8px; border-radius: 999px; background: var(--color-text); color: var(--color-bg); }
  .k-ps__nm { font-size: 14px; font-weight: 600; line-height: 1.25; overflow-wrap: break-word; }
  .k-ps__nm mark, .k-ps__lnk-title mark { background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: inherit; font-weight: 700; }
  .k-ps__pz { font-size: 14px; }
  .k-ps__pz s { margin-left: 4px; }

  .k-ps__side { gap: 4px; }
  .k-ps__side .k-ps__h { margin-bottom: 10px; }
  .k-ps__lnk { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; align-items: center; margin: 0 -8px; padding: 8px; border-radius: 14px; }
  .k-ps__lnk:hover, .k-ps__lnk[aria-selected="true"] { background: var(--color-surface); }
  .k-ps__thumb { display: block; width: 56px; height: 56px; border-radius: 10px; }
  .k-ps__thumb--icon { display: grid; place-items: center; background: var(--color-surface); }
  .k-ps__lnk-title { display: block; font-weight: 600; line-height: 1.25; }

  .k-ps__none { padding: 24px; border-radius: 20px; background: var(--color-surface); }
  .k-ps__none-title { margin: 0; font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: 32px; letter-spacing: -0.02em; line-height: 1; overflow-wrap: anywhere; }
  .k-ps__none .k-muted { margin: 10px 0 18px; }
  .k-ps__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .k-ps__chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1.5px solid var(--color-text); border-radius: 999px; font-size: 14px; font-weight: 500; }
  .k-ps__chip:hover { background: var(--color-text); color: var(--color-bg); }
  .k-ps__body--no-products .k-ps__col:has(.k-ps__none) { grid-column: 1 / -1; max-width: 640px; }

  .k-ps__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 16px 0 22px; border-top: 1px solid var(--color-line); }
  .k-ps__all { max-width: 100%; }
  .k-ps__all span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  @media (max-width: 1100px) {
    .k-ps__body--cols, .k-ps__body--cols.k-ps__body--no-side { grid-template-columns: 220px minmax(0, 1fr); }
    .k-ps__body--cols .k-ps__side { grid-column: 2; }
    .k-ps__body--no-col:not(.k-ps__body--no-side):not(.k-ps__body--no-products) { grid-template-columns: minmax(0, 1fr) 240px; }
  }
  @media (max-width: 900px) {
    .k-ps__body.k-ps__body { grid-template-columns: 1fr; gap: 28px; padding-top: 24px; }
    .k-ps__side { grid-column: auto; }
    .k-ps__products { order: -1; }
    .k-ps__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .k-ps__keys { display: none; }
    .k-ps__all { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .k-ps__pr { animation: none; } }
{% endstylesheet %}
