<section class="k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}"{% if section.settings.heading != blank %} aria-label="{{ section.settings.heading | escape }}"{% endif %}>
  <div class="k-wrap">
    <ul class="k-ways" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <li class="k-reveal" {{ block.shopify_attributes }}>
          <{{ tag }} class="k-ways__card"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %}>
            <span class="k-ways__icon">{% render 'k-icon', icon: block.settings.icon, size: 22 %}</span>
            {%- if block.settings.label != blank -%}<span class="k-label">{{ block.settings.label }}</span>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="k-ways__heading">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.value != blank -%}<span class="k-ways__value">{{ block.settings.value }}</span>{%- endif -%}
            {%- if block.settings.text != blank -%}<span class="k-ways__text">{{ block.settings.text }}</span>{%- endif -%}
          </{{ tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .k-ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .k-ways > li { display: flex; }
  .k-ways__card {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; gap: 14px; width: 100%; padding: 28px;
    border-radius: calc(var(--radius-card) * 0.85); background: var(--color-surface); color: var(--color-text);
    transition: color 0.45s;
  }
  a.k-ways__card::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: var(--color-accent); transform: translateY(101%);
    transition: transform 0.55s var(--ease-in-out);
  }
  a.k-ways__card:hover { color: var(--color-bg); }
  a.k-ways__card:hover::before { transform: none; }
  .k-ways__icon { display: grid; place-items: center; width: 52px; height: 52px; border: 1.5px solid currentColor; border-radius: 999px; }
  .k-ways__heading { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.02em; }
  .k-ways__value { font-size: 18px; font-weight: 600; overflow-wrap: anywhere; }
  .k-ways__text { font-size: 15px; opacity: 0.8; }
  @media (max-width: 900px) { .k-ways { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact methods",
  "tag": "div",
  "class": "k-ways-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Accessible name", "default": "Ways to reach us", "info": "Read by screen readers; not shown." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Contact method",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "mail", "options": [ { "value": "mail", "label": "Email" }, { "value": "phone", "label": "Phone" }, { "value": "pin", "label": "Location" }, { "value": "arrow-up-right", "label": "Arrow" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer care" },
        { "type": "text", "id": "value", "label": "Detail", "default": "hello@example.com", "info": "An email address, phone number or street address." },
        { "type": "text", "id": "text", "label": "Text", "default": "Replies within one working day" },
        { "type": "url", "id": "link", "label": "Link", "info": "Use mailto: or tel: links. The card isn't clickable without one." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact methods",
      "blocks": [
        { "type": "method", "settings": { "icon": "mail", "label": "Email", "heading": "Customer care", "value": "hello@example.com", "text": "Replies within one working day" } },
        { "type": "method", "settings": { "icon": "phone", "label": "Phone", "heading": "Talk to us", "value": "+1 555 010 0100", "text": "Monday to Friday" } },
        { "type": "method", "settings": { "icon": "pin", "label": "Visit", "heading": "The studio", "value": "12 Example Street, City", "text": "Pickup, fittings and repairs" } }
      ]
    }
  ]
}
{% endschema %}
