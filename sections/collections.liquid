{%- comment -%}
  All collections (/collections), drawn as a contents page.
  Index view: numbered rows that widen on hover, with one photo following the
  pointer on mouse devices. Grid view: a bento of collection photos. The
  shopper's choice is remembered in their browser.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection_list
  if source == blank or source.size == 0
    assign source = collections
  endif
  assign total = 0
  for c in source
    if c.handle != 'frontpage'
      assign total = total | plus: 1
    endif
  endfor
  assign view = section.settings.default_view
-%}

<section
  id="collections-{{ section.id }}"
  class="k-clist k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}"
  data-k-clist
  data-default="{{ view }}"
>
  <div class="k-wrap">
    <header class="k-clist__head">
      <h1 class="k-clist__title k-h-display">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'collections.title' | t }}{%- endif -%}
        {%- if section.settings.show_total and total > 0 -%}<sup class="k-clist__total k-label">{{ total }}</sup>{%- endif -%}
      </h1>
      {%- if total > 1 -%}
        <div class="k-clist__views" role="group" aria-label="{{ 'collections.view_label' | t }}">
          <button type="button" data-view="index" aria-pressed="{% if view == 'index' %}true{% else %}false{% endif %}">{{ 'collections.view_index' | t }}</button>
          <button type="button" data-view="grid" aria-pressed="{% if view == 'grid' %}true{% else %}false{% endif %}">{{ 'collections.view_grid' | t }}</button>
        </div>
      {%- endif -%}
    </header>

    {%- if total > 0 -%}
      <ol class="k-clist__list{% if view == 'grid' %} is-grid{% endif %}" role="list" data-k-clist-list>
        {%- assign n = 0 -%}
        {%- for c in source -%}
          {%- if c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          {%- liquid
            assign img = c.featured_image
            if img == blank and c.products.first.featured_media
              assign img = c.products.first.featured_media.preview_image
            endif
          -%}
          {%- liquid
            assign last_attr = ''
            if n == total
              assign p6 = n | modulo: 6
              assign sd = 0
              case p6
                when 1 or 4
                  assign sd = 4
                when 2
                  assign sd = 2
                when 5
                  assign sd = 3
              endcase
              assign p3 = n | modulo: 3
              assign sm = 0
              if p3 == 2
                assign sm = 1
              endif
              if sd > 0 or sm > 0
                assign last_attr = ' is-fill" style="--sd: ' | append: sd | append: '; --sm: ' | append: sm | append: ';'
              endif
            endif
          -%}
          <li class="k-clist__item{{ last_attr }}">
            <a class="k-clist__row" href="{{ c.url }}"{% if img %} data-peek-src="{{ img | image_url: width: 480 }}"{% endif %}>
              <span class="k-clist__n k-label">{% if n < 10 %}0{% endif %}{{ n }}</span>
              <span class="k-clist__media k-media" aria-hidden="true">
                {%- if img -%}
                  {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '400, 600, 800, 1200', alt: '' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'k-ph' }}
                {%- endif -%}
              </span>
              <span class="k-clist__name">{{ c.title | escape }}</span>
              {%- if section.settings.show_description and c.description != blank -%}
                <span class="k-clist__desc">{{ c.description | strip_html | truncatewords: 14 }}</span>
              {%- endif -%}
              <span class="k-clist__count k-label">{{ 'collection.product_count' | t: count: c.products_count }}</span>
              <span class="k-clist__arrow" aria-hidden="true">{% render 'k-icon', icon: 'arrow', size: 16 %}</span>
            </a>
          </li>
        {%- endfor -%}
      </ol>
      <div class="k-clist__peek k-media" aria-hidden="true" data-peek></div>
    {%- else -%}
      <p class="k-clist__empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .k-clist__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; padding-bottom: 28px; border-bottom: 1.5px solid var(--color-text); }
  .k-clist__title { margin: 0; font-size: clamp(64px, 11vw, 170px); overflow-wrap: anywhere; }
  .k-clist__total { margin-left: 0.2em; font-size: 0.13em; vertical-align: top; letter-spacing: 0.06em; }
  .k-clist__views { display: inline-flex; padding: 3px; border: 1.5px solid var(--color-text); border-radius: 999px; }
  .k-clist__views button { min-height: 40px; padding: 0 18px; border: 0; border-radius: 999px; background: transparent; color: inherit; font: 600 14px var(--font-body); cursor: pointer; transition: background-color 0.3s, color 0.3s; }
  .k-clist__views button[aria-pressed="true"] { background: var(--color-text); color: var(--color-bg); }
  .k-clist__list { margin: 0; padding: 0; list-style: none; }
  .k-clist__empty { margin: 48px 0 0; font-size: 18px; }

  /* Index view */
  .k-clist__row {
    display: grid; grid-template-columns: 70px minmax(0, 1fr) minmax(0, 0.9fr) 100px 44px; gap: 20px; align-items: center;
    padding: 18px 0; border-bottom: 1px solid var(--color-line);
    transition: padding-left 0.5s var(--ease-out);
  }
  .k-clist__media { display: none; }
  .k-clist__name {
    font-family: var(--font-heading); font-weight: var(--font-heading-weight-black); font-size: clamp(34px, 5.4vw, 80px);
    line-height: 0.9; letter-spacing: -0.035em; overflow-wrap: anywhere;
    transform-origin: 0 50%; transition: transform 0.6s var(--ease-out), color 0.3s;
  }
  .k-clist__desc { color: var(--color-muted); font-size: 15px; line-height: 1.45; }
  .k-clist__count { justify-self: end; color: var(--color-muted); }
  .k-clist__arrow { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--color-line); border-radius: 999px; transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease-out); }
  .k-clist__row:hover, .k-clist__row:focus-visible { padding-left: 14px; }
  .k-clist__row:hover .k-clist__name, .k-clist__row:focus-visible .k-clist__name { transform: scaleX(1.06); color: var(--color-accent); }
  .k-clist__row:hover .k-clist__arrow, .k-clist__row:focus-visible .k-clist__arrow { background: var(--color-text); color: var(--color-bg); transform: rotate(-45deg); }
  .k-clist__row:not(:has(.k-clist__desc)) { grid-template-columns: 70px minmax(0, 1fr) 100px 44px; }
  .k-clist__peek {
    position: fixed; left: 0; top: 0; z-index: 15; width: 220px; aspect-ratio: 3 / 4;
    pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(0.88) rotate(-4deg);
    transition: opacity 0.25s, transform 0.4s var(--ease-out);
    box-shadow: 0 30px 50px -30px rgba(14, 14, 14, 0.6);
  }
  .k-clist__peek.is-on { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-4deg); }
  .k-clist__peek img { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: none), (pointer: coarse) { .k-clist__peek { display: none; } }

  /* Grid view: a bento that repeats every six tiles (wide, two small / two small, wide). */
  .k-clist__list.is-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; padding-top: 28px; }
  .is-grid .k-clist__item:is(:nth-child(6n + 1), :nth-child(6n + 6)) { grid-column: span 2; }
  .is-grid .k-clist__item.is-fill:not([style*='--sd: 0']) { grid-column: span var(--sd); }
  .is-grid .k-clist__row {
    position: relative; display: block; height: 100%; aspect-ratio: 3 / 4; padding: 0; border: 0; overflow: hidden;
    background: var(--color-surface); color: #fff;
  }
  .is-grid .k-clist__item:is(:nth-child(6n + 1), :nth-child(6n + 6), .is-fill) .k-clist__row { aspect-ratio: auto; min-height: 100%; }
  .is-grid .k-clist__item.is-fill .k-clist__row { min-height: 360px; }
  .is-grid .k-clist__media { display: block; position: absolute; inset: 0; }
  .is-grid .k-clist__media :is(img, svg) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .is-grid .k-clist__row:hover .k-clist__media img { transform: scale(1.05); }
  .is-grid .k-clist__row::after { content: ""; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, rgba(0, 0, 0, 0.6)); pointer-events: none; }
  .is-grid :is(.k-clist__n, .k-clist__count) { position: absolute; top: 14px; z-index: 1; padding: 4px 8px; border-radius: 999px; background: rgba(14, 14, 14, 0.55); color: #fff; }
  .is-grid .k-clist__n { left: 14px; }
  .is-grid .k-clist__count { right: 14px; }
  .is-grid .k-clist__name { position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 1; font-size: clamp(26px, 2.8vw, 44px); color: #fff; overflow-wrap: normal; hyphens: auto; }
  .is-grid .k-clist__row:hover .k-clist__name { transform: none; color: #fff; }
  .is-grid :is(.k-clist__desc, .k-clist__arrow) { display: none; }
  .is-grid .k-clist__row:hover, .is-grid .k-clist__row:focus-visible { padding-left: 0; }

  @media (max-width: 749px) {
    .k-clist__row, .k-clist__row:not(:has(.k-clist__desc)) { grid-template-columns: 34px minmax(0, 1fr) 44px; gap: 12px; }
    .k-clist__desc, .k-clist__count { display: none; }
    .k-clist__list.is-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .is-grid .k-clist__item:is(:nth-child(6n + 1), :nth-child(6n + 6)) { grid-column: auto; }
    .is-grid .k-clist__item:is(:nth-child(6n + 1), :nth-child(6n + 6)) .k-clist__row { aspect-ratio: 3 / 4; min-height: 0; }
    .is-grid .k-clist__item:nth-child(3n + 1) { grid-column: 1 / -1; }
    .is-grid .k-clist__item:nth-child(3n + 1) .k-clist__row { aspect-ratio: 4 / 3; min-height: 0; }
    .is-grid .k-clist__item.is-fill { grid-column: auto; }
    .is-grid .k-clist__item.is-fill:not([style*='--sm: 0']) { grid-column: 1 / -1; }
    .is-grid .k-clist__item.is-fill .k-clist__row { min-height: 0; aspect-ratio: 3 / 4; }
    .is-grid .k-clist__item.is-fill:is(:nth-child(3n + 1), :not([style*='--sm: 0'])) .k-clist__row { aspect-ratio: 4 / 3; }
    .is-grid .k-clist__count { display: block; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var KEY = 'oblique:collections-view';
    function setup(sec) {
      var list = sec.querySelector('[data-k-clist-list]');
      if (!list || sec.dataset.bound) return;
      sec.dataset.bound = '1';
      var btns = sec.querySelectorAll('[data-view]');
      function apply(v) {
        list.classList.toggle('is-grid', v === 'grid');
        btns.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.view === v ? 'true' : 'false'); });
      }
      var saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      if (saved === 'grid' || saved === 'index') apply(saved);
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          apply(b.dataset.view);
          try { localStorage.setItem(KEY, b.dataset.view); } catch (e) {}
        });
      });

      var peek = sec.querySelector('[data-peek]');
      if (!peek || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      var img = document.createElement('img');
      img.alt = '';
      peek.appendChild(img);
      list.addEventListener('pointermove', function (e) {
        var row = !list.classList.contains('is-grid') && e.target.closest('[data-peek-src]');
        if (!row) { peek.classList.remove('is-on'); return; }
        if (img.getAttribute('src') !== row.dataset.peekSrc) img.src = row.dataset.peekSrc;
        peek.style.left = (e.clientX + 150) + 'px';
        peek.style.top = e.clientY + 'px';
        peek.classList.add('is-on');
      });
      list.addEventListener('pointerleave', function () { peek.classList.remove('is-on'); });
      window.addEventListener('scroll', function () { peek.classList.remove('is-on'); }, { passive: true });
    }
    function init() { document.querySelectorAll('[data-k-clist]').forEach(setup); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "k-clist-section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Collec<em>tions</em>", "info": "Italic words use the accent font." },
    { "type": "checkbox", "id": "show_total", "label": "Show how many collections", "default": true },
    { "type": "collection_list", "id": "collection_list", "label": "Collections", "info": "Leave empty to list every collection." },
    { "type": "select", "id": "default_view", "label": "Default view", "options": [ { "value": "index", "label": "Index" }, { "value": "grid", "label": "Grid" } ], "default": "index", "info": "Shoppers can switch, and their choice is remembered." },
    { "type": "checkbox", "id": "show_description", "label": "Show descriptions in the index", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "medium", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "large", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ]
}
{% endschema %}
