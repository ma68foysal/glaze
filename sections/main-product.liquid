{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  # Drop mode: a future custom.drop_date locks the page until that moment.
  assign drop_locked = false
  assign drop_date = product.metafields.custom.drop_date.value
  if drop_date != blank
    assign drop_ts = drop_date | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    if drop_ts > now_ts
      assign drop_locked = true
      assign drop_iso = drop_date | date: '%Y-%m-%dT%H:%M:%S%z'
    endif
  endif
  assign is_pre = false
  if current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue'
    assign is_pre = true
  endif
  assign form_id = 'product-form-' | append: section.id
  assign featured = current_variant.featured_media | default: product.featured_media
  assign has_model = false
  for media in product.media
    if media.media_type == 'model'
      assign has_model = true
    endif
  endfor
  assign sale_off = 0
  if current_variant.compare_at_price > current_variant.price
    assign sale_off = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
  assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first
  assign models_block = section.blocks | where: 'type', 'models' | first
  assign color_index = 0
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_index = option.position
    endif
  endfor
-%}

<section class="k-pdp{% if drop_locked %} is-drop-locked{% endif %} k-section pt-{{ section.settings.padding_top }} pb-{{ section.settings.padding_bottom }} color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="k-wrap">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="k-pdp__crumbs k-label" aria-label="{{ 'products.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'products.home' | t }}</a>
        <span aria-hidden="true">/</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span aria-hidden="true">/</span>
        {%- elsif product.collections.size > 0 -%}
          {%- assign crumb_collection = product.collections | where: 'handle', 'frontpage' | first | default: product.collections.first -%}
          <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
          <span aria-hidden="true">/</span>
        {%- endif -%}
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <k-product class="k-pdp__grid k-pdp__grid--{{ section.settings.media_layout }}" data-form-id="{{ form_id }}">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="k-pdp__gallery{% if section.settings.image_zoom %} k-pdp__gallery--zoom{% endif %}" data-gallery>
        {%- if product.media.size > 1 and section.settings.media_layout == 'thumbnails' -%}
          <ul class="k-pdp__thumbs" role="list" aria-label="{{ 'product.gallery_thumbs_aria' | t }}" data-thumbs>
            {%- if featured != blank -%}
              {%- render 'k-product-thumb', media: featured, index: 1, active: true -%}
            {%- endif -%}
            {%- assign t = 1 -%}
            {%- for media in product.media -%}
              {%- if media.id == featured.id -%}{%- continue -%}{%- endif -%}
              {%- assign t = t | plus: 1 -%}
              {%- render 'k-product-thumb', media: media, index: t, active: false -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="k-pdp__stage">
        {%- if models_block and product.media.size > 1 -%}{%- render 'k-pdp-models', block: models_block, product: product -%}{%- endif -%}
        {%- if drop_locked -%}
          <div class="k-pdp__lock" aria-hidden="true"><span>{% render 'k-icon', icon: 'lock', size: 36 %}{{ 'products.drop.locked' | t }}</span></div>
        {%- endif -%}
        {%- if section.settings.show_sale_badge -%}
          <span class="k-pdp__sale k-label" data-sale-badge data-template="{{ 'products.sale_off' | t: percent: '[percent]' | escape }}"{% if sale_off == 0 %} hidden{% endif %}>{{ 'products.sale_off' | t: percent: sale_off }}</span>
        {%- endif -%}
        {%- if product.media.size > 0 -%}
          <ul class="k-pdp__media-list" role="list" aria-label="{{ 'product.gallery_thumbs_aria' | t }}">
            {%- if featured != blank -%}
              {%- render 'k-product-media', media: featured, position: 1, product: product, big: true, layout: section.settings.media_layout -%}
            {%- endif -%}
            {%- assign n = 1 -%}
            {%- for media in product.media -%}
              {%- if media.id == featured.id -%}{%- continue -%}{%- endif -%}
              {%- assign n = n | plus: 1 -%}
              {%- render 'k-product-media', media: media, position: n, product: product, big: false, layout: section.settings.media_layout -%}
            {%- endfor -%}
          </ul>
          {%- if product.media.size > 1 -%}
            <p class="k-pdp__media-count k-label" aria-hidden="true"><span data-media-index>1</span> / {{ product.media.size }}{% if section.settings.image_zoom %}<span class="k-pdp__zoom-hint"> · {{ 'product.click_to_zoom' | t }}</span>{% endif %}</p>
            {%- comment -%} Arrows: always in the thumbnails layout; on the phone slider only for mouse users. {%- endcomment -%}
            <button type="button" class="k-pdp__arrow k-pdp__arrow--prev" data-media-step="-1" aria-label="{{ 'product.media_prev' | t }}">
              <span style="display: inline-flex; transform: rotate(180deg);">{% render 'k-icon', icon: 'arrow', size: 18 %}</span>
            </button>
            <button type="button" class="k-pdp__arrow k-pdp__arrow--next" data-media-step="1" aria-label="{{ 'product.media_next' | t }}">
              {% render 'k-icon', icon: 'arrow', size: 18 %}
            </button>
          {%- endif -%}
        {%- else -%}
          <ul class="k-pdp__media-list" role="list">
            <li class="k-pdp__media k-pdp__media--big"><div class="k-media">{{ 'product-1' | placeholder_svg_tag: 'k-ph' }}</div></li>
            <li class="k-pdp__media"><div class="k-media">{{ 'product-2' | placeholder_svg_tag: 'k-ph' }}</div></li>
            <li class="k-pdp__media"><div class="k-media">{{ 'product-3' | placeholder_svg_tag: 'k-ph' }}</div></li>
          </ul>
        {%- endif -%}
        </div>
      </div>

      {%- comment -%} Info column — every element is a block {%- endcomment -%}
      <div class="k-pdp__info{% if section.settings.sticky_info %} k-pdp__info--sticky{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'badge' -%}
              <div class="k-pdp__badge-row" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  <span class="k-pdp__badge k-label">{{ block.settings.text }}</span>
                {%- else -%}
                  <span></span>
                {%- endif -%}
                {%- if block.settings.show_sku -%}
                  <span class="k-label k-muted" data-sku {% if current_variant.sku == blank %}hidden{% endif %}>{{ 'products.sku' | t }} <span data-sku-value>{{ current_variant.sku }}</span></span>
                {%- endif -%}
              </div>

            {%- when 'title' -%}
              <h1 class="k-pdp__title k-h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="k-pdp__price-wrap" {{ block.shopify_attributes }}>
                <div class="k-pdp__price-row">
                  <div class="k-pdp__price" data-price>
                    {%- render 'k-price', variant: current_variant -%}
                  </div>
                  {%- if block.settings.show_savings -%}
                    {%- liquid
                      assign saved = 0
                      if current_variant.compare_at_price > current_variant.price
                        assign saved = current_variant.compare_at_price | minus: current_variant.price
                      endif
                      assign saved_money = saved | money
                    -%}
                    <span class="k-pdp__save k-label" data-save data-template="{{ 'products.save_amount' | t: amount: '[amount]' | escape }}"{% if saved == 0 %} hidden{% endif %}>{{ 'products.save_amount' | t: amount: saved_money }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_tax_note -%}
                  <p class="k-pdp__tax k-label k-muted">
                    {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                      {{ 'product.tax_included_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'product.tax_included' | t }}
                    {%- elsif shop.shipping_policy.body != blank -%}
                      {{ 'products.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="k-pdp__desc k-rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="k-pdp__text k-rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <k-variant-picker class="k-pdp__options" data-form-id="{{ form_id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- assign is_color = false -%}
                    {%- if option.position == color_index -%}{%- assign is_color = true -%}{%- endif -%}
                    <fieldset class="k-pdp__option" data-option-position="{{ option.position }}">
                      <div class="k-pdp__option-head">
                        <legend class="k-label">{{ option.name }} — <strong data-option-selected>{{ option.selected_value }}</strong></legend>
                        {%- if forloop.last and block.settings.size_guide != blank -%}
                          <k-modal class="k-pdp__guide-modal">
                            <details>
                              <summary class="k-label k-pdp__guide">{{ 'products.size_guide' | t }}</summary>
                              <button type="button" class="k-modal__scrim" data-modal-close tabindex="-1" aria-hidden="true"></button>
                              <div class="k-modal__panel k-pdp__guide-panel color-{{ section.settings.color_scheme }}" role="dialog" aria-modal="true" aria-labelledby="{{ form_id }}-guide">
                                <div class="k-pdp__guide-head">
                                  <h2 class="k-h4" id="{{ form_id }}-guide">{{ block.settings.size_guide.title }}</h2>
                                  <button type="button" class="k-icon-btn" data-modal-close data-modal-focus aria-label="{{ 'products.close_size_guide' | t }}">{% render 'k-icon', icon: 'close', size: 22 %}</button>
                                </div>
                                <div class="k-rte k-pdp__guide-body">{{ block.settings.size_guide.content }}</div>
                              </div>
                            </details>
                          </k-modal>
                        {%- endif -%}
                      </div>
                      <div class="k-pdp__values{% if is_color %} k-pdp__values--swatch{% endif %}">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = form_id | append: '-' | append: option.position | append: '-' | append: forloop.index
                            assign swatch_style = ''
                            if is_color
                              if value.swatch.image
                                assign swatch_url = value.swatch.image | image_url: width: 88
                                assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                              elsif value.swatch.color
                                assign swatch_style = '--swatch: ' | append: value.swatch.color | append: ';'
                              else
                                assign swatch_style = '--swatch: ' | append: value | downcase | append: ';'
                              endif
                            endif
                          -%}
                          {%- if value.product_url != blank and value.product_url != product.url -%}
                            <a
                              class="{% if is_color %}k-pdp__swatch{% else %}k-pdp__size{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                              href="{{ value.product_url }}"
                              {% if is_color %}style="{{ swatch_style }}" title="{{ value | escape }}"{% endif %}
                            >
                              {%- if is_color -%}<span class="visually-hidden">{{ value }}</span>{%- else -%}{{ value }}{%- endif -%}
                            </a>
                          {%- else -%}
                          <input
                            class="visually-hidden"
                            type="radio"
                            id="{{ input_id }}"
                            name="option-{{ section.id }}-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if value.selected %}checked{% endif %}
                            data-option-value
                          >
                          <label
                            for="{{ input_id }}"
                            class="{% if is_color %}k-pdp__swatch{% else %}k-pdp__size{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                            {% if is_color %}style="{{ swatch_style }}" title="{{ value | escape }}"{% endif %}
                          >
                            {%- if is_color -%}
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              {{ value }}
                            {%- endif -%}
                            <span class="visually-hidden k-pdp__oos-text"{% if value.available %} hidden{% endif %}>, {{ 'products.sold_out' | t }}</span>
                          </label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  {%- render 'k-variant-json', product: product -%}
                </k-variant-picker>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="k-pdp__buy" {{ block.shopify_attributes }}>
                {%- if drop_locked -%}
                  {%- render 'k-pdp-drop', product: product, drop_iso: drop_iso, form_id: form_id -%}
                {%- endif -%}
                <skinova-product-form{% if drop_locked %} data-unlock-target="{{ form_id }}" hidden{% endif %}>
                  {%- form 'product', product, id: form_id, novalidate: 'novalidate', class: 'k-pdp__form' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

                    {%- if product.selling_plan_groups.size > 0 -%}
                      <fieldset class="k-pdp__plans">
                        <legend class="k-label">{{ 'product.purchase_options' | t }}</legend>
                        {%- unless product.requires_selling_plan -%}
                          <label class="k-pdp__plan"><input type="radio" name="selling_plan" value="" checked> {{ 'product.one_time_purchase' | t }}</label>
                        {%- endunless -%}
                        {%- for group in product.selling_plan_groups -%}
                          {%- for plan in group.selling_plans -%}
                            <label class="k-pdp__plan"><input type="radio" name="selling_plan" value="{{ plan.id }}"{% if product.requires_selling_plan and forloop.parentloop.first and forloop.first %} checked{% endif %}> {{ plan.name }}</label>
                          {%- endfor -%}
                        {%- endfor -%}
                      </fieldset>
                    {%- endif -%}

                    {%- if product.gift_card? -%}
                      <details class="k-pdp__gift">
                        <summary>
                          <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" value="on" aria-label="{{ 'product.gift_send_to_recipient' | t }}">
                          {{ 'product.gift_send_to_recipient' | t }}
                        </summary>
                        <div class="k-pdp__gift-fields">
                          <label for="{{ form_id }}-gift-name">{{ 'product.gift_recipient_name' | t }}</label>
                          <input type="text" id="{{ form_id }}-gift-name" name="properties[Recipient name]" autocomplete="name">
                          <label for="{{ form_id }}-gift-email">{{ 'product.gift_recipient_email' | t }}</label>
                          <input type="email" id="{{ form_id }}-gift-email" name="properties[Recipient email]" autocomplete="email">
                          <label for="{{ form_id }}-gift-message">{{ 'product.gift_message' | t }}</label>
                          <textarea id="{{ form_id }}-gift-message" name="properties[Message]" maxlength="200" rows="3"></textarea>
                          <label for="{{ form_id }}-gift-send-on">{{ 'product.gift_send_on' | t }}</label>
                          <input type="date" id="{{ form_id }}-gift-send-on" name="properties[Send on]">
                        </div>
                      </details>
                    {%- endif -%}

                    <p class="k-pdp__pre k-label" data-preorder{% unless is_pre %} hidden{% endunless %}>{{ 'products.preorder_note' | t }}</p>
                    <div class="k-pdp__actions">
                      {%- if block.settings.show_quantity -%}
                        <div class="k-pdp__qty">
                          <label for="{{ form_id }}-qty" class="visually-hidden">{{ 'product.quantity' | t }}</label>
                          <button type="button" aria-label="{{ 'product.qty_decrease' | t }}" data-qty-step="-1">−</button>
                          <input type="number" id="{{ form_id }}-qty" name="quantity" value="1" min="1" inputmode="numeric">
                          <button type="button" aria-label="{{ 'product.qty_increase' | t }}" data-qty-step="1">+</button>
                        </div>
                      {%- endif -%}
                      <button
                        type="submit"
                        name="add"
                        class="k-btn k-btn--primary k-btn--block k-pdp__atc"
                        data-atc
                        data-label-add="{{ 'products.add_to_cart' | t }}"
                        data-label-preorder="{{ 'products.preorder' | t }}"
                        data-label-sold-out="{{ 'products.sold_out' | t }}"
                        data-label-unavailable="{{ 'products.unavailable' | t }}"
                        {% unless current_variant.available %}disabled{% endunless %}
                      >
                        <span data-atc-text>
                          {%- if current_variant.available and is_pre -%}
                            {{ 'products.preorder' | t }} — {{ current_variant.price | money }}
                          {%- elsif current_variant.available -%}
                            {{ 'products.add_to_cart' | t }} — {{ current_variant.price | money }}
                          {%- else -%}
                            {{ 'products.sold_out' | t }}
                          {%- endif -%}
                        </span>
                      </button>
                    </div>

                    {%- if block.settings.show_dynamic_checkout -%}
                      <div class="k-pdp__dynamic">{{ form | payment_button }}</div>
                    {%- endif -%}
                    <div class="k-pdp__terms">{{ form | payment_terms }}</div>
                  {%- endform -%}
                </skinova-product-form>
                {%- render 'pickup-availability', current_variant: current_variant, section: section, product: product -%}
              </div>

            {%- when 'trust' -%}
              <ul class="k-pdp__trust" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}<li class="k-label">{{ block.settings.item_1 }}</li>{%- endif -%}
                {%- if block.settings.item_2 != blank -%}<li class="k-label">{{ block.settings.item_2 }}</li>{%- endif -%}
                {%- if block.settings.item_3 != blank -%}<li class="k-label">{{ block.settings.item_3 }}</li>{%- endif -%}
              </ul>

            {%- when 'collapsible' -%}
              <details class="k-pdp__acc" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="k-pdp__acc-head">
                  <span>{{ block.settings.heading }}</span>
                  {% render 'k-icon', icon: 'plus', size: 18 %}
                </summary>
                <div class="k-pdp__acc-body k-rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>

            {%- when 'fit' -%}

              {%- render 'k-pdp-fit', block: block, product: product, form_id: form_id -%}

            {%- when 'models' -%}
              {%- comment -%} Rendered over the gallery, above. {%- endcomment -%}

            {%- when 'material' -%}

              {%- render 'k-pdp-material', block: block -%}

            {%- when 'cost_per_wear' -%}

              {%- render 'k-pdp-cpw', block: block, variant: current_variant -%}

            {%- when 'inventory' -%}

              {%- render 'k-pdp-inventory', block: block, variant: current_variant -%}

            {%- when 'complementary' -%}

              {%- render 'k-pdp-complementary', block: block, product: product, section: section, recommendations: recommendations -%}

            {%- when 'share' -%}
              <div class="k-pdp__share" {{ block.shopify_attributes }}>
                <button type="button" class="k-pdp__share-btn" data-share data-url="{{ shop.url | append: product.url }}" data-title="{{ product.title | escape }}" data-label-copied="{{ 'general.link_copied' | t }}">
                  {%- render 'k-icon', icon: 'arrow-up-right', size: 18 -%}
                  <span data-share-text>{{ block.settings.label }}</span>
                </button>
              </div>

            {%- when 'custom_liquid' -%}
              <div class="k-pdp__liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </k-product>
  </div>
</section>

{%- if section.settings.sticky_atc and buy_block and drop_locked == false -%}
  <div class="k-pdp__bar color-{{ section.settings.color_scheme }}" data-sticky-atc data-form-id="{{ form_id }}" aria-hidden="true" inert>
    <div class="k-wrap k-pdp__bar-in">
      {%- if featured -%}
        {{ featured.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'k-pdp__bar-img', width: 48, height: 60 }}
      {%- endif -%}
      <div class="k-pdp__bar-name">
        <p>{{ product.title }}</p>
        {%- unless product.has_only_default_variant -%}<p class="k-label k-muted" data-bar-variant>{{ current_variant.title }}</p>{%- endunless -%}
      </div>
      <span class="k-pdp__bar-price" data-bar-price>{{ current_variant.price | money }}</span>
      <button type="button" class="k-btn k-btn--primary" data-bar-atc{% unless current_variant.available %} disabled{% endunless %}>
        <span data-bar-text>{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
      </button>
    </div>
  </div>
{%- endif -%}

{%- if has_model -%}
  <script type="module" src="{{ 'model-viewer.min.js' | asset_url }}"></script>
  <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
{%- endif -%}

{%- comment -%} Structured data for search engines {%- endcomment -%}
<script type="application/ld+json">{{ product | structured_data }}</script>

{% stylesheet %}
  .k-pdp { --pt: 0.2; }
  .k-pdp__crumbs { display: flex; flex-wrap: wrap; gap: 10px; padding-bottom: 20px; color: var(--color-muted); }
  .k-pdp__crumbs a:hover { color: var(--color-text); }
  .k-pdp__grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 56px; align-items: start; }

  /* Gallery: editorial = one wide image then a 2-up grid; stacked = one column */
  .k-pdp__media-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .k-pdp__grid--stacked .k-pdp__media-list { grid-template-columns: 1fr; }
  .k-pdp__media { position: relative; min-width: 0; animation: k-rise-in 0.9s var(--ease-out) both; animation-delay: calc(var(--pos, 1) * 0.08s); }
  .k-pdp__media > .k-media, .k-pdp__media > .k-pdp__media-frame { aspect-ratio: 3 / 4; border-radius: calc(var(--radius-card) * 0.25); overflow: hidden; }
  .k-pdp__media--big { grid-column: 1 / -1; }
  .k-pdp__media--big > .k-media, .k-pdp__media--big > .k-pdp__media-frame { aspect-ratio: 4 / 3; }
  .k-pdp__grid--stacked .k-pdp__media > .k-media { aspect-ratio: 4 / 5; }
  .k-pdp__media .k-media img { transition: transform 1.2s var(--ease-out); }
  .k-pdp__media:hover .k-media img { transform: scale(1.04); }
  .k-pdp__media-frame { position: relative; background: rgba(var(--color-text-rgb), 0.06); }
  .k-pdp__media-frame > * { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .k-pdp__media-frame video { object-fit: cover; }
  .k-pdp__media-frame model-viewer { width: 100%; height: 100%; }
  .k-pdp__media-count { display: none; }
  .k-pdp__stage { position: relative; min-width: 0; }
  .k-pdp__sale { position: absolute; left: 14px; top: 14px; z-index: 2; padding: 6px 10px; background: var(--color-accent); color: var(--color-bg); pointer-events: none; }
  .k-pdp__zoom-hint { display: none; }

  /* Zoom on click (desktop, images only) */
  @media (min-width: 901px) {
    .k-pdp__gallery--zoom .k-pdp__media .k-media { cursor: zoom-in; }
    .k-pdp__gallery--zoom .k-pdp__media.is-zoomed .k-media { cursor: zoom-out; }
    .k-pdp__gallery--zoom .k-pdp__media.is-zoomed .k-media img { transform: scale(2.2); transform-origin: var(--zx, 50%) var(--zy, 50%); transition: transform 0.4s var(--ease-out); }
  }

  /* Thumbnails layout: one large item, arrows and a thumbnail strip */
  .k-pdp__grid--thumbnails .k-pdp__gallery { position: sticky; top: calc(var(--header-height, 0px) + 20px); display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 14px; align-items: start; }
  .k-pdp__grid--thumbnails .k-pdp__gallery:not(:has(.k-pdp__thumbs)) { grid-template-columns: minmax(0, 1fr); }
  .k-pdp__grid--thumbnails .k-pdp__media-count {
    display: block; position: absolute; right: 14px; bottom: 14px; z-index: 2; margin: 0;
    padding: 8px 12px; border-radius: 999px; background: var(--color-bg); color: var(--color-text);
    font-size: 12px; pointer-events: none;
  }
  .k-pdp__grid--thumbnails .k-pdp__zoom-hint { display: inline; }
  .k-pdp__grid--thumbnails .k-pdp__arrow { top: calc(50% - 24px); }
  .k-pdp__grid--thumbnails .k-pdp__media-list { display: grid; grid-template-columns: 1fr; }
  .k-pdp__grid--thumbnails .k-pdp__media { grid-area: 1 / 1; visibility: hidden; opacity: 0; animation: none; transition: opacity var(--dur) var(--ease-out), visibility var(--dur); }
  .k-pdp__grid--thumbnails .k-pdp__media.is-active { visibility: visible; opacity: 1; }
  .k-pdp__grid--thumbnails .k-pdp__media > .k-media,
  .k-pdp__grid--thumbnails .k-pdp__media > .k-pdp__media-frame { aspect-ratio: 4 / 5; border-radius: calc(var(--radius-card) * 0.25); }
  .k-pdp__arrow {
    display: none;
    position: absolute; top: calc(50% - 60px); z-index: 2;
    place-items: center;
    width: 48px; height: 48px;
    border: 1px solid var(--color-line); border-radius: 999px;
    background: var(--color-bg); color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  .k-pdp__arrow:hover { background: var(--color-text); color: var(--color-bg); }
  .k-pdp__arrow--prev { left: 16px; }
  .k-pdp__arrow--next { right: 16px; }
  .k-pdp__thumbs { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; max-height: calc(100vh - var(--header-height, 0px) - 40px); overflow-y: auto; scrollbar-width: none; }
  .k-pdp__thumbs::-webkit-scrollbar { display: none; }
  .k-pdp__thumb {
    position: relative; flex: none;
    width: 88px; aspect-ratio: 4 / 5;
    padding: 0; overflow: hidden;
    border: 1.5px solid transparent; border-radius: calc(var(--radius-card) * 0.15);
    background: rgba(var(--color-text-rgb), 0.06);
    cursor: pointer;
    transition: border-color var(--dur-fast);
  }
  .k-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .k-pdp__thumb:hover { border-color: var(--color-line); }
  .k-pdp__thumb[aria-current="true"] { border-color: var(--color-text); }
  .k-pdp__thumb-badge { position: absolute; right: 4px; bottom: 4px; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 999px; background: var(--color-bg); color: var(--color-text); }

  /* Info column */
  .k-pdp__info { display: flex; flex-direction: column; gap: 26px; min-width: 0; }
  .k-pdp__info--sticky { position: sticky; top: calc(var(--header-height) + 24px); }
  .k-pdp__badge-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .k-pdp__badge { padding: 6px 10px; background: var(--color-text); color: var(--color-bg); }
  .k-pdp__title { font-size: calc(clamp(44px, 5.4vw, 84px) * var(--heading-scale)); line-height: 0.9; overflow-wrap: anywhere; }
  .k-pdp__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; font-size: 26px; font-weight: 700; }
  .k-pdp__price s { font-size: 18px; font-weight: 400; color: var(--color-muted); }
  .k-pdp__price .k-price__unit { flex-basis: 100%; font-size: 14px; font-weight: 400; color: var(--color-muted); }
  .k-pdp__price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .k-pdp__save { color: var(--color-accent); }
  .k-pdp__tax { margin: 8px 0 0; }
  .k-pdp__tax a { text-decoration: underline; text-underline-offset: 3px; }
  .k-pdp__desc, .k-pdp__text { max-width: 480px; font-size: 17px; line-height: 1.55; color: rgba(var(--color-text-rgb), 0.85); }

  .k-pdp__guide { text-decoration: underline; text-underline-offset: 3px; }

  .k-pdp__stock { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 14px; font-weight: 600; }
  .k-pdp__stock i { width: 8px; height: 8px; border-radius: 999px; background: #1F7A4D; }
  .k-pdp__stock i.is-low { background: #C2410C; animation: k-blink 1.6s ease-in-out infinite; }
  @keyframes k-blink { 50% { opacity: 0.25; } }

  .k-pdp__pairs:not(:has(li)) { display: none; }
  .k-pdp__pairs-head { margin: 0 0 12px; }
  .k-pdp__pairs-list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .k-pdp__pair { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px; border: 1px solid var(--color-line); border-radius: 14px; background: var(--color-surface); }
  .k-pdp__pair-img { display: block; width: 64px; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; background: rgba(var(--color-text-rgb), 0.06); }
  .k-pdp__pair-img img, .k-pdp__pair-img svg { width: 100%; height: 100%; object-fit: cover; }
  .k-pdp__pair-name { font-weight: 600; }
  .k-pdp__pair-price { margin: 4px 0 0; font-size: 14px; }
  .k-pdp__pair-add {
    position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px;
    border: 1.5px solid var(--color-text); border-radius: 999px; background: transparent; color: var(--color-text);
    font: 600 13px var(--font-body); cursor: pointer; transition: background-color var(--dur-fast), color var(--dur-fast);
    --spin: var(--color-text);
  }
  .k-pdp__pair-add:hover { background: var(--color-text); color: var(--color-bg); --spin: var(--color-bg); }

  .k-pdp__share-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0; border: 0; background: none; color: inherit; font: 600 14px var(--font-body); cursor: pointer; }
  .k-pdp__share-btn:hover span { text-decoration: underline; text-underline-offset: 3px; }

  .k-pdp__guide-modal summary { list-style: none; cursor: pointer; }
  .k-pdp__guide-modal summary::-webkit-details-marker { display: none; }
  .k-pdp__guide-panel {
    left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: min(640px, calc(100% - 32px)); max-height: calc(100vh - 64px); overflow-y: auto;
    padding: 28px; border-radius: 24px; background: var(--color-bg); color: var(--color-text);
  }
  .k-pdp__guide-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px; }
  .k-pdp__guide-body table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .k-pdp__guide-body th, .k-pdp__guide-body td { padding: 12px 8px; border-bottom: 1px solid var(--color-line); text-align: left; }
  .k-pdp__guide-body th { font-family: var(--font-label); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }

  .k-pdp__buy { display: flex; flex-direction: column; gap: 10px; }
  .k-pdp__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .k-pdp__qty { display: inline-flex; flex: none; align-items: center; min-height: 56px; border: 1.5px solid rgba(var(--color-text-rgb), 0.2); border-radius: 999px; }
  .k-pdp__qty button { width: 48px; height: 52px; border: 0; background: none; color: inherit; font: 500 18px var(--font-body); cursor: pointer; }
  .k-pdp__qty input { width: 36px; border: 0; background: none; color: inherit; font: 600 15px var(--font-body); text-align: center; -moz-appearance: textfield; }
  .k-pdp__qty input::-webkit-outer-spin-button, .k-pdp__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .k-pdp__dynamic .shopify-payment-button__button { min-height: 56px; border-radius: var(--radius-button); overflow: hidden; }
  .k-pdp__dynamic .shopify-payment-button__button--unbranded {
    background: var(--color-text); color: var(--color-bg);
    border: 1.5px solid var(--color-text);
    font: 600 16px var(--font-body);
  }
  .k-pdp__dynamic .shopify-payment-button__button--unbranded:hover:not([disabled]) { background: var(--color-text); color: var(--color-bg); opacity: 0.88; }
  .k-pdp__dynamic .shopify-payment-button__more-options { margin-top: 10px; color: var(--color-text); font-size: 14px; text-decoration: underline; }
  .k-pdp__terms:empty { display: none; }
  .k-pdp__gift summary { display: flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; }
  .k-pdp__gift-fields { display: grid; gap: 6px; padding-top: 8px; }
  .k-pdp__gift-fields input, .k-pdp__gift-fields textarea { min-height: 44px; padding: 10px 12px; border: 1px solid var(--color-line); border-radius: calc(var(--radius-card) * 0.4); background: transparent; color: inherit; font: inherit; }

  .k-pdp__trust { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .k-pdp__trust li { padding: 14px; border: 1px solid var(--color-line); border-radius: calc(var(--radius-card) * 0.5); line-height: 1.5; }

  .k-pdp__info > .k-pdp__acc:first-of-type, .k-pdp__acc + .k-pdp__acc { margin-top: -26px; }
  .k-pdp__info > :not(.k-pdp__acc) + .k-pdp__acc { margin-top: 0; }
  .k-pdp__acc { border-top: 1px solid var(--color-line); }
  .k-pdp__acc:last-child { border-bottom: 1px solid var(--color-line); }
  .k-pdp__acc-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 60px; font-weight: 600; font-size: 16px; list-style: none; cursor: pointer; }
  .k-pdp__acc-head::-webkit-details-marker { display: none; }
  .k-pdp__acc-head .k-icon { flex: none; transition: transform var(--dur) var(--ease-out); }
  .k-pdp__acc[open] .k-pdp__acc-head .k-icon { transform: rotate(45deg); }
  .k-pdp__acc-body { padding-bottom: 20px; font-size: 15px; color: var(--color-muted); }
  .k-pdp__acc[open] .k-pdp__acc-body { animation: k-rise-in 0.45s var(--ease-out) both; }

  .mp__pickup { margin-top: 6px; padding: 16px; border-radius: 14px; background: var(--color-surface); font-size: 14px; line-height: 1.5; }
  .mp__pickup:empty { display: none; }

  .k-pdp__bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    border-top: 1px solid var(--color-line); background: var(--color-bg); color: var(--color-text);
    box-shadow: 0 -20px 40px -30px rgba(14, 14, 14, 0.5);
    transform: translateY(105%); transition: transform 0.5s var(--ease-out);
  }
  .k-pdp__bar.is-visible { transform: none; }
  .k-pdp__bar-in { display: flex; align-items: center; gap: 16px; min-height: 80px; }
  .k-pdp__bar-img { width: 48px; height: 60px; object-fit: cover; border-radius: 6px; }
  .k-pdp__bar-name { flex: 1; min-width: 0; }
  .k-pdp__bar-name p { margin: 0; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .k-pdp__bar-name .k-label { margin-top: 4px; font-weight: 400; }
  .k-pdp__bar-price { margin-left: auto; font-size: 20px; font-weight: 700; }
  .mp__pickup-status { display: flex; gap: 8px; align-items: flex-start; margin: 4px 0 0; }
  .mp__pickup-status--unavailable { color: var(--color-muted); }
  .mp__pickup-details summary { cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .k-pdp__grid { grid-template-columns: 1fr; gap: 28px; }
    .k-pdp__info--sticky { position: static; }
    /* Gallery becomes a swipe slider */
    .k-pdp__gallery { position: relative; margin-inline: calc(var(--gutter) * -1); }
    .k-pdp__media-list {
      display: flex; gap: 8px;
      padding-inline: var(--gutter);
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .k-pdp__media-list::-webkit-scrollbar { display: none; }
    .k-pdp__media { flex: 0 0 86%; scroll-snap-align: center; }
    .k-pdp__media--big > .k-media, .k-pdp__media--big > .k-pdp__media-frame,
    .k-pdp__media > .k-media, .k-pdp__media > .k-pdp__media-frame { aspect-ratio: 4 / 5; }
    .k-pdp__media-count {
      display: block; position: absolute; right: calc(var(--gutter) + 12px); bottom: 12px;
      margin: 0; padding: 4px 10px; border-radius: 999px;
      background: var(--color-bg); color: var(--color-text);
    }
    .k-pdp__values { grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); }
    .k-pdp__grid--thumbnails .k-pdp__media-list { display: flex; }
    .k-pdp__grid--thumbnails .k-pdp__media { visibility: visible; opacity: 1; }
    .k-pdp__grid--thumbnails .k-pdp__gallery { position: relative; top: auto; display: flex; flex-direction: column; align-items: stretch; gap: 10px; }
    .k-pdp__grid--thumbnails .k-pdp__thumbs { order: 2; flex-direction: row; max-height: none; padding-inline: var(--gutter); overflow-x: auto; overflow-y: visible; }
    .k-pdp__grid--thumbnails .k-pdp__thumb { width: 64px; }
    .k-pdp__grid--thumbnails .k-pdp__media-count { right: calc(var(--gutter) + 12px); bottom: 12px; padding: 4px 10px; }
    .k-pdp__zoom-hint, .k-pdp__grid--thumbnails .k-pdp__zoom-hint { display: none; }
    .k-pdp__sale { left: calc(var(--gutter) + 12px); top: 12px; }
    .k-pdp__bar-name { display: none; }
    .k-pdp__bar-in { justify-content: space-between; }
    .k-pdp__media-list { cursor: grab; }
    .k-pdp__media-list.is-dragging { cursor: grabbing; scroll-snap-type: none; }
    .k-pdp__media-list.is-dragging img { pointer-events: none; }
  }
  /* Arrows: thumbnails layout on desktop; phone slider only for mouse users. */
  @media (min-width: 901px) { .k-pdp__grid--thumbnails .k-pdp__arrow { display: grid; } }
  @media (max-width: 900px) and (hover: hover) and (pointer: fine) {
    .k-pdp__arrow { display: grid; top: calc(50% - 24px); }
    .k-pdp__arrow--prev { left: calc(var(--gutter) + 8px); }
    .k-pdp__arrow--next { right: calc(var(--gutter) + 8px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "class": "k-pdp-section",
  "settings": [
    { "type": "select", "id": "media_layout", "label": "Media layout", "default": "editorial", "options": [ { "value": "editorial", "label": "Editorial grid" }, { "value": "thumbnails", "label": "Main image with thumbnails" }, { "value": "stacked", "label": "Single column" } ] },
    { "type": "checkbox", "id": "image_zoom", "label": "Zoom images on click", "default": true },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge on images", "default": true },
    { "type": "checkbox", "id": "sticky_info", "label": "Keep product details in view while scrolling", "default": true },
    { "type": "checkbox", "id": "sticky_atc", "label": "Show add to cart bar while scrolling", "default": true },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding_top", "label": "Top padding", "default": "small", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "default": "medium", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "badge",
      "name": "Label and SKU",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Label", "default": "New season" },
        { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": true }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_savings", "label": "Show amount saved", "default": true },
        { "type": "checkbox", "id": "show_tax_note", "label": "Show tax and shipping note", "default": true }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "text",
      "name": "Text",
      "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a short note, like fit advice or a care tip.</p>" } ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Options named Color or Colour show as swatches. Set swatch colors in Settings > Custom data > Variants, or the color name is used." },
        { "type": "page", "id": "size_guide", "label": "Size guide page", "info": "Opens in a window from a link next to the last option. Tables in the page are styled." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true, "info": "Lets customers check out directly with a familiar payment method." },
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true }
      ]
    },
    {
      "type": "trust",
      "name": "Service highlights",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "First highlight", "default": "Free shipping" },
        { "type": "text", "id": "item_2", "label": "Second highlight", "default": "30-day returns" },
        { "type": "text", "id": "item_3", "label": "Third highlight", "default": "Repairs included" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details and fit" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Describe the fit, materials or care.</p>" },
        { "type": "page", "id": "page", "label": "Page content", "info": "Shown after the content above." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "fit",
      "name": "Fit and size finder",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Connect these to product metafields (the database icon next to each setting) so every product shows its own fit." },
        { "type": "range", "id": "fit_scale", "label": "Fit", "min": 1, "max": 5, "step": 1, "default": 3, "info": "1 runs small, 3 true to size, 5 runs large." },
        { "type": "text", "id": "fit_text", "label": "Fit note", "default": "True to size" },
        { "type": "text", "id": "model_note", "label": "Model note", "info": "For example: Model is 178 cm and wears S." },
        { "type": "checkbox", "id": "show_finder", "label": "Show size finder", "default": true, "info": "Needs an option named Size and a size chart." },
        { "type": "textarea", "id": "size_chart", "label": "Size chart (height in cm)", "default": "XS: 150-160\nS: 158-168\nM: 166-176\nL: 174-184\nXL: 182-194", "info": "One size per line as Size: shortest-tallest. Size names must match the product's size option." }
      ]
    },
    {
      "type": "models",
      "name": "Model switcher",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows the piece on models of different builds. Connect Models to a multi-line text metafield (the database icon) so every product lists its own models." },
        { "type": "richtext", "id": "models", "label": "Models", "info": "One model per line or paragraph as Name | height | size worn | photo number, for example: Ana | 178 cm | S | 3. The photo number counts the product's media from 1. Needs at least two models to show." }
      ]
    },
    {
      "type": "material",
      "name": "Material lens",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Connect these to product metafields so every product shows its own fabric. The block hides when all of them are empty." },
