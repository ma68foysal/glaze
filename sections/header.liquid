{%- liquid
  assign menu = section.settings.menu
  assign account_menu = section.settings.customer_account_menu.handle | default: 'customer-account-main-menu'
  if section.settings.sticky
    assign sticky_class = ' k-header--sticky'
  endif
-%}

<header class="k-header color-{{ section.settings.color_scheme }}{{ sticky_class }}">
  <div class="k-wrap k-header__bar">
    <div class="k-header__left">
      {%- comment -%} Mobile menu drawer {%- endcomment -%}
      <k-modal class="k-header__menu-modal">
        <details>
          <summary class="k-icon-btn k-header__menu-btn" aria-label="{{ 'general.open_menu' | t }}">
            {% render 'k-icon', icon: 'menu', size: 24 %}
          </summary>
          <div class="k-modal__panel k-mmenu color-{{ section.settings.menu_color_scheme }}" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
            <div class="k-mmenu__top">
              <span class="k-header__wordmark">{{ shop.name }}</span>
              <button type="button" class="k-icon-btn" data-modal-close data-modal-focus aria-label="{{ 'general.close_menu' | t }}">
                {% render 'k-icon', icon: 'close', size: 24 %}
              </button>
            </div>
            <nav class="k-mmenu__nav" aria-label="{{ 'general.menu' | t }}">
              {%- for link in menu.links -%}
                {%- if link.links.size > 0 -%}
                  <details class="k-mmenu__group" style="--i: {{ forloop.index }}">
                    <summary class="k-mmenu__link">
                      {{ link.title }}
                      {% render 'k-icon', icon: 'plus', size: 22 %}
                    </summary>
                    <ul class="k-mmenu__sub" role="list">
                      <li><a href="{{ link.url }}" class="k-label">{{ 'general.view_all' | t }} — {{ link.title }}</a></li>
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a class="k-mmenu__link" href="{{ link.url }}" style="--i: {{ forloop.index }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </nav>
            {%- render 'localization-form', class_prefix: 'k-loc' -%}
          </div>
        </details>
      </k-modal>

      <nav class="k-header__nav" aria-label="{{ 'general.menu' | t }}">
        <ul class="k-header__list" role="list">
          {%- for link in menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <details class="k-dropdown">
                  <summary class="k-header__link">
                    <span>{{ link.title }}</span>
                    {% render 'k-icon', icon: 'chevron', size: 14 %}
                  </summary>
                  <div class="k-dropdown__panel color-{{ section.settings.color_scheme }}">
                    {%- assign has_grandchildren = false -%}
                    {%- for child in link.links -%}
                      {%- if child.links.size > 0 -%}{%- assign has_grandchildren = true -%}{%- endif -%}
                    {%- endfor -%}
                    {%- if has_grandchildren -%}
                      <div class="k-dropdown__cols">
                        {%- for child in link.links -%}
                          <div>
                            <a class="k-label k-dropdown__head" href="{{ child.url }}">{{ child.title }}</a>
                            <ul role="list">
                              {%- for grandchild in child.links -%}
                                <li><a class="k-link-underline" href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <ul class="k-dropdown__list" role="list">
                        {%- for child in link.links -%}
                          <li><a class="k-link-underline" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                    <a class="k-label k-dropdown__all" href="{{ link.url }}">{{ 'general.view_all' | t }} →</a>
                  </div>
                </details>
              {%- else -%}
                <a class="k-header__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <div class="k-header__brand">
      <a href="{{ routes.root_url }}" class="k-header__logo">
        {%- if section.settings.logo != blank -%}
          {%- liquid
            assign logo_w2 = section.settings.logo_width | times: 2
            assign logo_h = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round
          -%}
          {{
            section.settings.logo
            | image_url: width: logo_w2
            | image_tag:
              width: section.settings.logo_width,
              height: logo_h,
              alt: shop.name,
              style: 'width: var(--logo-width); height: auto;',
              loading: 'eager'
          }}
        {%- else -%}
          <span class="k-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="k-header__right">
      {%- if section.settings.show_search -%}
        <k-modal class="k-header__search-modal">
          <details>
            <summary class="k-icon-btn" aria-label="{{ 'general.search' | t }}">
              {% render 'k-icon', icon: 'search' %}
            </summary>
            <div class="k-modal__panel k-search color-{{ section.settings.color_scheme }}" role="dialog" aria-modal="true" aria-label="{{ 'general.search' | t }}">
              <form action="{{ routes.search_url }}" method="get" role="search" class="k-wrap k-search__form">
                <label for="k-search-{{ section.id }}" class="visually-hidden">{{ 'general.search' | t }}</label>
                <input
                  id="k-search-{{ section.id }}"
                  class="k-search__input"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="{{ 'general.search_placeholder' | t }}"
                  autocomplete="off"
                  data-modal-focus
                >
                <input type="hidden" name="options[prefix]" value="last">
                <button type="submit" class="k-btn k-btn--primary">{{ 'general.search' | t }}</button>
                <button type="button" class="k-icon-btn" data-modal-close aria-label="{{ 'general.close' | t }}">
                  {% render 'k-icon', icon: 'close', size: 24 %}
                </button>
              </form>
            </div>
            <button type="button" class="k-modal__scrim" data-modal-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
          </details>
        </k-modal>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <div class="k-header__account">
          <shopify-account menu="{{ account_menu }}"></shopify-account>
        </div>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" id="cart-icon-bubble" class="k-icon-btn k-header__cart">
        {%- render 'cart-icon-bubble' -%}
      </a>
    </div>
  </div>
</header>

<style>
  #shopify-section-{{ section.id }} { --logo-width: {{ section.settings.logo_width }}px; }
</style>

{% stylesheet %}
  .shopify-section-group-header-group:has(.k-header--sticky) { position: sticky; top: 0; z-index: 30; }
  .k-header { position: relative; transition: box-shadow var(--dur) var(--ease-out); }
  .k-header.is-scrolled { box-shadow: 0 1px 0 var(--color-line); }
  .k-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    column-gap: 24px;
    align-items: center;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-line);
  }
  .k-header.is-scrolled .k-header__bar { border-bottom-color: transparent; }
  .k-header__left { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .k-header__right { display: flex; justify-content: flex-end; align-items: center; gap: 4px; }
  .k-header__brand { margin: 0; font-size: inherit; line-height: 1; }
  .k-header__logo { display: block; }
  .k-header__wordmark {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight-black);
    font-size: 26px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: letter-spacing var(--dur-slow) var(--ease-out);
  }
  .k-header__logo:hover .k-header__wordmark { letter-spacing: 0.06em; }

  .k-header__list { display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; white-space: nowrap; }
  @media (max-width: 1280px) { .k-header__list { gap: 20px; } }
  .k-header__link {
    position: relative;
    display: inline-flex; align-items: center; gap: 6px;
    min-height: var(--touch);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .k-header__link::-webkit-details-marker { display: none; }
  .k-header__link > span { position: relative; }
  .k-header__link > span::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 1.5px;
    background: currentColor;
    transform: scaleX(0); transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .k-header__link:hover > span::after, .k-header__link[aria-current] > span::after, .k-dropdown[open] .k-header__link > span::after { transform: scaleX(1); transform-origin: left; }
  .k-dropdown { position: relative; }
  .k-dropdown[open] .k-header__link .k-icon { transform: rotate(180deg); }
  .k-dropdown__panel {
    position: absolute; left: -24px; top: calc(100% + 14px); z-index: 20;
    min-width: 240px;
    padding: 24px;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-card) * 0.5);
    box-shadow: 0 30px 60px -30px rgba(var(--color-text-rgb), 0.35);
    animation: k-rise-in 0.4s var(--ease-out) both;
  }
  .k-dropdown__cols { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(160px, 1fr); gap: 32px; }
  .k-dropdown__panel ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .k-dropdown__panel ul a { display: inline-block; padding: 6px 0; font-size: 15px; }
  .k-dropdown__head { display: block; margin-bottom: 10px; color: var(--color-muted); }
  .k-dropdown__all { display: inline-block; margin-top: 18px; }

  .k-header__menu-modal { display: none; }
  .k-header__menu-btn, .k-header .k-icon-btn { list-style: none; }
  .k-header summary::-webkit-details-marker { display: none; }

  .k-header__cart { position: relative; }
  .k-header__cart .k-bubble { margin-left: 2px; }
  .k-header__cart-icon { display: none; }
  .k-header__cart-label { font-size: var(--text-sm); font-weight: 500; }
  .k-header__account { display: flex; align-items: center; min-height: var(--touch); }
  .k-header__account shopify-account {
    --shopify-account-signed-in-avatar-size: 32px;
    --shopify-account-signed-in-avatar-color-background: var(--color-accent);
    --shopify-account-signed-in-avatar-color-text: var(--color-bg);
  }

  /* Modals */
  .k-search { inset: 0 0 auto 0; padding: 20px 0; border-bottom: 1px solid var(--color-line); animation: k-fade 0.3s both; }
  .k-search__form { display: flex; align-items: center; gap: 12px; }
  .k-search__input {
    flex: 1; min-width: 0; min-height: 56px;
    border: 0; border-bottom: 1.5px solid currentColor;
    background: transparent; color: inherit;
    font: 500 clamp(20px, 2.4vw, 32px) var(--font-body);
  }
  .k-search__input:focus-visible { outline: none; border-bottom-color: var(--color-accent); }

  .k-mmenu { inset: 0; display: flex; flex-direction: column; gap: 8px; padding: 20px var(--gutter) 32px; overflow-y: auto; animation: k-fade 0.3s both; }
  .k-mmenu__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .k-mmenu__nav { display: flex; flex-direction: column; }
  .k-mmenu__link {
    display: flex; justify-content: space-between; align-items: center;
    padding: 6px 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: clamp(40px, 11vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    list-style: none;
    cursor: pointer;
    animation: k-rise-in 0.6s var(--ease-out) both;
    animation-delay: calc(var(--i, 1) * 0.05s);
  }
  .k-mmenu__group[open] .k-mmenu__link .k-icon { transform: rotate(45deg); }
  .k-mmenu__sub { margin: 4px 0 16px; padding: 0; list-style: none; display: grid; gap: 4px; }
  .k-mmenu__sub a { display: block; padding: 8px 0; font-size: 18px; }
  .k-loc__form { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 32px; }
  .k-loc__select {
    min-height: var(--touch); padding: 0 16px;
    border: 1px solid var(--color-line); border-radius: 999px;
    background: transparent; color: inherit; font: inherit; font-size: var(--text-sm);
  }

  @media (max-width: 1100px) {
    .k-header__nav { display: none; }
    .k-header__menu-modal { display: block; }
    .k-header__bar { grid-template-columns: auto 1fr auto; }
    .k-header__brand { justify-self: center; }
  }
  @media (max-width: 900px) {
    .k-header__wordmark { font-size: 22px; }
    .k-header__cart-label { display: none; }
    .k-header__cart-icon { display: inline-flex; }
    .k-header__cart .k-bubble { position: absolute; top: 4px; right: 0; min-width: 18px; height: 18px; padding: 0 5px; font-size: 11px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "k-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Your store name is shown when no logo is added." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 4, "unit": "px", "default": 120 },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "link_list", "id": "customer_account_menu", "label": "Customer account menu", "default": "customer-account-main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "sticky", "label": "Stick header to top on scroll", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Header", "default": "scheme-1" },
    { "type": "color_scheme", "id": "menu_color_scheme", "label": "Mobile menu", "default": "scheme-2" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
