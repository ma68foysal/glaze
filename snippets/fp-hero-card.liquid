{%- comment -%}
  Featured product — hero card.

  Used by sections/featured-product.liquid as the editor's-pick card
  (one per tab). Larger 3:4 aspect, eyebrow + display title + price +
  outlined CTA, full-bleed image with subtle gradient overlay so the
  text stays legible regardless of the product photo.

  Inputs:
    product : Shopify product drop (required)
    section : the calling section
    block   : the calling tab block (used for hero_position label only)
{%- endcomment -%}

{%- assign primary = product.featured_image -%}
{%- assign secondary = nil -%}
{%- if product.images.size > 1 -%}
  {%- assign secondary = product.images[1] -%}
{%- endif -%}

{%- assign is_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign is_sale = true -%}
  {%- assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
{%- endif -%}

{%- assign is_new = false -%}
{%- assign is_hot = false -%}
{%- if product.tags contains 'new' or product.tags contains 'New' -%}{%- assign is_new = true -%}{%- endif -%}
{%- if product.tags contains 'hot' or product.tags contains 'Selling fast' or product.tags contains 'selling-fast' -%}{%- assign is_hot = true -%}{%- endif -%}

{%- assign has_variants = false -%}
{%- if product.variants.size > 1 or product.has_only_default_variant == false -%}{%- assign has_variants = true -%}{%- endif -%}

<article class="sfp-hero" data-product-handle="{{ product.handle }}">
  <a href="{{ product.url }}" class="sfp-hero__media" aria-label="{{ product.title | escape }}">
    {%- if primary -%}
      <img
        class="sfp-hero__img is-primary"
        loading="lazy"
        src="{{ primary | image_url: width: 1600 }}"
        srcset="{{ primary | image_url: width: 600 }} 600w, {{ primary | image_url: width: 900 }} 900w, {{ primary | image_url: width: 1200 }} 1200w, {{ primary | image_url: width: 1600 }} 1600w, {{ primary | image_url: width: 2000 }} 2000w, {{ primary | image_url: width: 2400 }} 2400w"
        sizes="(min-width: 990px) 45vw, 100vw"
        alt="{{ primary.alt | default: product.title | escape }}"
        width="{{ primary.width }}"
        height="{{ primary.height }}"
      >
    {%- endif -%}
    {%- if secondary -%}
      <img
        class="sfp-hero__img is-secondary"
        loading="lazy"
        src="{{ secondary | image_url: width: 1600 }}"
        srcset="{{ secondary | image_url: width: 600 }} 600w, {{ secondary | image_url: width: 900 }} 900w, {{ secondary | image_url: width: 1200 }} 1200w, {{ secondary | image_url: width: 1600 }} 1600w, {{ secondary | image_url: width: 2000 }} 2000w"
        sizes="(min-width: 990px) 45vw, 100vw"
        alt=""
        aria-hidden="true"
        width="{{ secondary.width }}"
        height="{{ secondary.height }}"
      >
    {%- endif -%}
  </a>

  <div class="sfp-card-badges sfp-hero__badges">
    {%- if is_sale -%}<span class="sfp-badge sfp-badge--sale">-{{ discount }}%</span>{%- endif -%}
    {%- if is_new -%}<span class="sfp-badge sfp-badge--new">New</span>{%- endif -%}
    {%- if is_hot -%}<span class="sfp-badge sfp-badge--hot">Popular</span>{%- endif -%}
  </div>

  <button
    type="button"
    class="sfp-card-search sfp-hero__search"
    data-sfp-quickview="{{ product.handle }}"
    aria-label="Quick view {{ product.title | escape }}"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.6"/>
    </svg>
  </button>

  <div class="sfp-hero__content">
    {%- if section.settings.hero_eyebrow != blank -%}
      <span class="sfp-hero__eyebrow">{{ section.settings.hero_eyebrow | escape }}</span>
    {%- endif -%}
    <h3 class="sfp-hero__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    <p class="sfp-hero__price">
      {%- if product.price_varies -%}From {% endif -%}
      {{ product.price | money }}
      {%- if is_sale -%}
        <span class="sfp-hero__price-compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </p>

    {%- if has_variants -%}
      <button type="button" class="sfp-hero__cta" data-sfp-quickview="{{ product.handle }}">
        <span class="sfp-hero__cta-label">{{ section.settings.hero_cta_label | default: 'Shop the ritual' | escape }}</span>
        <svg class="sfp-hero__cta-arrow" viewBox="0 0 24 16" width="24" height="16" fill="none" aria-hidden="true">
          <path d="M1 8h21M16 1l7 7-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- else -%}
      <button
        type="button"
        class="sfp-hero__cta"
        data-sfp-atc="{{ product.variants.first.id }}"
        {% if product.available == false %}disabled{% endif %}
      >
        <span class="sfp-hero__cta-label">
          {%- if product.available -%}
            {{ section.settings.hero_cta_label | default: 'Shop the ritual' | escape }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </span>
        <svg class="sfp-hero__cta-arrow" viewBox="0 0 24 16" width="24" height="16" fill="none" aria-hidden="true">
          <path d="M1 8h21M16 1l7 7-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}
  </div>

  {%- comment -%} Product JSON for quick-view modal {%- endcomment -%}
  <script type="application/json" data-sfp-product="{{ product.handle }}">
    {{ product | json }}
  </script>
</article>
