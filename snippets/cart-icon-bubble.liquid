{%- comment -%}
  Cart label + count bubble. Rendered inline by sections/header.liquid inside
  <a id="cart-icon-bubble">, and by sections/cart-icon-bubble.liquid so the
  Section Rendering API can refresh it after every cart change (cart.js).
{%- endcomment -%}
<span class="k-header__cart-icon" aria-hidden="true">{% render 'k-icon', icon: 'bag', size: 22 %}</span>
<span class="k-header__cart-label" aria-hidden="true">{{ 'cart.bag' | t }}</span>
<span class="k-bubble" aria-hidden="true">{{ cart.item_count }}</span>
<span class="visually-hidden">{{ 'cart.title' | t }}, {{ 'cart.count_aria' | t: count: cart.item_count }}</span>
