{%- comment -%}
  Variant data for <k-variant-picker> (product page and quick view).
  "pre" marks a variant sold on backorder: tracked, out of stock, and set to
  keep selling. The add-to-bag button then reads "Pre-order".
  Accepts: product
{%- endcomment -%}
<script type="application/json" data-variants>
  [
    {%- for v in product.variants -%}
      {%- liquid
        assign v_pre = false
        if v.available and v.inventory_management == 'shopify' and v.inventory_quantity <= 0 and v.inventory_policy == 'continue'
          assign v_pre = true
        endif
      -%}
      {
        "id": {{ v.id }},
        "options": {{ v.options | json }},
        "available": {{ v.available | json }},
        "pre": {{ v_pre | json }},
        "price": {{ v.price | money | json }},
        "cents": {{ v.price }},
        "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
        "unit": {% if v.unit_price_measurement %}{{ v.unit_price | money | append: ' / ' | append: v.unit_price_measurement.reference_unit | json }}{% else %}null{% endif %},
        "sku": {{ v.sku | json }},
        "save": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | money | json }}{% else %}null{% endif %},
        "off": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}{% else %}0{% endif %},
        "qty": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %},
        "title": {{ v.title | json }},
        "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
