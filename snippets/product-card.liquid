{% comment %}
  Glaze universal product card.

  Reusable across collection, search, recommendations, sticky-collections,
  featured-product, etc. App-block friendly: exposes a rating slot that
  review apps (Judge.me, Loox, Stamped, Shopify Product Reviews) can target,
  and renders the native Shopify "reviews.rating" metafield when present.

  Required:
    product          {Object}

  Optional:
    section_id       {String}  scope id for [data-pc-*] handlers
                               (defaults to "global")
    show_vendor      {Bool}    default true
    show_rating      {Bool}    default true
    show_badges      {Bool}    default true
    show_actions     {Bool}    default true   (hover ATC + quick-view)
    show_quick_view  {Bool}    default true   (only used if show_actions)
    show_atc         {Bool}    default true   (only used if show_actions)
    image_loading    {String}  'lazy' | 'eager'  default 'lazy'
    image_sizes      {String}  default tuned for 3-up grids
    image_widths     {String}  default '300, 450, 600, 800'

  Usage:
    {% render 'product-card', product: product, section_id: section.id %}
{% endcomment %}

{%- liquid
  if show_vendor == nil
    assign show_vendor = true
  endif
  if show_rating == nil
    assign show_rating = true
  endif
  if show_badges == nil
    assign show_badges = true
  endif
  if show_actions == nil
    assign show_actions = true
  endif
  if show_quick_view == nil
    assign show_quick_view = true
  endif
  if show_atc == nil
    assign show_atc = true
  endif
  assign image_loading = image_loading | default: 'lazy'
  assign image_sizes = image_sizes | default: '(min-width: 1080px) 28vw, (min-width: 720px) 45vw, 90vw'
  assign image_widths = image_widths | default: '300, 450, 600, 800'

  assign has_variants = false
  if product.variants.size > 1 or product.has_only_default_variant == false
    assign has_variants = true
  endif

  assign on_sale = false
  if product.compare_at_price_max > product.price
    assign on_sale = true
  endif

  assign rating_value = 0
  assign rating_count = 0
  if product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating | times: 1.0
    assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5 | times: 1.0
    if scale_max > 0 and scale_max != 5
      assign rating_value = rating_value | times: 5.0 | divided_by: scale_max
    endif
  endif
  if product.metafields.reviews.rating_count != blank
    assign rating_count = product.metafields.reviews.rating_count | plus: 0
  endif
-%}

<article class="glaze-pcard" data-pc-handle="{{ product.handle }}">
  <div class="glaze-pcard__media-wrap">
    <a class="glaze-pcard__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 800 | image_tag:
            loading: image_loading,
            sizes: image_sizes,
            widths: image_widths,
            alt: product.featured_image.alt | default: product.title | escape
        }}
      {%- endif -%}

      {%- if show_badges -%}
        {%- if on_sale -%}
          <span class="glaze-pcard__badge glaze-pcard__badge--sale">{{ 'collection.sale_badge' | t }}</span>
        {%- endif -%}
        {%- if product.available == false -%}
          <span class="glaze-pcard__badge glaze-pcard__badge--soldout">{{ 'collection.soldout_badge' | t }}</span>
        {%- endif -%}
      {%- endif -%}
    </a>

    {%- if show_actions -%}
      <div class="glaze-pcard__actions">
        {%- if has_variants and show_quick_view -%}
          <button
            type="button"
            class="glaze-pcard__action"
            data-pc-quickview="{{ product.handle }}"
            aria-label="{{ 'collection.quick_view' | t: title: product.title }}"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.6"/>
            </svg>
          </button>
        {%- elsif show_atc -%}
          <button
            type="button"
            class="glaze-pcard__action"
            data-pc-atc="{{ product.variants.first.id }}"
            aria-label="{{ 'collection.add_to_cart' | t: title: product.title }}"
            {% if product.available == false %}disabled{% endif %}
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 4h2.5l2 12h11l1.8-8H7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="9" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="17" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="glaze-pcard__body">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="glaze-pcard__vendor">{{ product.vendor | escape }}</p>
    {%- endif -%}

    <a class="glaze-pcard__title" href="{{ product.url }}">{{ product.title | escape }}</a>

    <div class="glaze-pcard__prices">
      {%- if on_sale -%}
        <s class="glaze-pcard__compare">{{ product.compare_at_price_max | money }}</s>
      {%- endif -%}
      {%- if product.price_varies -%}
        <span class="glaze-pcard__price">{{ 'collection.from' | t }} {{ product.price_min | money }}</span>
      {%- else -%}
        <span class="glaze-pcard__price">{{ product.price | money }}</span>
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
        <span class="glaze-pcard__unit">
          {{ product.selected_or_first_available_variant.unit_price | money }}/{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
        </span>
      {%- endif -%}
    </div>

    {%- if show_rating -%}
      {%- comment -%}
        Rating priority:
          1. Judge.me — product.metafields.judgeme.badge (pre-rendered HTML).
             Wrapped in their canonical class/data-id so the Judge.me JS
             auto-installs even if the cached badge is stale.
          2. Loox — product.metafields.loox.avg_rating + loox.num_reviews.
          3. Native Shopify "Product Reviews" — product.metafields.reviews.rating.
          4. Empty slot with hooks for Stamped/Yotpo/Okendo/Reviews.io to inject
             into via their own JS selectors.
      {%- endcomment -%}
      {%- if product.metafields.judgeme.badge != blank -%}
        <div class="glaze-pcard__rating jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-install="false">
          {{ product.metafields.judgeme.badge }}
        </div>
      {%- elsif product.metafields.loox.avg_rating != blank -%}
        {%- assign loox_value = product.metafields.loox.avg_rating | times: 1.0 -%}
        {%- assign loox_count = product.metafields.loox.num_reviews | plus: 0 -%}
        <div class="glaze-pcard__rating loox-rating" data-rating="{{ loox_value }}" data-id="{{ product.id }}">
          <span class="glaze-pcard__stars" aria-hidden="true">
            {%- assign full_stars = loox_value | floor -%}
            {%- for i in (1..full_stars) -%}
              <svg viewBox="0 0 16 16" fill="currentColor" class="glaze-pcard__star is-full"><path d="M8 1.2l2.06 4.17 4.6.67-3.33 3.24.79 4.58L8 11.7l-4.12 2.17.79-4.58L1.34 6.04l4.6-.67L8 1.2z"/></svg>
            {%- endfor -%}
          </span>
          <span class="glaze-pcard__rating-value">{{ loox_value | round: 1 }}</span>
          {%- if loox_count > 0 -%}<span class="glaze-pcard__rating-count">({{ loox_count }})</span>{%- endif -%}
        </div>
      {%- elsif rating_value > 0 -%}
        {%- assign full_stars = rating_value | floor -%}
        {%- assign half_star = false -%}
        {%- assign frac = rating_value | minus: full_stars -%}
        {%- if frac >= 0.25 and frac < 0.75 -%}
          {%- assign half_star = true -%}
        {%- elsif frac >= 0.75 -%}
          {%- assign full_stars = full_stars | plus: 1 -%}
        {%- endif -%}
        {%- assign empty_stars = 5 | minus: full_stars -%}
        {%- if half_star -%}
          {%- assign empty_stars = empty_stars | minus: 1 -%}
        {%- endif -%}
        <div
          class="glaze-pcard__rating"
          data-glaze-rating
          data-product-id="{{ product.id }}"
          aria-label="Rated {{ rating_value | round: 1 }} out of 5{% if rating_count > 0 %} based on {{ rating_count }} reviews{% endif %}"
        >
          <span class="glaze-pcard__stars" aria-hidden="true">
            {%- for i in (1..full_stars) -%}
              <svg viewBox="0 0 16 16" fill="currentColor" class="glaze-pcard__star is-full"><path d="M8 1.2l2.06 4.17 4.6.67-3.33 3.24.79 4.58L8 11.7l-4.12 2.17.79-4.58L1.34 6.04l4.6-.67L8 1.2z"/></svg>
            {%- endfor -%}
            {%- if half_star -%}
              <svg viewBox="0 0 16 16" class="glaze-pcard__star is-half">
                <defs>
                  <linearGradient id="pcard-half-{{ product.id }}">
                    <stop offset="50%" stop-color="currentColor"/>
                    <stop offset="50%" stop-color="transparent"/>
                  </linearGradient>
                </defs>
                <path d="M8 1.2l2.06 4.17 4.6.67-3.33 3.24.79 4.58L8 11.7l-4.12 2.17.79-4.58L1.34 6.04l4.6-.67L8 1.2z" fill="url(#pcard-half-{{ product.id }})" stroke="currentColor" stroke-width="0.8"/>
              </svg>
            {%- endif -%}
            {%- for i in (1..empty_stars) -%}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="0.8" class="glaze-pcard__star is-empty"><path d="M8 1.2l2.06 4.17 4.6.67-3.33 3.24.79 4.58L8 11.7l-4.12 2.17.79-4.58L1.34 6.04l4.6-.67L8 1.2z"/></svg>
            {%- endfor -%}
          </span>
          <span class="glaze-pcard__rating-value">{{ rating_value | round: 1 }}</span>
          {%- if rating_count > 0 -%}
            <span class="glaze-pcard__rating-count">({{ rating_count }})</span>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%}
          Multi-app empty slot — carries the data attributes / class names
          each major review app looks for, so installing the app auto-renders
          the widget here without touching theme code.
            - Judge.me      → .jdgm-widget.jdgm-preview-badge + data-id
            - Stamped       → .stamped-product-reviews-badge + data-id
            - Yotpo         → .yotpo.bottomLine + data-product-id
            - Okendo        → data-oke-star-rating + data-oke-reviews-product-id
            - Generic       → data-glaze-rating
        {%- endcomment -%}
        <div
          class="glaze-pcard__rating glaze-pcard__rating--slot jdgm-widget jdgm-preview-badge stamped-product-reviews-badge yotpo bottomLine"
          data-glaze-rating
          data-id="{{ product.id }}"
          data-product-id="{{ product.id }}"
          data-oke-star-rating
          data-oke-reviews-product-id="shopify-{{ product.id }}"
        ></div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if has_variants and show_actions and show_quick_view -%}
    {%- comment -%} Product JSON consumed by window.GlazeQuickView when the modal opens {%- endcomment -%}
    <script type="application/json" data-pc-product="{{ product.handle }}">
      {{ product | json }}
    </script>
  {%- endif -%}
</article>
