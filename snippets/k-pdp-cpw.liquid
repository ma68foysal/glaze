{%- comment -%}
  Cost per wear: the selected variant's price divided by how often it will
  be worn, as a collapsible row: the figure shows in the row, and opening it
  gives two sliders (wears a month, years kept) and the sum written out. Follows variant changes.
  Accepts: block, variant
{%- endcomment -%}
{%- liquid
  assign wears = block.settings.wears
  assign years = block.settings.years
  assign total = wears | times: 12 | times: years
  assign per = variant.price | divided_by: total
  assign price_money = variant.price | money
  assign per_money = per | money
-%}
{%- if variant.price > 0 -%}
  <details class="k-pdp__acc k-cpw-row" {{ block.shopify_attributes }}>
    <summary class="k-pdp__acc-head">
      <span>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ 'products.cpw.heading' | t }}{% endif %}</span>
      <span class="k-cpw__peek k-muted" data-cpw-peek>{{ per_money }} {{ 'products.cpw.per_wear' | t }}</span>
      {% render 'k-icon', icon: 'plus', size: 18 %}
    </summary>
    <k-cpw
      class="k-cpw k-pdp__acc-body"
      data-price="{{ variant.price }}"
      data-per-wear="{{ 'products.cpw.per_wear' | t | escape }}"
      data-sum="{{ 'products.cpw.sum' | t: price: '[price]', wears: '[wears]', years: '[years]', result: '[result]' | escape }}"
    >
      <div class="k-cpw__inputs">
        <label class="k-cpw__field">
          <span class="k-cpw__field-head"><span>{{ 'products.cpw.wears' | t }}</span><output data-cpw-out="wears">{{ wears }}</output></span>
          <input type="range" min="1" max="30" step="1" value="{{ wears }}" data-cpw-input="wears">
        </label>
        <label class="k-cpw__field">
          <span class="k-cpw__field-head"><span>{{ 'products.cpw.years' | t }}</span><output data-cpw-out="years">{{ years }}</output></span>
          <input type="range" min="1" max="10" step="1" value="{{ years }}" data-cpw-input="years">
        </label>
      </div>
      <p class="k-cpw__result"><output data-cpw-result>{{ per_money }}</output> {{ 'products.cpw.per_wear' | t }}</p>
      <p class="k-cpw__sum" data-cpw-sum>{{ 'products.cpw.sum' | t: price: price_money, wears: wears, years: years, result: per_money }}</p>
      {%- if block.settings.note != blank -%}<p class="k-cpw__note">{{ block.settings.note | escape }}</p>{%- endif -%}
    </k-cpw>
  </details>
{%- endif -%}
