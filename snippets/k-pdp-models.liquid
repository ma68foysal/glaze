{%- comment -%}
  Model switcher: the same piece on models of different builds.
  Sits over the product photo as tabs. The block's Models setting holds one
  model per line as Name | height | size worn | photo number | fit note
  (the note is optional), so it can be connected to a multi-line text
  metafield. Choosing a model brings that product photo forward with a
  wipe. Renders nothing with fewer than two complete lines.
  Accepts: block, product
{%- endcomment -%}
{%- liquid
  assign lines = block.settings.models | replace: '<br>', '~~' | replace: '<br/>', '~~' | replace: '<br />', '~~' | replace: '</p>', '~~' | newline_to_br | replace: '<br />', '~~' | strip_html | split: '~~'
  assign count = 0
  for line in lines
    assign parts = line | split: '|'
    if parts.size > 2
      assign p0 = parts[0] | strip
      assign p1 = parts[1] | strip
      assign p2 = parts[2] | strip
      if p0 != blank and p1 != blank and p2 != blank
        assign count = count | plus: 1
      endif
    endif
  endfor
-%}
{%- if count > 1 -%}
  <k-models class="k-models" {{ block.shopify_attributes }}>
    {%- assign first_worn = '' -%}
    <div class="k-models__list" role="group" aria-label="{{ 'products.models.group' | t }}">
      {%- for line in lines -%}
        {%- liquid
          assign parts = line | split: '|'
          if parts.size < 3
            continue
          endif
          assign m_name = parts[0] | strip
          assign m_height = parts[1] | strip
          assign m_size = parts[2] | strip
          if m_name == blank or m_height == blank or m_size == blank
            continue
          endif
          assign m_media = ''
          if parts.size > 3
            assign m_pos = parts[3] | strip | plus: 0 | minus: 1
            if m_pos >= 0 and m_pos < product.media.size
              assign m_media = product.media[m_pos].id
            endif
          endif
          assign worn = 'products.models.worn' | t: name: m_name, height: m_height, size: m_size
          if parts.size > 4
            assign m_note = parts[4] | strip
            if m_note != blank
              assign worn = worn | append: '. ' | append: m_note
            endif
          endif
          if first_worn == blank
            assign first_worn = worn
          endif
        -%}
        <button type="button" class="k-models__btn" aria-pressed="{% if first_worn == worn %}true{% else %}false{% endif %}" data-media="{{ m_media }}" data-worn="{{ worn | escape }}">{{ m_name | escape }}</button>
      {%- endfor -%}
    </div>
    <p class="k-models__worn" aria-live="polite" data-models-worn>{{ first_worn }}</p>
  </k-models>
{%- endif -%}
