<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level | default: 'full' }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% if settings.type_primary_font.system? == false or settings.type_heading_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endif %}
    {% unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% # The Kinetic design system, so the launch page matches the store. %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
