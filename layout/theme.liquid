<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level | default: 'full' }}"{% if settings.photo_treatment != 'none' %} data-ink="{{ settings.photo_treatment }}"{% endif %}{% if settings.photo_grain %} data-grain{% endif %}{% if settings.stretch_headings %} data-stretch{% endif %}{% if settings.custom_cursor %} data-cursor="{{ 'general.view' | t | escape }}"{% endif %}>
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {%- if settings.page_transitions and settings.motion_level != 'off' -%}
      {%- comment -%} Cross-page view transitions; browsers without support navigate normally. {%- endcomment -%}
      <style>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
    {%- endif -%}

    {%- comment -%}
      Favicon. Shopify scales whatever the merchant uploads to 32x32, so we
      hint the right type for both PNG and SVG uploads. The link is skipped
      when no favicon is set so Shopify's domain default still applies.
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon | image_url: width: 16, height: 16 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {% comment %}
      Preconnect to Shopify's image CDN so product / collection / slideshow images
      negotiate TLS in parallel with the rest of the page download.
    {% endcomment %}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% if settings.type_primary_font.system? == false or settings.type_heading_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endif %}

    {% comment %} Preload the base body + heading variants for initial render {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% comment %}
      Global legacy styles (buttons, product cards, pagination, RTE prose, form fields).
      Loads once theme-wide so individual sections don't re-emit duplicated rules.
    {% endcomment %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Kinetic design system. Loads after base.css; base.css goes once every section is rebuilt. %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- comment -%}
      Globals for cart.js (and any other JS that fetches Shopify cart endpoints).
      Routes are localized per-storefront; cart strings are themable via locales.
    {%- endcomment -%}
    <script>
      window.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: {{ 'cart.error' | t | json }},
        addError: {{ 'cart.add_error' | t | json }}
      };
      window.shopMoneyFormat = {{ shop.money_format | json }};
      window.themeSettings = {
        addFeedback: {{ settings.cart_add_feedback | default: 'drawer' | json }},
        moodboard: {
          url: {{ settings.moodboard_page.url | json }},
          savedText: {{ 'moodboard.toast_saved' | t | json }},
          removedText: {{ 'moodboard.toast_removed' | t | json }},
          viewText: {{ 'moodboard.view' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="k-scope color-{{ settings.color_schemes.first.id | default: 'scheme-1' }}">
    {%- if settings.photo_treatment == 'duotone' -%}
      {%- liquid
        assign duo = settings.color_schemes.first.settings.accent
        assign duo_r = duo.red | divided_by: 255.0 | round: 3
        assign duo_g = duo.green | divided_by: 255.0 | round: 3
        assign duo_b = duo.blue | divided_by: 255.0 | round: 3
      -%}
      <svg class="visually-hidden" width="0" height="0" aria-hidden="true" focusable="false">
        <filter id="k-duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.3 0.59 0.11 0 0  0.3 0.59 0.11 0 0  0.3 0.59 0.11 0 0  0 0 0 1 0"/>
          <feComponentTransfer>
            <feFuncR type="table" tableValues="{{ duo_r }} 1"/>
            <feFuncG type="table" tableValues="{{ duo_g }} 1"/>
            <feFuncB type="table" tableValues="{{ duo_b }} 1"/>
          </feComponentTransfer>
        </filter>
      </svg>
    {%- endif -%}
    <a class="skip-to-content" href="#main-content">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.quick_view -%}
      <dialog class="k-qv-dialog color-{{ settings.color_schemes.first.id | default: 'scheme-1' }}" data-quick-view-dialog aria-label="{{ 'general.quick_view_dialog' | t }}">
        <div class="k-qv-dialog__head">
          <span class="k-label">{{ 'general.quick_view_dialog' | t }}</span>
          <button type="button" class="k-qv-dialog__close" data-qv-close aria-label="{{ 'general.close' | t }}">{% render 'k-icon', icon: 'close', size: 18 %}</button>
        </div>
        <div class="k-qv-dialog__body" data-qv-body></div>
      </dialog>
    {%- endif -%}

    {%- if settings.show_back_to_top -%}
      <button type="button" class="k-totop" data-back-to-top aria-label="{{ 'general.back_to_top' | t }}" tabindex="-1">
        <svg class="k-totop__ring" viewBox="0 0 56 56" aria-hidden="true" focusable="false"><circle cx="28" cy="28" r="26"/></svg>
        {% render 'k-icon', icon: 'arrow-up-right', size: 18 %}
      </button>
    {%- endif -%}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {%- comment -%}
      cart.js powers the drawer AND the cart-page live updates (qty change
      / remove without a button). Load it everywhere so the cart page works
      even when cart_type == 'page'.
    {%- endcomment -%}
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

    {%- if settings.enable_smooth_scroll -%}
      {%- comment -%}
        Lenis smooth scroll. MIT-licensed (https://github.com/darkroomengineering/lenis),
        self-hosted in assets/ so it ships from the Shopify CDN. Module script auto-defers.
        Respects prefers-reduced-motion. Auto-pauses while the header search dialog or
        the mobile drawer is open so the overlay doesn't fight momentum scroll.
        Merchants can disable via Theme settings > Motion.
      {%- endcomment -%}
      <script type="module">
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          import('{{ "lenis-min.js" | asset_url }}').then(({ default: Lenis }) => {
            const lenis = new Lenis({
              duration: 1.1,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
              smoothWheel: true,
              syncTouch: false
            });
            function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
            requestAnimationFrame(raf);

            // Pause/resume around modals + drawers
            function refreshLockedState() {
              const hasOpen = document.querySelector('predictive-search[open], .skinova-drawer.is-open, dialog[open]');
              if (hasOpen) { lenis.stop(); } else { lenis.start(); }
            }
            const mo = new MutationObserver(refreshLockedState);
            mo.observe(document.body, { attributes: true, subtree: true, attributeFilter: ['open', 'class'] });

            // Expose for debugging / custom scroll-to calls
            window.lenis = lenis;
          }).catch(() => {});
        }
      </script>
    {%- endif -%}
  </body>
</html>
