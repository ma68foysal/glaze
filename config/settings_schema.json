[
  {
    "name": "theme_info",
    "theme_name": "Oblique",
    "theme_version": "1.0.0",
    "theme_author": "Themestudio",
    "theme_documentation_url": "https://skinova-manual.vercel.app",
    "theme_support_url": "https://themestudio.store/pages/contact"
  },
  {
    "name": "Color schemes",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#F2F1EC"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Replaces the solid background when set."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#0E0E0E"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#2B2BFF",
            "info": "Used for highlights, badges and the cart count."
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button background",
            "default": "#2B2BFF"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "icons": "text",
          "links": "text"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Headings, body text, accent words and labels each have one font. Italic words in headings use the accent font."
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "archivo_n8",
        "label": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "archivo_n4",
        "label": "Body text"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "default": "instrument_serif_i4",
        "label": "Accent",
        "info": "Used for italic words in headings."
      },
      {
        "type": "font_picker",
        "id": "type_label_font",
        "default": "ibm_plex_mono_n4",
        "label": "Labels",
        "info": "Used for small uppercase labels, tags and meta text."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100,
        "label": "Heading size"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "max_page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1920,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Space between sections",
        "min": 40,
        "max": 160,
        "step": 8,
        "unit": "px",
        "default": 120
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "Button shape",
        "default": "pill",
        "options": [
          {
            "value": "pill",
            "label": "Pill"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "square",
            "label": "Square"
          }
        ]
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "checkbox",
        "id": "show_back_to_top",
        "label": "Show back-to-top button",
        "info": "Appears after scrolling, with a ring that fills as the page scrolls.",
        "default": true
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "select",
        "id": "motion_level",
        "label": "Motion",
        "default": "full",
        "options": [
          {
            "value": "full",
            "label": "Full"
          },
          {
            "value": "subtle",
            "label": "Subtle"
          },
          {
            "value": "off",
            "label": "Off"
          }
        ],
        "info": "Subtle keeps hover and scroll reveals but stops looping animation. Shoppers can always pause motion, and their reduced-motion preference is respected."
      },
      {
        "type": "checkbox",
        "id": "show_motion_toggle",
        "label": "Show pause motion button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_smooth_scroll",
        "label": "t:labels.enable_smooth_scroll",
        "info": "t:labels.enable_smooth_scroll_info",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Animate page changes",
        "info": "Pages cross-fade and product photos move into the product page. Browsers without support change pages as usual.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "stretch_headings",
        "label": "Stretch headings while scrolling",
        "info": "Only at the Full motion level.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "custom_cursor",
        "label": "Show a \"View\" cursor over photos",
        "info": "For mouse users only. Buttons and the product gallery keep their usual cursor.",
        "default": true
      }
    ]
  },
  {
    "name": "Images",
    "settings": [
      {
        "type": "select",
        "id": "photo_treatment",
        "label": "Photo treatment",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "mono",
            "label": "Monochrome"
          },
          {
            "value": "duotone",
            "label": "Duotone"
          }
        ],
        "default": "none",
        "info": "Gives mixed photography one look. Colour returns on hover. Product pages and the cart always show true colour."
      },
      {
        "type": "checkbox",
        "id": "photo_grain",
        "label": "Film grain on photos",
        "default": false
      }
    ]
  },
  {
    "name": "t:general.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:labels.favicon_info"
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "t:labels.share_image",
        "info": "t:labels.share_image_info"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "text",
        "id": "popular_searches",
        "label": "Popular searches",
        "default": "Trench, Merino, Denim, Loafers, Bags",
        "info": "Separate with commas. Shown in the search window and on the search page before a shopper types, and when a search finds nothing."
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:labels.cart_type",
        "options": [
          {
            "value": "page",
            "label": "t:options.cart_type.page"
          },
          {
            "value": "drawer",
            "label": "t:options.cart_type.drawer"
          }
        ],
        "default": "page",
        "info": "t:labels.cart_type_info"
      },
      {
        "type": "select",
        "id": "cart_add_feedback",
        "label": "After adding to cart",
        "options": [
          {
            "value": "drawer",
            "label": "Open the cart drawer"
          },
          {
            "value": "fly",
            "label": "Fly the photo to the bag"
          }
        ],
        "default": "drawer",
        "info": "Applies when the cart type is Drawer."
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "t:labels.show_cart_note",
        "default": true
      }
    ]
  }
]
